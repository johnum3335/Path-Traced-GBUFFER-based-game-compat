using namespace reshade::api;

extern "C" __declspec(dllexport) const char *NAME = "TLOU RT";
extern "C" __declspec(dllexport) const char *DESCRIPTION =
	"Path tracing for The Last of Us Part II (D3D12) after Resident Evil Requiem's path tracer or with NVIDIA RTXPT's (Renderer setting):the scene's triangles (stream-out of the visibility prepass, one refitted BLAS per draw) are ray traced in hardware, the frame is path traced after the game's lighting and blended over it, the game's lights get ray-traced shadows; NVIDIA RTXDI (ReSTIR DI, ReGIR) for the lamps and the game's lights, NVIDIA DLSS Ray Reconstruction denoising and upscaling in place of the game's DLSS (or as the denoiser in a helper process); PBR materials at every bounce, with an auto-PBR layer for what a game does not give; NVIDIA ReSTIR PT (initial sampling, temporal and spatial reuse with the hybrid shift, compatibility-guided neighbour selection, the duplication-based history cap, Ray Reconstruction decorrelation) for the bounce light; NVIDIA SHaRC, the spatially hashed radiance cache, for the light beyond the bounces; still objects the game stops drawing stay in the shadow rays' scene for a while (remembered geometry). This software contains source code provided by NVIDIA Corporation. v106.";

namespace
{
	// v51: TLOU RT's own path tracer's passes removed (trace_rt, temporal, atrous, ambient, history, full, restir, pt)
	enum pass { pass_setup, pass_zero, pass_convert, pass_check, pass_material, pass_dump,
		pass_lights, pass_light_census, pass_light_temporal, pass_light_filter, pass_light_add, pass_dump_lights, pass_motion, pass_sharc_resolve, pass_sky,
		pass_late, pass_mask, pass_emit, pass_emit_list, pass_di, pass_re9_path, pass_re9_accum, pass_re9_composite, pass_re9_history, pass_re9_sss,
		pass_reuse_shift, pass_reuse_resample, pass_re9_ratio, pass_rtxpt_path, pass_rtxpt_composite, pass_lamp_merge, pass_reuse_pairs,
		pass_adapt, pass_rtxdi_di, pass_rtxdi_pdf, pass_rtxdi_presample, pass_regir_build, pass_rr_inputs,
		pass_pt_initial, pass_pt_temporal, pass_pt_dupmap, pass_pt_smooth, pass_pt_shade, pass_pt_neighbors, pass_pt_spatial,
		pass_rtxdi_game, pass_sharc_update, pass_sharc_resolve_nv, pass_sharc_clear, pass_regir_cells, pass_regir_fill, pass_regir_vis_decay, pass_count };   // v76, v77, v78, v83, v84, v86, v87, v90
	const D3D12_SHADER_BYTECODE k_pass_code[pass_count] = {
		{ g_cs_setup, sizeof(g_cs_setup) }, { g_cs_zero, sizeof(g_cs_zero) }, { g_cs_convert, sizeof(g_cs_convert) },
		{ g_cs_check, sizeof(g_cs_check) }, { g_cs_material, sizeof(g_cs_material) }, { g_cs_dump, sizeof(g_cs_dump) },
		{ g_cs_lights, sizeof(g_cs_lights) }, { g_cs_light_census, sizeof(g_cs_light_census) }, { g_cs_light_temporal, sizeof(g_cs_light_temporal) },
