	// Must match RtConstants in rt.hlsl
	struct rt_constants
	{
		uint32_t pass;
		uint32_t frame;
		float bounce;
		float sky;
		float ray_length;
		uint32_t half_w;
		uint32_t half_h;
		float occlusion;
		float cone_cos;                                    // cosine of the sky shadow cone's half angle
		float sun_cos;                                     // cosine of the sun cone's half angle
		float reflect;                                     // share of the path-traced reflections
		float light_shadows;                               // v18: how much the ray-traced visibility darkens the game's lights
		float light_radius;                                // smallest light radius for the shadow rays (metres)
		uint32_t light_tiles;                              // entries of the light count range (root SRV)
		uint32_t lights_on;                                // the game's light loop is off and the count range is bound
		float full;                                        // v19: share of the full path-traced lighting (Path tracing slider)
		uint32_t env_on;                                   // the game's environment probes are bound (space 101)
		uint32_t motion_on;                                // v20: cs_motion wrote this frame's motion plane
		float sun;                                         // v23: full path tracing's own sun (0 = the game's)
		float brightness;                                  // v23: full path tracing's level
		float baked;                                       // v28: the baked ambient's share in escaped rays (1 = all)
		float contact;                                     // v40: contact shadows' strength (g_contact)
		float emit;                                        // v39: the lamps' strength (g_emit, before g_alpha_on in rt.hlsl)
		uint32_t alpha_on;                                 // v30: HeapTextures is bound at the game's heap (cut-out masks)
	};
	constexpr uint32_t k_atrous_passes = 3;                // ATROUS_PASSES in rt.hlsl (v40: was 5)
	constexpr uint32_t k_light_filter_passes = 3;          // LIGHT_FILTER_PASSES in rt.hlsl
	constexpr uint32_t k_planes = 26;                      // PLANES in rt.hlsl
	constexpr uint32_t k_copy_images = 4;                  // t4', t5', t10', t18' (cs_ambient)
	constexpr UINT64 k_frame_bytes = 1280;                 // FRAME_BYTES in rt.hlsl (v82: + FRAME_AUTO_PBR at 1024)
	constexpr UINT64 k_light_bytes_per_pixel = 8 * 4 + 2 * 16 + 16; // LIGHT_DWORDS dword planes + 2 float4 planes + the motion plane (MOTION_BYTES, rt.hlsl)
	constexpr UINT64 k_sharc_capacity = 1 << 20;            // SHARC_CAPACITY in rt.hlsl: keys (4 B), accumulation (16 B), resolved (8 B)

	// ---- settings (sliders in the ReShade overlay, saved in ReShade.ini) ----
	std::atomic<float> s_bounce { 1.0f }, s_sky { 1.0f }, s_ray_length { 12.0f }, s_softness { 20.0f };   // (v97: s_occlusion gone)
	std::atomic<float> s_reflect { 1.0f }, s_sun_softness { 0.5f }, s_light_shadows { 1.0f }, s_light_size { 5.0f }, s_full { 1.0f };
	std::atomic<float> s_keep_seconds { 30.0f };                // v94: "Remember geometry" - seconds still objects outlive their draws
	std::atomic<float> s_brightness { 1.0f };                   // v23 (v97: s_sun gone)
	std::atomic<float> s_baked { 1.0f };                        // v28
	std::atomic<float> s_restir { 0.0f };                       // v38: ReSTIR GI on the bounce light - v67: "Reuse samples (RE9)", GI and DI, off;
	                                                            //   v68: "Reuse light samples (RE9)", ReSTIR DI only
	std::atomic<float> s_path_reuse { 1.0f };                   // v68: "Path reuse" - reuse.hlsl (ReSTIR PT Enhanced), both renderers
	std::atomic<float> s_lamps { 1.0f };                        // v39: the emitters' light (Lamps slider)
	std::atomic<float> s_contact { 1.0f };                      // v40: contact shadows on the bounce and sky light
	std::atomic<float> s_restir_di { 1.0f };                    // v42: ReSTIR DI for full path tracing's direct light
	std::atomic<float> s_restir_pt { 1.0f };                    // v43: ReSTIR PT on the bounce and sky light
	std::atomic<float> s_re9 { 1.0f };                          // v44: the RE9 renderer for full path tracing
	std::atomic<float> s_relight { 1.0f };                      // v50: the forward relight (Relight forward layers)
	std::atomic<int> s_renderer { 1 };                          // v52: the path tracer - 0 RE9's, 1 (v98) NVIDIA RTXPT's (v52-v97 DD2's); v100: RTXPT by default
	std::atomic<int> s_pt_bounces { 3 };                        // v52: the DD2 renderer's bounces; v98: RTXPT's diffuse bounces (1-7; key PTDD2Bounces kept)
	std::atomic<float> s_pt_physical { 1.0f };                  // v99: the RTXPT renderer's Physical light falloff (the game's lights)
	std::atomic<float> s_pt_softness { 100.0f };                // v101: RTXPT's Light softness (% of a light's size its samples spread over)
	std::atomic<int> s_pt_samples { 2 };                        // v101: RTXPT's Light samples at the camera's surfaces (NEEFullSamples, 1-8)
	std::atomic<int> s_pt_restir { 2 };                         // v103: RTXPT's ReSTIR DI - 0 off (its NEE), 1 auto (off with RR, as RTXPT), 2 always
	std::atomic<float> s_rr { 0.0f };                           // v59: Ray Reconstruction (test: NGX up, RR's feature created)
	std::atomic<int> s_debug_view { 0 };                        // v63: the DD2 renderer's debug view (not saved)
	std::atomic<float> s_auto_pbr_force { 0.0f };               // v82: "Force auto-PBR (debug)" - the adapter's estimates in place of the game's (not saved)
	std::atomic<float> s_rtxdi_on { 0.0f };                     // v76: "NVIDIA RTXDI lamps (RE9)" - rtxdi_di.hlsl in place of cs_di / di_shade
	std::atomic<int> s_rtxdi_bias { 3 };                        // v76: its bias correction (RTXDI_BIAS_CORRECTION_*: 3 ray traced)
	std::atomic<float> s_regir_on { 1.0f };                     // v77: "NVIDIA ReGIR" - the lamps from ReGIR's cells (RTXDI's candidates, bounce hits)
	std::atomic<float> s_rtxdi_game { 1.0f };                   // v86: "NVIDIA RTXDI game lights" - the game's lights in RTXDI's list with the lamps
	std::atomic<float> s_regir_cells { 1.0f };                  // v90: "ReGIR surface cells" - the bounce hits' picks from cells on the surfaces
	std::atomic<float> s_regir_scale { 16.0f };                 // v90: "ReGIR cell detail" - their hash grid's scene scale
	std::atomic<float> s_regir_candidates { 8.0f };            // v91: "ReGIR candidates" - RIS candidates per light slot (both grids' fills)
	std::atomic<float> s_regir_plain { 25.0f };                 // v92: "ReGIR plain slots" - % of a cell's slots with one power-proportional pick
	std::atomic<float> s_regir_game_share { 50.0f };            // v96: "ReGIR game-light share" - % of the cells' candidates among the game's lights alike
	std::atomic<float> s_regir_vis_cache { 1.0f };              // v93: "ReGIR visibility cache" - the lights' weights x the chance they are seen
	std::atomic<float> s_regir_vis_floor { 0.05f };             // v93: "ReGIR visibility floor" - the least of that chance
	std::atomic<float> s_rtxdi_pt { 1.0f };                     // v83: "NVIDIA ReSTIR PT (RE9)" - rtxdi_pt.hlsl's passes make the RE9 renderer's bounce
	std::atomic<int> s_pt_spatial { 2 };                        // v84: "ReSTIR PT neighbours" - CGNS's neighbours per pixel for its spatial resampling (0: none)
	std::atomic<float> s_pt_decorrelation { 0.15f };            // v84: "Decorrelation for RR" - the base of its stagnancy decorrelation (NVIDIA's 0.4)
	std::atomic<float> s_sharc_nv { 1.0f };                     // v87: "NVIDIA SHaRC" - NVIDIA's radiance cache (sharc.hlsl) in place of v23's own
	std::atomic<float> s_sharc_scale { 50.0f };                 // v87: "SHaRC voxel detail" - HashGridParameters::sceneScale (NVIDIA's 50, 1-100)
	std::atomic<float> s_sharc_frames { 32.0f };                // v87: "SHaRC frames" - SharcResolveParameters::accumulationFrameNum (NVIDIA's 32)
	std::atomic<bool> s_sharc_reset { false };                  // v87: "Reset SHaRC" - cs_sharc_clear before the next Update (not saved)

	// ---- root signatures as the game created them (deep copies of ReShade's description) ----
	struct saved_layout
	{
		std::vector<pipeline_layout_param> params;
		std::vector<std::unique_ptr<descriptor_range[]>> ranges;
		std::vector<std::unique_ptr<descriptor_range_with_flags[]>> franges;
		std::vector<std::unique_ptr<sampler_desc[]>> samplers;
	};
	std::mutex s_layout_mutex;
	std::unordered_map<uint64_t, std::shared_ptr<saved_layout>> s_layouts;

	// ---- the add-on's pipelines per game lighting root signature ----
	struct inject_set
	{
		pipeline_layout layout = {};
		ID3D12PipelineState *pso[pass_count] = {};
		uint32_t uav_param = 0, const_param = 0, geo_param = 0, tlas_param = 0, table_param = 0, counts_param = 0;
		uint32_t rtxdi_param = 0;                          // v76: RTXDI's reservoirs (u2, space 100: a root UAV into the data buffer)
		uint32_t rtxdi_ris_param = 0, rtxdi_cb_param = 0;  // v77: its RIS buffer (u3: a root UAV into the data buffer) and the frame's
		                                                   //   constants (b1: a root CBV into the frame's draw table)
		uint32_t rtxdi_pt_param = 0, rtxdi_pt_cb_param = 0;   // v83: ReSTIR PT's reservoirs (u4: a root UAV into the data buffer) and
		                                                   //   the frame's ReSTIR PT constants (b2: a root CBV into the frame's draw table)
		uint32_t sharc_param = 0;                          // v87: NVIDIA SHaRC's hash entries, accumulation, resolved light (u5-u7:
		                                                   //   three root UAVs into the data buffer, consecutive parameters)
		uint32_t regir_param = 0;                          // v90: ReGIR's surface cells' keys (u8, space 100: a root UAV into the data buffer)
		uint32_t heap_param = UINT32_MAX;                  // v30: HeapTextures (space 102)
		bool ok = false;                                   // the screen-space passes exist
		bool rt_ok = false;                                // ... and the hardware ray tracing ones
		uint64_t ibl_layout = 0;                           // v19: Cs_SpecularIbl's root signature mirrored (0: none) ...
		uint32_t ibl_count = 0;                            // ... in this many parameters ...
		uint32_t ibl_param[64];                            // ... its parameter p at this index (UINT32_MAX: not mirrored)
	};
	device *s_device = nullptr;
	std::shared_mutex s_mutex;                             // guards s_lighting and s_inject
	std::unordered_map<uint64_t, uint64_t> s_lighting;     // CS_DeferredLighting pipeline -> its root signature
	std::unordered_map<uint64_t, inject_set> s_inject;     // game lighting root signature -> the add-on's pipelines
	// v19: Cs_SpecularIbl (the game's environment probes): its pipelines -> root signature (guarded by s_mutex), its root
	// signature, and the root arguments of its last dispatch (taken from the recording list, stamped with the present)
	std::unordered_map<uint64_t, uint64_t> s_ibl;
	// v50: the forward relight - CS_ApplyFogDirectlyToFullRes pipelines -> root signature (guarded by s_mutex), the present of
	// the last RE9 composite recorded and of the last relight, its counters (relit, no composite in this frame or the last,
	// light buffer or data not found), its root signature and pipeline (guarded by s_rt_mutex)
	std::unordered_map<uint64_t, uint64_t> s_fog;
	std::atomic<uint32_t> s_relight_present { UINT32_MAX }, s_relight_done { UINT32_MAX };
	std::atomic<uint32_t> s_relight_frame { UINT32_MAX };       // v72: the add-on's frame (s_frame) of that composite
	std::atomic<uint32_t> s_relight_counts[3];
	ID3D12RootSignature *s_relight_root = nullptr;
	// v61: DLSS Ray Reconstruction in the helper process (rr_host.h, src\rr_helper.cpp; s_rr_mutex - the present thread): the
	// host, the GPU objects it gave up (released RR_RETIRE_PRESENTS presents later: the game's queue may still signal or copy
	// with them), whether starting it failed (not retried until the setting goes off and on). v59-v60 ran NGX inside the
	// game: RR's creation hung RenoDX's DLSS Neural Rendering and the game
	constexpr uint32_t k_rr_retire_presents = 8;
	std::mutex s_rr_mutex;
	rr_host s_rr_host;
	std::vector<std::pair<IUnknown *, uint32_t>> s_rr_retired;
	bool s_rr_start_failed = false;
	uint32_t s_rr_status_present = 0;
	std::mutex s_rr_message_mutex;
	std::string s_rr_message = "off";
	// v78: the RR frames of the lighting lists (s_rr_mutex): the frame each list's inputs went to and the frame whose output
	// its composite reprojects, from the list's recording until it is submitted and its frame published; the last frame whose
	// inputs a list wrote and that list's add-on frame (the next list reads it when it follows directly); the counts for the
	// status line
	struct rr_entry
	{
		uint64_t list = 0;                                 // the lighting list (native)
		uint32_t frame = 0;                                // its add-on frame (list_state::pre_frame)
		int64_t value = 0;                                 // the RR frame its inputs went to (0: none)
		int64_t reads = 0;                                 // the RR frame whose output its composite takes (0: none)
		uint32_t *flags = nullptr;                         // the RR block's flags in its frame's draw table (cleared when it cannot wait)
		ID3D12CommandQueue *queue = nullptr;               // the queue it was submitted to
		bool executed = false, signaled = false;
		uint32_t present = 0;                              // when it was recorded (a list never submitted is dropped)
	};
	std::deque<rr_entry> s_rr_entries;
	std::atomic<uint32_t> s_rr_pending { 0 };              // s_rr_entries.size() (the submission hook's quick test)
	int64_t s_rr_value = 0, s_rr_first = 0;                // the last RR frame written; the first of the generation (RR's reset)
	uint32_t s_rr_frame = UINT32_MAX;
	LONG s_rr_generation = 0;
	uint64_t s_rr_written = 0, s_rr_used = 0, s_rr_cancelled = 0;
	// v79: the in-game RR (v80: rr_game_evaluate): the game's DLSS hooks (installed once: the module is pinned), the DLSS
	// evaluates seen, the DLSS output's size (the swap chain's), RR's state in the game (0 not made, 2 made, -1 failed - not
	// retried until the setting goes off and on) and its line under the setting
	std::atomic<bool> s_sl_hooked { false };
	std::atomic<uint64_t> s_dlss_evaluates { 0 };
	std::atomic<uint32_t> s_output_w { 0 }, s_output_h { 0 };
	std::atomic<int> s_probe_state { 0 };
	std::mutex s_probe_message_mutex;
	std::string s_probe_message = "not made", s_sl_hook_message = "not installed";
	// v80: "Ray Reconstruction upscaling (in the game)" (not saved), the frames RR upscaled / the game's DLSS upscaled instead
	// and the last reason (s_probe_message_mutex); RR's guides in the game (rr_game_guides: diffuse albedo RGBA8, specular albedo
	// and normal + roughness RGBA16F at the render size, shader resource at rest; s_guides_mutex), the present they were last
	// written at (UINT32_MAX: never), the ones replaced (released 16 frames later)
	std::atomic<float> s_rr_up { 0.0f };
	std::atomic<uint64_t> s_rr_up_frames { 0 }, s_rr_up_fallbacks { 0 };
	std::atomic<uint32_t> s_rr_up_last_present { UINT32_MAX };   // v81: the present of RR's last frame in the game (rr_game_active)
	std::string s_rr_up_reason;
	std::mutex s_guides_mutex;
	ID3D12Resource *s_guides[3] = {};
	uint32_t s_guides_w = 0, s_guides_h = 0, s_guides_present = UINT32_MAX;
	std::vector<std::pair<ID3D12Resource *, uint32_t>> s_guides_retired;
	ID3D12PipelineState *s_relight_pso = nullptr;
	bool s_relight_failed = false;
	std::atomic<uint64_t> s_ibl_layout { 0 };
	struct ibl_args
	{
		uint32_t present = 0;
		uint64_t layout = 0;
		uint64_t table_mask = 0, root_mask = 0, const_mask = 0;
		uint64_t tables[64];
		uint64_t root_va[64];
		uint8_t root_type[64];
		uint32_t const_count[64];
		uint32_t consts[64][32];
	};
	std::mutex s_ibl_mutex;
	ibl_args s_ibl_args;
	std::atomic<uint32_t> s_env_bound { 0 };               // lists whose rays took the probes (per status period)

	// ---- the add-on's data buffer (see rt.hlsl) ----
	std::mutex s_buffer_mutex;
	ID3D12Resource *s_buffer = nullptr;
	uint32_t s_buffer_w = 0, s_buffer_h = 0;
	std::vector<std::pair<ID3D12Resource *, uint32_t>> s_retired; // replaced buffers, released 16 frames later

	std::atomic<uint32_t> s_width { 0 }, s_height { 0 };   // render resolution (size of the G-buffer)
	std::atomic<uint32_t> s_frame { 0 };                   // injections so far
	std::atomic<uint32_t> s_present_index { 0 };
	std::atomic<uint64_t> s_injected { 0 }, s_skipped { 0 };
	// The lighting lists since the last status update (overlay line 4): how many there were, in how many the ambient was
	// rewritten, and why it was not the last time it was not
	enum skip_reason { skip_none, skip_off, skip_size, skip_args, skip_pipelines, skip_targets, skip_buffer, skip_rt, skip_geometry };
	const char *const k_skip_names[] = { "", "effect off", "no render size yet", "lighting arguments not recorded", "no lighting pipelines",
		"G-buffer targets 4 / 5 not found", "no data buffer", "hardware ray tracing not ready", "no scene geometry that frame" };
	std::atomic<uint32_t> s_lists_lit { 0 }, s_ambient_written { 0 };
	std::atomic<uint32_t> s_other_lighting { 0 }, s_scene_reused { 0 };   // v26: lighting passes not at render size, collapsed epochs
	std::atomic<int> s_last_skip { skip_none };
	// v29: skips counted by reason (pre: skip_reason; post: k_post_names), and the scenes reused for an empty or stale epoch
	std::atomic<uint32_t> s_skip_counts[9] = {};
	constexpr const char *k_post_names[] = { "list recorded more work after the lighting", "lighting arguments changed", "no pipelines / size",
		"no data buffer", "ray tracing state" };
	std::atomic<uint32_t> s_post_counts[5] = {};
	std::atomic<uint32_t> s_reuse_empty { 0 }, s_reuse_stale { 0 };
	void note_skip(int reason)
	{
		s_last_skip = reason;
		s_skip_counts[reason].fetch_add(1, std::memory_order_relaxed);
	}
	// The game's lights (v18), per status period: lists whose light loop was switched off, lists the add-on lit, lists it
	// switched off but could not light (the lighting list recorded other work after the lighting), and why the light loop
	// was left on the last time
	enum light_skip { light_skip_none, light_skip_slot, light_skip_view, light_skip_zero };
	const char *const k_light_skip_names[] = { "", "the light count descriptor was not found this frame", "the light count view is not what the lighting reads",
		"the zero count buffer could not be created" };
	std::atomic<uint32_t> s_lights_off { 0 }, s_lights_added { 0 }, s_lights_lost { 0 };
	std::atomic<int> s_light_skip { light_skip_none };

	std::mutex s_status_mutex;                             // the status lines are set on game threads and shown by the overlay
	std::string s_status = "waiting for the game's lighting";
	std::string s_rt_status[6] = { "hardware ray tracing: waiting for the first frame", "", "", "", "", "" };
	void set_status(const std::string &text)
	{
		const std::lock_guard<std::mutex> lock(s_status_mutex);
		s_status = text;
	}
	std::string get_status()
	{
		const std::lock_guard<std::mutex> lock(s_status_mutex);
		return s_status;
	}

	// ---- scene geometry ----
	// Geo buffer: [counters of region 0 | counters of region 1 | TLAS instances | vertex data of region 0 | of region 1 |
	// material slots (v14: one uint per triangle of each cached BLAS, see the material cache below)].
	// The prepass draws of a frame (an "epoch", ended by the game's lighting list) stream into one region, each into its own
	// part with its own counter. The lighting injection converts that region in place, refits / builds the draws' BLASes
	// from it and zeroes the counters of the other region, which the next frame's draws use. cs_convert hides a draw whose
	// counter does not show all of its vertices, so a draw assigned to the wrong frame (recorded after the lighting list
	// closed, or not yet executed) costs its triangles for one frame but never corrupts anything: its writes stay inside
	// its own part.
	constexpr UINT64 k_vertex_bytes = 12;                  // clip-space xyz; w = (z - c10.y) / c10.x (the game's projection)
	constexpr uint32_t k_region_draws = 16384;
	constexpr UINT64 k_counter_bytes = UINT64(k_region_draws) * 16;
	constexpr uint32_t k_regions = 3;                      // v33: was 2 (epoch % 3: last frame's region intact while late draws fill the next)
	constexpr UINT64 k_instance_offset = k_regions * k_counter_bytes;
	constexpr UINT64 k_data_base = k_instance_offset + UINT64(k_region_draws) * sizeof(D3D12_RAYTRACING_INSTANCE_DESC);
	constexpr UINT64 k_region_bytes = 224ull << 20;        // 19.6M vertices = 6.5M triangles (v7 capture spot: 3.37M; v28: 288 MB x 2, v33: 224 MB x 3)
	constexpr UINT64 k_material_base = k_data_base + k_regions * k_region_bytes;
	static_assert(k_material_base == 706478080ull, "GEO_MATERIAL in rt.hlsl");
	constexpr uint32_t k_material_slots = 16u << 20;       // 16M triangles (64 MB): ~4 frames' worth of distinct meshes
	constexpr UINT64 k_uv_base = k_material_base + UINT64(k_material_slots) * 4;   // v30: cut-outs' texture coordinates, 2 regions
	constexpr UINT64 k_uv_region_bytes = 64ull << 20;     // 8M vertices (float2) of cut-outs per frame
	constexpr UINT64 k_late_base = k_uv_base + k_regions * k_uv_region_bytes;   // v36: per counter slot, the epoch whose lighting found the draw run
	constexpr UINT64 k_mask_slot_base = k_late_base + UINT64(k_regions) * k_region_draws * 4;   // v37: per listed draw, its mask's slot this frame
	constexpr UINT64 k_mask_hash_base = k_mask_slot_base + UINT64(k_region_draws) * 4;       // v37: texture identity -> this frame's slot
	constexpr UINT64 k_mask_vote_base = k_mask_hash_base + 8192 * 8;                         // v55: per listed draw, cs_motion's mask votes
	constexpr UINT64 k_material_pbr_base = k_mask_vote_base + UINT64(k_region_draws) * 8;   // v82: per material slot, metalness + F0 (cs_material)
	constexpr UINT64 k_keep_base = k_material_pbr_base + UINT64(k_material_slots) * 4;   // v94: per BLAS entry, its stillness record
	constexpr uint32_t k_keep_records = 32768;             //   (KEEP_RECORD_BYTES 208: frames still, 16 anchors; rt.hlsl keep_track) - entries
	constexpr UINT64 k_geo_bytes = k_keep_base + UINT64(k_keep_records) * 208;   //   beyond have none
	static_assert(k_keep_base == 1042481152ull, "GEO_KEEP in rt.hlsl");
	static_assert(k_material_pbr_base == 975372288ull, "GEO_MATERIAL_PBR in rt.hlsl");
	static_assert(k_mask_slot_base == 975110144ull && k_mask_hash_base == 975175680ull && k_mask_vote_base == 975241216ull, "GEO_MASK_* in rt.hlsl");
	static_assert(k_late_base == 974913536ull, "GEO_LATE in rt.hlsl");
	constexpr uint32_t k_no_uv = 0xFFFFFFFFu;              // NO_UV in rt.hlsl: no coordinates / no mask
	constexpr uint32_t k_no_material = 0xFFFFFFFFu;        // NO_MATERIAL in rt.hlsl
	constexpr uint32_t k_ring = 8;                         // per-frame upload / readback slots (frames in flight)
	constexpr UINT64 k_table_stride = 48;                  // TABLE_STRIDE in rt.hlsl (v30: was 32)
	// v77: rtxdi.hlsli RtxdiFrame - the frame's RTXDI constants, a root CBV (b1, space 100) in the frame's draw table after its
	// entries (256-byte aligned); NVIDIA's parameter structs keep the constant-buffer layout in C++ and HLSL alike. Then RTXDI's
	// neighbour offsets (int8 pairs, rtxdi::FillNeighborOffsetBuffer). v76: the constants read with Table.Load at a fixed offset
	struct rtxdi_frame
	{
		RTXDI_RuntimeParameters runtime;
		RTXDI_ReservoirBufferParameters reservoirs;
		RTXDI_DIInitialSamplingParameters initial;
		RTXDI_DISpatioTemporalResamplingParameters spatiotemporal;
		RTXDI_RISBufferSegmentParameters local_ris;
		ReGIR_Parameters regir;
		uint32_t input, output, reuse, flags;
		uint32_t pdf_at, pdf_size, offsets_at, hit_samples;
		uint32_t regir_slots, game_at, regir_plain;                // v86: game_at - the game's lights' tables (cs_rtxdi_game)
		float game_share;                                  // v96: RtxdiFrame gameShare - the ReGIR cells' candidates among the game's lights alike
	};
	static_assert(sizeof(rtxdi_frame) % 16 == 0, "rtxdi.hlsli RtxdiFrame: whole 16-byte registers");
	static_assert(sizeof(RTXDI_PackedDIReservoir) == 24, "RTXDI's packed reservoir");
	constexpr UINT64 k_table_rtxdi = (128 + UINT64(k_region_draws) * k_table_stride + 255) & ~UINT64(255);
	constexpr UINT64 k_table_rtxdi_offsets = k_table_rtxdi + ((sizeof(rtxdi_frame) + 255) & ~UINT64(255));
	constexpr uint32_t k_rtxdi_offsets = 8192;
	// v78: the frame's Ray Reconstruction block (re9.hlsl TABLE_RR: flags, the input and output slots, the RR region's offset in
	// the data buffer, its pitches and plane size), after the RTXDI offsets
	constexpr UINT64 k_table_rr = (k_table_rtxdi_offsets + 2 * k_rtxdi_offsets + 255) & ~UINT64(255);
	static_assert(k_table_rr == 804608, "TABLE_RR in re9.hlsl");
	// v83: the frame's ReSTIR PT block (rtxdi_pt_frame.hlsli RtxdiPTFrame: rtxdi::ReSTIRPTContext's parameters, the passes' planes
	// in the data buffer), a root CBV (b2, space 100) after the Ray Reconstruction block. v84: + CGNS's picks (in place of v83's
	// first vertices)
	struct rtxdi_pt_frame
	{
		RTXDI_PTParameters restir_pt;
		RTXDI_RuntimeParameters runtime;
		uint32_t flags, surface_at, neighbor_at, dup_at;
		uint32_t smooth_at, pad0, pad1, pad2;
	};
	static_assert(sizeof(RTXDI_PTParameters) == 240, "RTXDI_PTParameters as the shaders' constant buffer lays it out");
	static_assert(sizeof(rtxdi_pt_frame) % 16 == 0, "rtxdi_pt_frame.hlsli RtxdiPTFrame: whole 16-byte registers");
	static_assert(sizeof(RTXDI_PackedPTReservoir) == 64, "RTXDI's packed path reservoir");
	constexpr UINT64 k_table_pt = k_table_rr + 256;
	// v87: the frame's NVIDIA SHaRC block (sharc.hlsli sharc_frame, read with Table.Load at TABLE_SHARC) after the ReSTIR PT block
	struct sharc_frame
	{
		float scene_scale, radiance_scale;
		uint32_t capacity, accumulation_frames;
		uint32_t stale_frames, flags, downscale;
		float roughness_min;
		uint32_t bounces, pad0, pad1, pad2;
	};
	static_assert(sizeof(sharc_frame) == 48, "sharc.hlsli sharc_frame");
	constexpr UINT64 k_table_sharc = k_table_pt + ((sizeof(rtxdi_pt_frame) + 255) & ~UINT64(255));
	static_assert(k_table_sharc == 805376, "TABLE_SHARC in sharc.hlsli");
	// v90: the frame's ReGIR surface cells block (regir_cells.hlsli regir_frame, Table.Load at TABLE_REGIR) after the SHaRC block
	struct regir_frame
	{
		float scene_scale;
		uint32_t capacity, flags, cells_at, candidates, stale, plain, pad1;   // v92: plain - slots of 32 with one pick
		uint32_t vis_at, vis_mask, vis_flags;              // v93: TABLE_REGIR_VIS (regir_vis.hlsli) - the cache's entries, their count - 1, on
		float vis_floor;                                   //   the least chance a light is given
	};
	static_assert(sizeof(regir_frame) == 48, "regir_cells.hlsli regir_frame, regir_vis.hlsli TABLE_REGIR_VIS");
	constexpr UINT64 k_table_regir = k_table_sharc + 256;
	static_assert(k_table_regir == 805632, "TABLE_REGIR in regir_cells.hlsli");
	constexpr UINT64 k_table_bytes = k_table_regir + 256;
	constexpr uint32_t k_regir_capacity = 1u << 16;        // v90: ReGIR's surface cells (64K: 16 MB with their slots)
	constexpr uint32_t k_regir_cell_bytes = 16 + 32 * 8;  // regir_cells.hlsli REGIR_CELL_BYTES (REGIR_CELL_SLOTS 32)
	constexpr uint32_t k_regir_flag_on = 1, k_regir_flag_count = 2;   // REGIR_FLAG_*
	constexpr uint32_t k_regir_vis_capacity = 1u << 18;    // v93: the visibility cache's entries (16 bytes: 4 MB)
	constexpr uint32_t k_sharc_nv_capacity = 1u << 22;     // v87: NVIDIA SHaRC's entries (its guide's baseline, 2^22): 160 MB
	constexpr uint32_t k_sharc_flag_on = 1, k_sharc_flag_count = 2;   // sharc.hlsli SHARC_FLAG_*
	constexpr uint32_t k_pt_flag_history = 1, k_pt_flag_dupmap = 2;   // rtxdi_pt_frame.hlsli PT_FLAG_* (v83's 4, the path reuse's sample: gone)
	constexpr uint32_t k_rtxdi_pdf_size = 32;              // v77: the lamps' PDF, 32 x 32 texels at mip 0 (EMIT_MAX lamps; rtxdi::ComputePdfTextureSize)
	constexpr UINT64 k_rtxdi_pdf_bytes = 8192;             //   its mip chain (1365 floats)
	constexpr uint32_t k_rtxdi_flag_presampled = 1, k_rtxdi_flag_regir = 2, k_rtxdi_flag_game = 4;   // rtxdi.hlsli RTXDI_FRAME_* (v86: + game)
	constexpr uint32_t k_rtxdi_flag_physical = 8;            // v99: the RTXPT renderer's Physical light falloff (RTXDI weighs by it too)
	constexpr uint32_t k_rtxdi_flag_exact_game = 16;         // v104: the RTXPT renderer lights the camera's surfaces with every game light
	constexpr UINT64 k_rtxdi_game_bytes = 2 * 8192;        // v86: the game's lights for RTXDI, two frames' tables (rtxdi_bridge.hlsli RTXDI_GAME_BYTES)
	constexpr uint32_t k_rtxdi_hit_samples = 4;            // lamp candidates per bounce hit (rtxdi.hlsli rtxdi_lamps_at)
	constexpr UINT64 k_readback_bytes = 512;               // per slot: 48 stats (STATS in rt.hlsl) at 0, timestamps at 256
	constexpr UINT64 k_readback_timestamps = 256;
	constexpr UINT64 k_readback_frame_info = 224;           // v68: FRAME_INFO (rt.hlsl, 16 bytes): y, z, w the path reuse's counters
	constexpr UINT64 k_readback_auto_pbr = 336;             // v82: FRAME_AUTO_PBR (rt.hlsl, 32 bytes: cs_adapt's error sums x 1024, the count) - after the timestamps
	constexpr UINT64 k_readback_pt = 368;                   // v83: FRAME_PT (rt.hlsl, ReSTIR PT's counters; v84: 48 bytes)
	constexpr UINT64 k_readback_pt_bytes = 48;
	constexpr UINT64 k_readback_regir = 416;                // v90: FRAME_REGIR (rt.hlsl, 16 bytes: ReGIR's surface cells' counters)
	constexpr uint32_t k_stats = 52;                       // STAT_COUNT in rt.hlsl (v37: was 48)
	constexpr uint32_t k_stats_offset = 192;               // STATS in rt.hlsl
	constexpr uint32_t k_timestamps = 9;                   // 0-6 before the lighting, 7-8 the lights after it
	constexpr uint32_t k_queries_per_slot = 16;
	static_assert(k_readback_timestamps + k_timestamps * 8 <= k_readback_auto_pbr && k_readback_auto_pbr + 32 <= k_readback_pt &&
		k_readback_pt + k_readback_pt_bytes <= k_readback_regir && k_readback_regir + 32 <= k_readback_bytes, "readback slot layout");

	struct epoch_draw { uint32_t data, vertices, counter, flags; uint64_t key; uint32_t uv, alpha, source; };   // v37: + the mask's texture identity   // byte offsets in the geo buffer, flags (bit 0 hair, bit 2 cut-out), mesh key, v30: coordinates and mask slot
	struct table_entry { uint32_t data, vertices, counter, flags; uint64_t blas; uint32_t material, previous; uint32_t uv, alpha, pad[2]; }; // rt.hlsl TABLE_*
	// v26: the last built scene's table (s_rt_mutex), for a frame whose epoch collapsed; its draw counts this status period
	std::vector<table_entry> s_last_table;
	std::vector<struct blas_entry *> s_last_entries;       // v33: the BLAS entries of s_last_table's draws (same order)
	std::atomic<uint64_t> s_retained_sum { 0 };            // v33: draws retained from the frame before, this status period
	// v34: depth-pass draws per target size this epoch (s_epoch_mutex), the main view's size learnt from them, the others
	struct view_count { uint32_t view, draws; };
	view_count s_view_hist[8] = {};
	uint32_t s_view_hist_n = 0, s_view_candidate = 0;
	std::atomic<uint32_t> s_main_view { 0 };
	std::atomic<uint64_t> s_skip_view { 0 };
	std::atomic<uint32_t> s_skip_view_size { 0 };
	std::atomic<bool> s_blas_pressure { false };
	uint32_t s_last_draws = 0, s_last_scene_epoch = 0, s_reuse_run = 0;
	bool s_last_scene = false;
	std::vector<uint32_t> s_scene_draws;
	constexpr uint32_t k_no_previous = 0xFFFFFFFFu;        // NO_PREVIOUS in rt.hlsl
	constexpr uint32_t k_no_keep = 0xFFFFFFFFu;            // v94: a BLAS entry without a stillness record (TABLE_KEEP 0)
	constexpr uint32_t k_draw_kept = 16u, k_draw_new_record = 32u;   // v94: table flags DRAW_KEPT, DRAW_NEW_RECORD in rt.hlsl
	constexpr uint32_t k_keep_still_frames = 60;           // v94: KEEP_STILL_FRAMES in rt.hlsl (the status line)
	static_assert(sizeof(table_entry) == k_table_stride, "table entry layout");
	std::mutex s_epoch_mutex;                              // guards the epoch below
	uint32_t s_epoch = 0;                                  // region = s_epoch % k_regions
	UINT64 s_epoch_bytes = 0;
	UINT64 s_epoch_uv_bytes = 0;                           // v30: the epoch's texture coordinates so far
	uint32_t s_epoch_present = 0;                          // present index when the epoch began
	// v72: presents per frame the game renders - DLSS frame generation presents 2 (or more) for each: the mean of the presents
	// between consecutive lighting passes (take_epoch), as a whole number 1-4, which the windows counted in presents scale by
	float s_presents_mean = 1.0f;                          // (s_epoch_mutex)
	std::atomic<uint32_t> s_presents_per_frame { 1 };
	uint32_t s_dirty[k_regions] = {};                      // counters used in each region since they were last zeroed
	std::vector<epoch_draw> s_epoch_draws;
	std::atomic<bool> s_streaming { false };               // stream-out on (ray tracing ready and the bounce light on)
	std::atomic<ID3D12Resource *> s_geo { nullptr };
	std::atomic<uint64_t> s_skip_space { 0 }, s_skip_args { 0 }, s_skip_clone { 0 }, s_clones { 0 }, s_clones_failed { 0 };
	std::atomic<uint64_t> s_skip_largest { 0 };
	std::atomic<uint32_t> s_alpha_clone_failed { 0 }, s_alpha_pipelines { 0 };   // v30
	std::atomic<uint32_t> s_custom_depth_pipelines { 0 };                         // v54: custom-depth passes taken as solid
	std::atomic<uint64_t> s_alpha_draws { 0 }, s_alpha_resolved { 0 }, s_alpha_no_uv_space { 0 };
	std::atomic<uint64_t> s_alpha_heap { 0 };              // v30: the descriptor heap the masks' slots are in (ReShade's handle)            // v28: the largest draw left out for space: vertices << 32 | instances

	struct prepass_info
	{
		uint64_t root = 0;                                 // the game's root signature of this pipeline
		ID3D12RootSignature *so_root = nullptr;            // its stream-out capable copy (shared, owned by s_so_roots)
		bool alpha = false;                                // v30: the clone also writes the mask's coordinates (slot 1) ...
		uint32_t uv_index = 0, alpha_space = 0, alpha_reg = 0;   // ... TEXCOORD<uv_index>, the mask t<alpha_reg>, space<alpha_space>
		uint32_t alpha_param = UINT32_MAX, alpha_offset = 0;     // ... found in this root parameter's table at this offset
		ID3D12PipelineState *clone = nullptr;              // stream-out clone (created with the game's pipeline)
		bool hair = false;                                 // hair strands: their BLASes get the hair instance mask (rt.hlsl)
		bool cutout = false;                               // v22: other alpha-tested cards (the pixel shader binds a sampler)
	};
	std::shared_mutex s_geo_mutex;                         // guards s_prepass and s_so_roots
	std::unordered_map<uint64_t, std::unique_ptr<prepass_info>> s_prepass; // game prepass pipeline -> info
	std::unordered_map<uint64_t, ID3D12RootSignature *> s_so_roots;          // game root signature -> SO-capable copy

	// ---- ray tracing resources (lighting injection and present thread, guarded by s_rt_mutex) ----
	std::mutex s_rt_mutex;
	std::atomic<int> s_rt_support { 0 };                   // 0 unknown, 1 yes, -1 no
	int s_rt_state = 0;                                    // 0 not created, 1 ready, -1 failed
	ID3D12Device5 *s_device5 = nullptr;
	ID3D12Resource *s_upload = nullptr, *s_readback = nullptr, *s_scratch = nullptr, *s_tlas = nullptr, *s_tlas_scratch = nullptr;
	UINT64 s_scratch_bytes = 0;
	uint8_t *s_upload_ptr = nullptr;
	const uint8_t *s_readback_ptr = nullptr;
	ID3D12QueryHeap *s_queries = nullptr;
	std::vector<std::pair<ID3D12Resource *, uint32_t>> s_rt_retired; // replaced scratch buffers, released later
	struct slot_info
	{
		uint32_t frame = ~0u;
		uint32_t draws = 0, traced = 0, builds = 0, refits = 0, no_memory = 0;
		bool built = false;
		double cpu_ms = 0.0;
		uint32_t kept = 0;                                 // v94: entries the game no longer draws, listed for the shadow rays
	};
	slot_info s_slot_info[k_ring];
	std::atomic<uint64_t> s_timestamp_frequency { 0 };

	// ---- per-draw BLAS cache (v9) ----
	// Every draw gets its own BLAS, kept between frames under a mesh key (index buffer address + draw arguments) and refitted
	// from the draw's new vertices every frame. A refit is valid whatever the vertices are (same count, same flags), and the
	// draws of one key have the same triangles in the same order, so the BVH stays tight for moving and animated objects;
	// draws sharing a key (the same mesh twice) take the key's BLASes in turn. A BLAS is built when its key is new and again
	// every k_rebuild_period refits (staggered by key) to recover from large animation. BLASes live in arena buffers (first
	// fit, 256-byte aligned); an entry unused for k_evict_frames is dropped and its memory reused k_ring + 2 frames later.
	constexpr UINT64 k_arena_bytes = 64ull << 20;
	constexpr UINT64 k_arena_budget = 768ull << 20;
	constexpr UINT64 k_scratch_min = 64ull << 20;
	constexpr uint32_t k_evict_frames = 300;
	constexpr uint32_t k_rebuild_period = 64;
	struct arena
	{
		ID3D12Resource *buffer = nullptr;
		UINT64 size = 0;
		std::map<UINT64, UINT64> free;                     // offset -> size
	};
	struct blas_entry
	{
		uint64_t key = 0;
		uint32_t vertices = 0;
		uint32_t arena = 0;
		UINT64 offset = 0, size = 0;                       // block in the arena (aligned)
		UINT64 build_scratch = 0, update_scratch = 0;
		uint32_t last_frame = 0, refits = 0;
		bool built = false;
		bool has_data = false;                             // v20: last_data holds the entry's vertices in epoch last_epoch
		uint32_t last_data = 0, last_epoch = 0;            // (converted to world positions; cs_motion's previous frame)
		uint32_t material = k_no_material;                 // first material slot (v14), one per triangle
		bool material_clear = false;                       // new slots: cs_convert zeroes them on the entry's first use
		uint32_t keep = k_no_keep;                         // v94: its stillness record (k_keep_base), started on its first conversion
		bool keep_new = false;                             //   (keep_new: not started yet)
		uint32_t draw_flags = 0;                           // v94: its last draw's table flags (hair, cut-out cards: never kept)
		uint32_t listed_frame = 0;                         // v94: the frame it was last listed, drawn or retained
		double last_seen = 0.0;                            // v94: when the game last drew it (seconds_now)
		D3D12_GPU_VIRTUAL_ADDRESS va() const;
	};
	struct pending_free { uint32_t arena; UINT64 offset, size; uint32_t frame; uint32_t material, triangles; uint32_t keep; };
	// ---- material cache (v14): free slot ranges (first fit; offset -> count) ----
	std::map<uint32_t, uint32_t> s_material_free;
	uint64_t s_material_used = 0;
	std::vector<arena> s_arenas;
	UINT64 s_arena_total = 0, s_blas_used = 0;
	std::unordered_map<uint64_t, std::vector<std::unique_ptr<blas_entry>>> s_entries;
	size_t s_entry_count = 0;
	std::vector<pending_free> s_pending_free;
	// v94: the stillness records (k_keep_records), handed out with the entries and back with their memory
	std::vector<uint32_t> s_keep_free;
	bool s_keep_ready = false;
	uint32_t keep_alloc()
	{
		if (!s_keep_ready)
		{
			s_keep_free.reserve(k_keep_records);
			for (uint32_t i = k_keep_records; i-- > 0;)
				s_keep_free.push_back(i);
			s_keep_ready = true;
		}
		if (s_keep_free.empty())
			return k_no_keep;
		const uint32_t r = s_keep_free.back();
		s_keep_free.pop_back();
		return r;
	}
	double seconds_now()
	{
		static const double inv = [] { LARGE_INTEGER f; QueryPerformanceFrequency(&f); return 1.0 / double(f.QuadPart); }();
		LARGE_INTEGER t;
		QueryPerformanceCounter(&t);
		return double(t.QuadPart) * inv;
	}
	D3D12_GPU_VIRTUAL_ADDRESS blas_entry::va() const { return s_arenas[arena].buffer->GetGPUVirtualAddress() + offset; }

	// The G-buffer pass's 7 render targets + depth (bind_render_targets): targets 4 and 5 are the lighting's t4 / t5 (v10's
	// descriptor tracking showed it; tracking every descriptor copy cost 127 ms of CPU per frame, so it is gone)
	std::atomic<uint64_t> s_gbuffer_res[8] = {};

	// ---- the lighting's inputs, per frame (v16) ----
	// The game's render targets come from a pool: G-buffer targets 4 / 5 swap resources between frames, and the sun shadow
	// mask (t10, RGBA8) and the reflections (t18, R11G11B10, a compute pass's UAV) change too. v15 wrote into what it had
	// found once, which later frames used for something else (a gray block in the top-left quarter of the screen: a
	// half-resolution buffer there). So the add-on writes only into what the lighting's own descriptors name in that very
	// frame: each slot of its descriptor table was filled by a copy from the game's staging descriptors, whose views ReShade
	// knows (below).
	constexpr uint32_t k_lighting_inputs = 4;              // t4, t5, t10, t18: cs_ambient's copy-out images, in this order
	constexpr uint32_t k_input_regs[k_lighting_inputs] = { 4, 5, 10, 18 };
	std::atomic<uint64_t> s_resolved[k_lighting_inputs] = {};   // this frame's resources (manifest)
	std::atomic<uint32_t> s_input_found[k_lighting_inputs] = {}, s_input_written[k_lighting_inputs] = {};   // per status period

	// ---- descriptor copies into CBV/SRV/UAV heaps (v16) ----
	// ReShade 6.8 hands the game encoded CPU descriptor handles (d3d12_impl_device.cpp: bits 0-1 heap type, 2 shader
	// visible, 3-27 byte offset in the heap, 28-55 ReShade's heap index; in add-on events a CPU descriptor table also has the
	// top nibble set), so a copy's destination and source slots decode with a few bit operations: every copy is recorded
	// per destination slot (its source's heap index and slot) without ReShade calls - v10 tracked copies through
	// get_descriptor_heap_offset for 127 ms of CPU per frame. A slot's texture: its original CPU descriptor (heap start +
	// slot * increment) is a view ReShade registered (CreateShaderResourceView there), or it was copied there from one.
	constexpr uint32_t k_max_heaps = 1u << 14;
	struct heap_info
	{
		std::atomic<bool> ready { false };
		uint32_t count = 0, increment = 0;
		uint64_t orig_cpu = 0;                             // the original heap's CPU start (ReShade's view handles are original)
		uint64_t orig_heap = 0;                            // the original ID3D12DescriptorHeap (what ReShade names for GPU tables)
		std::atomic<uint64_t *> slots { nullptr };         // per slot: its last write (record_of: copy source or the slot itself)
	};
	// A slot's record: 1 << 63 | present (14 bits) << 48 | source heap index (16 bits) << 32 | source slot. A copy names its
	// source; a view written in place names the slot itself. The lighting's slots are followed only when written in the
	// last two presents (v16 followed a stale one to a destroyed texture and crashed).
	inline uint64_t record_of(uint32_t present, uint32_t heap, uint32_t slot)
	{
		return (1ull << 63) | (static_cast<uint64_t>(present & 0x3FFFu) << 48) | (static_cast<uint64_t>(heap & 0xFFFFu) << 32) | slot;
	}
	heap_info s_heaps[k_max_heaps];
	std::mutex s_heap_mutex;                               // makes heap records (s_heap_list)
	std::vector<uint32_t> s_heap_list;                     // heap indices with a record
	std::atomic<uint64_t> s_copy_calls { 0 }, s_copy_descriptors { 0 }, s_copy_ticks { 0 }, s_update_calls { 0 };
	// v18: the events are counted per thread and handed over every k_timing_period calls, and only that call is timed
	// (v17 read the clock twice per call and added to shared counters each time: 3.7 ms of CPU per frame in all)
	constexpr uint32_t k_timing_period = 64;
	thread_local uint32_t t_copy_events = 0, t_update_events = 0;
	thread_local uint64_t t_copy_descriptors = 0;

	// Live 2D textures the lighting's inputs can be (R11G11B10_FLOAT, RGBA8), from init_resource / destroy_resource: a
	// resolved resource is accepted only from here, with its size and format from here
	struct texture_info { uint32_t width, height; format fmt; };
	std::shared_mutex s_textures_mutex;                    // guards s_textures and s_buffers
	std::unordered_map<uint64_t, texture_info> s_textures;
	// v18: live buffers with unordered access (the light count buffer CS_DeferredLightCull writes is one), size in bytes
	std::unordered_map<uint64_t, uint64_t> s_buffers;

	// ---- the game's lights (v18) ----
	// A structured buffer of zeros (stride 4) and its descriptor in the add-on's own CPU heap: copied into the lighting
	// table's t13 slot, it gives every tile zero lights in CS_DeferredLighting
	constexpr uint32_t k_zero_counts = 65536;              // tiles: 4K needs 240 x 135 = 32400
	ID3D12Resource *s_zero_counts = nullptr;               // created under s_rt_mutex, released in release_all
	std::atomic<ID3D12DescriptorHeap *> s_zero_heap { nullptr };

	// ---- barrier states per resource (v16) ----
	// The copies into the lighting's inputs start from the state the game's barriers left them in (the inputs are pooled,
	// so per resource; open addressing, a lookup checks the key; stamped with the present)
	constexpr uint32_t k_state_unknown = 0xFFFFFFFFu;
	constexpr uint32_t k_state_slots = 8192;
	struct state_entry { std::atomic<uint64_t> resource { 0 }; std::atomic<uint32_t> state { k_state_unknown }; std::atomic<uint32_t> present { 0 }; };
	state_entry s_states[k_state_slots];
	std::atomic<uint32_t> s_reflections_state { k_state_unknown };   // the state t18 is in at the lighting, once a barrier showed it

	// ---- capture of the lighting's inputs (v10, Numpad -) ----
	constexpr int k_dump_key = VK_SUBTRACT;
	constexpr UINT64 k_dump_w = 1280, k_dump_h = 720;      // DUMP_W / DUMP_H in rt.hlsl
	constexpr uint32_t k_dump_float_slots = 13, k_dump_slots = 16;
	constexpr UINT64 k_dump_slot_bytes = 4096 + k_dump_float_slots * k_dump_w * k_dump_h * 8 + (k_dump_slots - k_dump_float_slots) * k_dump_w * k_dump_h * 16;
	constexpr uint32_t k_dump_lights = 1024, k_dump_light_bytes = 448; // v18: the lights the tiles name (cs_dump_lights)
	// v95: the lamps (rt.hlsl): from emit_list_base the two emitter lists (16 + 1024 x 32 bytes each, by frame parity), the
	// observations, then at k_dump_lamp_memory (lamp_offset, 256-aligned) the lamps' memory (4096 x 96 bytes) and its two maps
	constexpr UINT64 k_dump_emit_list_bytes = 16 + 1024 * 32, k_dump_lamp_memory = 98560, k_dump_lamp_maps = k_dump_lamp_memory + 4096 * 96;
	constexpr UINT64 k_dump_lamp_bytes = k_dump_lamp_maps + 2 * 4096 * 4;
	static_assert(k_dump_lamp_memory == ((3 * k_dump_emit_list_bytes + 255) & ~255ull), "rt.hlsl lamp_offset");
	constexpr UINT64 k_dump_bytes = k_dump_slot_bytes + UINT64(k_dump_lights) * k_dump_light_bytes + k_dump_lamp_bytes;
	const char *const k_dump_names[k_dump_slots] = { "t4", "t5", "t6", "ray view: cached albedo at the camera ray's hit (magenta = triangle not seen yet)", "t10",
		"ray view: geometric normal at the hit", "t16", "t18", "t19", "ray view: (material known, (hit - depth) / depth distance, cached roughness, hit)",
		"t2 (G-buffer 6) decoded: the game's emission, raw (rgb), its f16 intensity (w)",   // v66 (t22 before)
		"u0 (light buffer, after the lighting)", "t8 (depth)", "t0 (G-buffer 0)", "t1 (G-buffer 1)", "t23" };
	enum dump_state { dump_idle, dump_requested, dump_waiting };
	std::atomic<int> s_dump_state { dump_idle };
	ID3D12Resource *s_dump = nullptr, *s_dump_readback = nullptr;   // guarded by s_rt_mutex
	uint32_t s_dump_present = 0;
	uint32_t s_dump_frame = 0;                             // v95: the frame captured (the lamps' ages)
	std::string s_dump_message = "Numpad - captures the lighting's inputs";

	// ---- recording state, per command list ----
	// The game records its command lists in fiber jobs (Naughty Dog's job system: NdJobWorkerThread, BaseFiberStart), and a
	// job can go on on another worker thread in the middle of a list, so what the add-on knows about a list lives with the
	// list, not with the thread. v8-v11 kept it thread_local: v11 crashed on loading a level (access violation in the
	// driver): a stream-out draw used another recording's state, with the root signature of a pipeline destroyed meanwhile.
	struct list_state
	{
		uint64_t pipe = 0;                                 // bound pipeline (native ID3D12PipelineState)
		uint64_t pipe_root = 0;                            // root signature of the bound pipeline if it is CS_DeferredLighting
		uint64_t pipe_ibl = 0;                             // ... if it is Cs_SpecularIbl (v19)
		bool pipe_fog = false;                             // ... if it is CS_ApplyFogDirectlyToFullRes (v50: the forward relight)
		bool is_prepass = false;                           // the bound pipeline is a prepass pipeline (while streaming) ...
		prepass_info prepass;                              // ... with this info (a copy: the game may destroy the pipeline later)
		bool inject = false;                               // the last recorded work is CS_DeferredLighting
		uint64_t inject_root = 0;
		bool dirty = false;                                // something else was recorded after it
		// compute root arguments recorded for this root signature (re-bound around the add-on's passes)
		uint64_t args_layout = 0;
		uint64_t table_mask = 0, root_mask = 0, c_const_mask = 0;
		uint64_t tables[64];
		uint64_t root_va[64];
		uint8_t root_type[64];                             // 0 CBV, 1 SRV, 2 UAV
		uint32_t c_const_count[64];
		uint32_t c_consts[64][32];
		// graphics root arguments recorded for this root signature (while streaming)
		uint64_t g_layout = 0;
		uint64_t g_table_mask = 0, g_root_mask = 0, g_const_mask = 0;
		uint64_t g_tables[64];
		uint64_t g_root_va[64];
		uint8_t g_root_type[64];
		uint32_t g_const_count[64];
		uint32_t g_consts[64][32];
		uint32_t view = 0;                                 // v34: the bound target's size (width << 16 | height), 0 unknown
		bool ib = false;                                   // an index buffer is bound (GPU address), for the mesh key
		uint64_t ib_va = 0;
		bool so = false;                                   // stream-out draws recorded (geo buffer back to COMMON at the close)
		bool streamed = false;                             // v36: closed with stream-out draws (the queue census)
		bool pre = false;                                  // the add-on's passes were recorded before the first lighting dispatch ...
		bool pre_done = false;                             // ... and they rewrote the ambient (the history follows at the close)
		uint32_t pre_frame = 0;
		// v18: the game's light loop is switched off on this list (the lighting table in parameter counts_param, counts_table,
		// reads zero lights) and the add-on lights the frame at the close from the real count range (GPU address, entries)
		bool lights_off = false;
		bool pre_motion = false;                           // v20: cs_motion ran in this list's pre passes
		uint32_t counts_param = 0;
		uint64_t counts_table = 0;
		uint64_t alpha_gpu = 0;                            // v30: the masks' heap start (GPU) when the lighting's tables are in it
		uint64_t counts_va = 0;
		uint32_t counts_count = 0;

		void reset()
		{
			pipe = pipe_root = pipe_ibl = 0;
			pipe_fog = false;
			is_prepass = false;
			inject = dirty = false;
			inject_root = 0;
			args_layout = table_mask = root_mask = c_const_mask = 0;
			g_layout = g_table_mask = g_root_mask = g_const_mask = 0;
			ib = so = streamed = pre = pre_done = false;
			ib_va = 0;
			view = 0;
			lights_off = false;
			counts_table = counts_va = 0;
			alpha_gpu = 0;
			counts_param = counts_count = 0;
		}
	};
	std::shared_mutex s_lists_mutex;                       // guards s_lists
	std::unordered_map<command_list *, std::unique_ptr<list_state>> s_lists;
	std::atomic<uint32_t> s_lists_epoch { 0 };             // bumped when a state is freed (the threads' caches look up again)
	struct list_cache { command_list *cmd = nullptr; list_state *state = nullptr; uint32_t epoch = 0; };
	thread_local list_cache t_list;                        // last list this thread looked up (only a cache: any thread may record it)

	list_state &state_of(command_list *cmd)
	{
		const uint32_t epoch = s_lists_epoch.load(std::memory_order_acquire);
		if (t_list.cmd == cmd && t_list.epoch == epoch && t_list.state != nullptr)
			return *t_list.state;
		list_state *found = nullptr;
		{
			const std::shared_lock<std::shared_mutex> lock(s_lists_mutex);
			if (const auto it = s_lists.find(cmd); it != s_lists.end())
				found = it->second.get();
		}
		if (found == nullptr)
		{
			const std::unique_lock<std::shared_mutex> lock(s_lists_mutex);
			std::unique_ptr<list_state> &slot = s_lists[cmd];
			if (slot == nullptr)
				slot = std::make_unique<list_state>();
			found = slot.get();
		}
		t_list = { cmd, found, epoch };
		return *found;
	}

	void on_destroy_command_list(command_list *cmd)
	{
		std::unique_ptr<list_state> state;
		const std::unique_lock<std::shared_mutex> lock(s_lists_mutex);
		if (const auto it = s_lists.find(cmd); it != s_lists.end())
		{
			state = std::move(it->second);
			s_lists.erase(it);
			s_lists_epoch.fetch_add(1, std::memory_order_acq_rel);
		}
	}

	// ---- objects the add-on stops using while lists recorded with them may still run: released 8 presents later ----
	std::mutex s_retire_mutex;
	struct retired_object { ID3D12DeviceChild *object; pipeline_layout layout; uint32_t present; };
	std::vector<retired_object> s_retired_objects;

	void retire(ID3D12DeviceChild *object, pipeline_layout layout = {})
	{
		const std::lock_guard<std::mutex> lock(s_retire_mutex);
		s_retired_objects.push_back({ object, layout, s_present_index.load() });
	}

	void log(reshade::log::level level, const char *format, ...)
	{
		char buf[1024];
		va_list args;
		va_start(args, format);
		std::vsnprintf(buf, sizeof(buf), format, args);
		va_end(args);
		reshade::log::message(level, buf);
	}

	std::string strf(const char *format, ...)
	{
		char buf[1024];
		va_list args;
		va_start(args, format);
		std::vsnprintf(buf, sizeof(buf), format, args);
		va_end(args);
		return buf;
	}

	// The entry point name is kept as plain text in the DXIL container (PSV0 string table)
	bool contains(const shader_desc *sd, const char *text)
	{
		const char *const p = static_cast<const char *>(sd->code);
		const size_t n = std::strlen(text);
		return std::search(p, p + sd->code_size, text, text + n) != p + sd->code_size;
	}

	// v22: whether a DXIL shader binds a sampler (its PSV0 part's resource table: PSVResourceType 1). For the visibility
	// prepass that is the alpha test (grass, leaves, fences, hair cards): DXIL keeps no readable op names to look for discard.
	bool binds_sampler(const shader_desc *sd)
	{
		const uint8_t *const p = static_cast<const uint8_t *>(sd->code);
		const size_t size = sd->code_size;
		const auto u32 = [&](size_t at) { uint32_t v = 0; if (at + 4 <= size) std::memcpy(&v, p + at, 4); return v; };
		if (size < 32 || std::memcmp(p, "DXBC", 4) != 0)
			return false;
		const uint32_t parts = u32(28);
		for (uint32_t i = 0; i < parts && 32 + 4 * size_t(i) + 4 <= size; ++i)
		{
			const size_t part = u32(32 + 4 * size_t(i));
			if (part + 8 > size || std::memcmp(p + part, "PSV0", 4) != 0)
				continue;
			const size_t end = std::min(size, part + 8 + size_t(u32(part + 4)));
			size_t at = part + 8;
			at += 4 + size_t(u32(at));                     // runtime info
			if (at + 4 > end)
				return false;
			const uint32_t resources = u32(at);
			if (resources == 0 || at + 8 > end)
				return false;
			const size_t stride = u32(at + 4);
			at += 8;
			for (uint32_t r = 0; r < resources && stride >= 4 && at + stride <= end; ++r, at += stride)
				if (u32(at) == 1)                          // PSVResourceType::Sampler
					return true;
			return false;
		}
		return false;
	}

	// v30: what an alpha-tested depth pixel shader tests: its first TEXCOORD input read in x and y (ISG1) and its first material
	// texture (PSV0: the lowest Texture2D in space 5 and above - the materials' tables; space 4 holds the frame's shared
	// textures, e.g. the t110 noise). 68 of the 75 alpha-tested depth shaders of the v2 capture test its first channel.
	bool alpha_inputs(const shader_desc *sd, uint32_t &uv_index, uint32_t &space, uint32_t &reg)
	{
		const uint8_t *const p = static_cast<const uint8_t *>(sd->code);
		const size_t size = sd->code_size;
		const auto u32 = [&](size_t at) { uint32_t v = 0; if (at + 4 <= size) std::memcpy(&v, p + at, 4); return v; };
		if (size < 32 || std::memcmp(p, "DXBC", 4) != 0)
			return false;
		bool uv = false, tex = false;
		space = reg = UINT32_MAX;
		const uint32_t parts = u32(28);
		for (uint32_t i = 0; i < parts && 32 + 4 * size_t(i) + 4 <= size; ++i)
		{
			const size_t part = u32(32 + 4 * size_t(i));
			if (part + 16 > size)
				continue;
			const size_t data = part + 8, end = std::min(size, data + size_t(u32(part + 4)));
			if (std::memcmp(p + part, "ISG1", 4) == 0)
			{
				const uint32_t n = u32(data), first = u32(data + 4);
				for (uint32_t k = 0; k < n && !uv; ++k)
				{
					const size_t e = data + first + size_t(k) * 32;
					if (e + 32 > end)
						break;
					const size_t name = data + u32(e + 4);
					const uint8_t used = p[e + 25];
					if (name + 9 <= end && std::memcmp(p + name, "TEXCOORD", 9) == 0 && (used & 3) == 3)
					{
						uv_index = u32(e + 8);
						uv = true;
					}
				}
			}
			else if (std::memcmp(p + part, "PSV0", 4) == 0)
			{
				size_t at = data;
				at += 4 + size_t(u32(at));                     // runtime info
				const uint32_t resources = at + 4 <= end ? u32(at) : 0;
				if (resources == 0 || at + 8 > end)
					continue;
				const size_t stride = u32(at + 4);
				at += 8;
				for (uint32_t r = 0; r < resources && stride >= 16 && at + stride <= end; ++r, at += stride)
				{
					// PSVResourceBindInfo: type (3 = typed SRV), space, lower bound, ...; v1 + kind (2 = Texture2D)
					if (u32(at) != 3 || (stride >= 24 && u32(at + 16) != 2) || u32(at + 4) < 5)
						continue;
					const uint32_t s = u32(at + 4), b = u32(at + 8);
					if (!tex || s < space || (s == space && b < reg))
					{
						space = s;
						reg = b;
						tex = true;
					}
				}
			}
		}
		return uv && tex;
	}

	inline bool is_compute(shader_stage stages)
	{
		return (static_cast<uint32_t>(stages) & static_cast<uint32_t>(shader_stage::compute)) != 0;
	}

	inline UINT64 align256(UINT64 v)
	{
		return (v + 255) & ~UINT64(255);
	}

	inline uint64_t splitmix(uint64_t x)
	{
		x += 0x9E3779B97F4A7C15ull;
		x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9ull;
		x = (x ^ (x >> 27)) * 0x94D049BB133111EBull;
		return x ^ (x >> 31);
	}

	void transition(ID3D12GraphicsCommandList *cl, ID3D12Resource *res, D3D12_RESOURCE_STATES before, D3D12_RESOURCE_STATES after)
	{
		D3D12_RESOURCE_BARRIER b = {};
		b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
		b.Transition = { res, D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES, before, after };
		cl->ResourceBarrier(1, &b);
	}

	void uav_barrier(ID3D12GraphicsCommandList *cl, ID3D12Resource *res)
	{
		D3D12_RESOURCE_BARRIER b = {};
		b.Type = D3D12_RESOURCE_BARRIER_TYPE_UAV;
		b.UAV.pResource = res;
		cl->ResourceBarrier(1, &b);
	}

	ID3D12Resource *create_buffer(ID3D12Device *d, UINT64 size, D3D12_HEAP_TYPE heap_type, D3D12_RESOURCE_FLAGS flags, D3D12_RESOURCE_STATES state)
	{
		D3D12_HEAP_PROPERTIES heap = {};
		heap.Type = heap_type;
		D3D12_RESOURCE_DESC desc = {};
		desc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
		desc.Width = size;
		desc.Height = 1;
		desc.DepthOrArraySize = 1;
		desc.MipLevels = 1;
		desc.SampleDesc.Count = 1;
		desc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
		desc.Flags = flags;
		ID3D12Resource *res = nullptr;
		return SUCCEEDED(d->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc, state, nullptr, IID_PPV_ARGS(&res))) ? res : nullptr;
	}

	// DXR tier 1.1 (inline ray tracing) and shader model 6.5
	bool rt_supported(ID3D12Device *d)
	{
		int support = s_rt_support.load();
		if (support == 0)
		{
			D3D12_FEATURE_DATA_D3D12_OPTIONS5 options5 = {};
			D3D12_FEATURE_DATA_SHADER_MODEL model = { D3D_SHADER_MODEL_6_5 };
			const bool tier = SUCCEEDED(d->CheckFeatureSupport(D3D12_FEATURE_D3D12_OPTIONS5, &options5, sizeof(options5))) && options5.RaytracingTier >= D3D12_RAYTRACING_TIER_1_1;
			const bool sm = SUCCEEDED(d->CheckFeatureSupport(D3D12_FEATURE_SHADER_MODEL, &model, sizeof(model))) && model.HighestShaderModel >= D3D_SHADER_MODEL_6_5;
			support = tier && sm ? 1 : -1;
			s_rt_support = support;
			log(support > 0 ? reshade::log::level::info : reshade::log::level::warning, "TLOU RT: hardware ray tracing %s (ray tracing tier 0x%X, shader model 0x%X)",
				support > 0 ? "supported" : "NOT supported - screen-space rays only", static_cast<unsigned>(options5.RaytracingTier), static_cast<unsigned>(model.HighestShaderModel));
		}
		return support > 0;
	}

	// ---- settings ----

	// v11 keys (PT...): the sliders' meaning changed with the path-traced ambient, so earlier values do not carry over.
	// v13: "Game ambient" became "Sky light" (new key PTSkyLight: a 0 left from testing would switch the sky off).
	void load_settings()
	{
		float v;
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTBounce", v)) s_bounce = std::clamp(v, 0.0f, 16.0f);
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTSkyLight", v)) s_sky = std::clamp(v, 0.0f, 2.0f);
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTRayLength", v)) s_ray_length = std::clamp(v, 1.0f, 50.0f);
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTShadowSoftness", v)) s_softness = std::clamp(v, 1.0f, 60.0f);
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTReflections", v)) s_reflect = std::clamp(v, 0.0f, 1.0f);
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTSunSoftness", v)) s_sun_softness = std::clamp(v, 0.1f, 5.0f);
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTLightShadows", v)) s_light_shadows = std::clamp(v, 0.0f, 1.0f);
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTKeepGeometry", v)) s_keep_seconds = std::clamp(v, 0.0f, 300.0f);   // v94
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTLightSize", v)) s_light_size = std::clamp(v, 0.0f, 50.0f);
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTFull", v)) s_full = std::clamp(v, 0.0f, 1.0f);
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTBrightness", v)) s_brightness = std::clamp(v, 0.25f, 8.0f);
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTBaked", v)) s_baked = std::clamp(v, 0.0f, 1.0f);
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTRe9Reuse", v)) s_restir = v > 0.5f ? 1.0f : 0.0f;   // v67 (was PTRestirGI)
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTPathReuse", v)) s_path_reuse = v > 0.5f ? 1.0f : 0.0f;   // v68
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTRtxdi", v)) s_rtxdi_on = v > 0.5f ? 1.0f : 0.0f;   // v76
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTRtxdiBias", v)) s_rtxdi_bias = std::clamp(static_cast<int>(v + 0.5f), 0, 3);
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTRegir", v)) s_regir_on = v > 0.5f ? 1.0f : 0.0f;   // v77
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTRtxdiGame", v)) s_rtxdi_game = v > 0.5f ? 1.0f : 0.0f;   // v86
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTRegirCells", v)) s_regir_cells = v > 0.5f ? 1.0f : 0.0f;   // v90
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTRegirScale", v)) s_regir_scale = std::clamp(v, 4.0f, 64.0f);
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTRegirCandidates", v)) s_regir_candidates = std::clamp(v, 1.0f, 32.0f);   // v91
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTRegirPlain", v)) s_regir_plain = std::clamp(v, 0.0f, 100.0f);   // v92
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTRegirGameShare", v)) s_regir_game_share = std::clamp(v, 0.0f, 100.0f);   // v96
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTRegirVisCache", v)) s_regir_vis_cache = v > 0.5f ? 1.0f : 0.0f;   // v93
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTRegirVisFloor", v)) s_regir_vis_floor = std::clamp(v, 0.01f, 0.5f);
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTRtxdiPT", v)) s_rtxdi_pt = v > 0.5f ? 1.0f : 0.0f;   // v83
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTSpatialSamples", v)) s_pt_spatial = std::clamp(static_cast<int>(v + 0.5f), 0, 4);   // v84
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTDecorrelation", v)) s_pt_decorrelation = std::clamp(v, 0.0f, 1.0f);
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTSharcNV", v)) s_sharc_nv = v > 0.5f ? 1.0f : 0.0f;   // v87
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTSharcScale", v)) s_sharc_scale = std::clamp(v, 1.0f, 100.0f);
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTSharcFrames", v)) s_sharc_frames = std::clamp(v, 1.0f, 100.0f);
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTLampLight", v)) s_lamps = std::clamp(v, 0.0f, 100.0f);   // v65 (was PTLamps); v85: up to 100
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTContact", v)) s_contact = std::clamp(v, 0.0f, 1.0f);
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTRestirDI", v)) s_restir_di = v > 0.5f ? 1.0f : 0.0f;
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTRestirPT", v)) s_restir_pt = v > 0.5f ? 1.0f : 0.0f;
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTRenderer", v)) s_re9 = v > 0.5f ? 1.0f : 0.0f;
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTRelight", v)) s_relight = v > 0.5f ? 1.0f : 0.0f;
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTRendererType", v)) s_renderer = v > 0.5f ? 1 : 0;
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTDD2Bounces", v)) s_pt_bounces = std::clamp(static_cast<int>(v + 0.5f), 1, 7);
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTPhysicalFalloff", v)) s_pt_physical = v > 0.5f ? 1.0f : 0.0f;   // v99
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTLightSoftness", v)) s_pt_softness = std::clamp(v, 0.0f, 100.0f);   // v101
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTLightSamples", v)) s_pt_samples = std::clamp(static_cast<int>(v + 0.5f), 1, 8);
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTRestirDIMode", v)) s_pt_restir = std::clamp(static_cast<int>(v + 0.5f), 0, 2);   // v103
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTRayReconstruction", v)) s_rr = v > 0.5f ? 1.0f : 0.0f;
		if (reshade::get_config_value(nullptr, "TLOU RT", "PTRRInGame", v)) s_rr_up = v > 0.5f ? 1.0f : 0.0f;   // v81 (v80: not saved)
	}

	// v85: a value typed in (Ctrl+click) stays within the slider's range - v84's Lamps took a typed 85 for the session while
	// load_settings clamps the saved value to the range at the next start
	void slider(const char *label, const char *key, std::atomic<float> &value, float lo, float hi, const char *fmt, const char *tooltip,
		ImGuiSliderFlags flags = ImGuiSliderFlags_None)
	{
		float v = value;
		if (ImGui::SliderFloat(label, &v, lo, hi, fmt, flags | ImGuiSliderFlags_AlwaysClamp))
		{
			value = v;
			reshade::set_config_value(nullptr, "TLOU RT", key, v);
		}
		ImGui::SetItemTooltip("%s", tooltip);
	}

	std::atomic<uint32_t> s_overlay_present { 0x80000000u };   // v87: the present the settings were last drawn at (NVIDIA SHaRC counts while shown)

	void draw_settings(effect_runtime *)
	{
		s_overlay_present = s_present_index.load();
		{
			int r = s_renderer.load();                       // v52
			const char *const names[] = { "RE9 (Resident Evil Requiem)", "RTXPT (NVIDIA)" };   // v98: RTXPT in DD2's place
			if (ImGui::Combo("Renderer", &r, names, 2))
			{
				s_renderer = r;
				reshade::set_config_value(nullptr, "TLOU RT", "PTRendererType", static_cast<float>(r));
			}
			ImGui::SetItemTooltip("%s", "RE9: Resident Evil Requiem's path tracer - one bounce sample a frame, its lobe picked by the material,\n"
				"diffuse and specular apart, ReSTIR DI for the lights, the game's light where its bounce lands on what the camera\n"
				"sees, NVIDIA ReSTIR PT and SHaRC for the bounce light.\n"
				"RTXPT: NVIDIA RTXPT's path tracer (v98) - pure path tracing: RTXPT's materials (Falcor's StandardBSDF) at every\n"
				"vertex, a BSDF sample and the lights (the sun, NVIDIA RTXDI's ReSTIR DI at the camera's surfaces and ReGIR cells at\n"
				"the bounces) at each, Russian roulette, the sky where a path leaves the scene; no light taken from the game's own\n"
				"lighting along the paths.");
		}
		if (s_renderer.load() == 1)
		{
			int b = s_pt_bounces.load();
			if (ImGui::SliderInt("Bounces (RTXPT)", &b, 1, 7))
			{
				s_pt_bounces = std::clamp(b, 1, 7);
				reshade::set_config_value(nullptr, "TLOU RT", "PTDD2Bounces", static_cast<float>(s_pt_bounces.load()));
			}
			ImGui::SetItemTooltip("%s", "RTXPT's diffuse bounces per path (its DiffuseBounceCount: 1 ultra fast, 2 default, 3 ultra high): a\n"
				"bounce off a diffuse or rough surface counts, mirror-like ones continue up to 20. More = more light carried\n"
				"into shadowed rooms, slower.");
			bool on = s_pt_physical.load() > 0.5f;           // v99
			if (ImGui::Checkbox("Physical light falloff (RTXPT)", &on))
			{
				s_pt_physical = on ? 1.0f : 0.0f;
				reshade::set_config_value(nullptr, "TLOU RT", "PTPhysicalFalloff", on ? 1.0f : 0.0f);
			}
			ImGui::SetItemTooltip("%s", "The game's lights as physical sphere lights: inverse-square falloff with no range, each light as bright\n"
				"as keeps its energy within its authored range (brighter close to it, dimmer further out, still some light past\n"
				"where the game cut it off); their cones, cookies and shades as authored. Off: the game's own falloff curves.");
			slider("Light softness (RTXPT)", "PTLightSoftness", s_pt_softness, 0.0f, 100.0f, "%.0f%%",
				"How far over each light's size its samples and shadow rays spread: 100% its own size (a lamp's glowing area, a game\n"
				"light's radius or Light size) - soft penumbrae; 0% its centre - hard shadows like RE9's. Its brightness stays the same.");
			int n = s_pt_samples.load();                     // v101
			if (ImGui::SliderInt("Light samples (RTXPT)", &n, 1, 8))
			{
				s_pt_samples = std::clamp(n, 1, 8);
				reshade::set_config_value(nullptr, "TLOU RT", "PTLightSamples", static_cast<float>(s_pt_samples.load()));
			}
			ImGui::SetItemTooltip("%s", "v106: how many of the brightest lamps each pixel the camera sees lights exactly - ranked there among 12\n"
				"candidates, each with its own shadow ray every frame; the rest of the lamps by one sample (or ReSTIR DI's pick).\n"
				"More = less noise from lamps, one more shadow ray each. (The game's lights are all lit exactly since v104.)");
			int mode = s_pt_restir.load();                   // v103
			const char *const modes[] = { "Off (RTXPT's NEE)", "Auto (off with Ray Reconstruction)", "Always" };
			if (ImGui::Combo("ReSTIR DI (RTXPT)", &mode, modes, 3))
			{
				s_pt_restir = std::clamp(mode, 0, 2);
				reshade::set_config_value(nullptr, "TLOU RT", "PTRestirDIMode", static_cast<float>(s_pt_restir.load()));
			}
			ImGui::SetItemTooltip("%s", "Which light each pixel the camera sees takes, and its shadow: NVIDIA RTXDI's ReSTIR DI (needs NVIDIA RTXDI lamps)\n"
				"reuses the picks of neighbouring pixels and past frames - each pixel settles on the light that matters there and\n"
				"tests that light's shadow: crisp shadows of every light, as the RE9 renderer had - shaded with RTXPT's materials and\n"
				"Light softness. Off: RTXPT's own next-event estimation (Light samples), cleaner but its shadows soften in Ray\n"
				"Reconstruction where many lights compete. Auto: RTXPT's own rule - off while Ray Reconstruction denoises.");
		}
		{
			int view = s_debug_view.load();                  // v63 (DD2); v74: both renderers, views 4-6; v86: 7; v87: 8, 9
			const char *const views[] = { "Off", "Direct light only", "Indirect light only", "First bounce's light source", "Lamps only",
				"Game lights and sun only", "Contact shadow", "Bounce this frame (raw)", "SHaRC light (cache)", "SHaRC voxels", "ReGIR surface cells (RE9)" };
			if (ImGui::Combo("Debug view", &view, views, 11))
				s_debug_view = view;
			ImGui::SetItemTooltip("%s", "Diagnostics (not saved), either renderer: the direct light alone (the sun, the game's lights, the lamps),\n"
				"the indirect light alone, where each pixel's first bounce took its light this frame (green: the game's own light at\n"
				"a surface the camera sees, yellow: the game's light at a surface off screen the camera saw lately (SHaRC), red: a\n"
				"surface off screen or hidden not seen yet (the renderer's own light sampling there), blue: the sky / out of the\n"
				"scene, grey: no bounce ray), the lamps alone, the game's lights and the sun alone, or the contact ray's visibility\n"
				"(white: open, black: an occluder right there). Numpad - captures the view as it is shown.\n"
				"Bounce this frame (v86): the bounce light from this frame's samples alone, before the accumulation and Ray\n"
				"Reconstruction - where NVIDIA ReSTIR PT and its settings show (both average to the same light in the image).\n"
				"SHaRC light (v87): the radiance cache's light at each surface the camera sees (black: no entry there yet) - NVIDIA\n"
				"SHaRC's, else the add-on's own. SHaRC voxels: NVIDIA's hash grid, a colour per voxel (their size grows with the\n"
				"distance; SHaRC voxel detail sets it).");
		}
		{
			bool force = s_auto_pbr_force.load() != 0.0f;     // v82: not saved
			if (ImGui::Checkbox("Force auto-PBR (debug)", &force))
				s_auto_pbr_force = force ? 1.0f : 0.0f;
			ImGui::SetItemTooltip("%s", "Diagnostics (not saved): the surfaces' roughness, metalness, specular reflectance and normal-map detail\n"
				"from the auto-PBR layer's estimates (the albedo's local contrast, the depth buffer, the albedo's relief) in place of\n"
				"the game's G-buffer - what a game that does not give them would get. The status line compares the estimates with the\n"
				"game's own values either way.");
		}
		slider("Bounce light", "PTBounce", s_bounce, 0.0f, 16.0f, "%.2f",
			"The path-traced bounce light (1 = physical, higher = stronger).");
		slider("Sky light", "PTSkyLight", s_sky, 0.0f, 2.0f, "%.2f",
			"Light from the open sky where the paths leave the scene: the game's baked ambient there (1 = as the game baked it, 0 = none).");
		slider("Baked light", "PTBaked", s_baked, 0.0f, 1.0f, "%.2f",                     // v52: back (v51 removed it, the rays still use it)
			"The game's baked ambient light in the rays that leave the scene (1 = as the game baked it). 0 = GBRT-style: only the\n"
			"open sky (built from the game's outdoor ambient), the sun, the game's lights and their bounces - light has to come in through windows\n"
			"and doors, so interiors get darker and every object shadowed. Raise Brightness to match.");
		slider("Ray length (m)", "PTRayLength", s_ray_length, 1.0f, 50.0f, "%.1f",
			"How far the path-traced rays look for surfaces, in metres (RE9 renderer). DD2 renderer: where a ray hits a surface\n"
			"the camera does not see, the near field for the game's baked light - nearer, the surface shadows it; beyond, the\n"
			"baked light from that direction stands (rays that hit what the camera sees take the game's own light there).");
		slider("Sun softness", "PTSunSoftness", s_sun_softness, 0.1f, 5.0f, "%.1f deg",   // (v97: the Occlusion slider above is gone)
			"Ray-traced sun shadows: rays toward the sun spread over a cone of this half angle (the sun itself is 0.27 deg).\n"
			"They add to the game's shadow maps (which keep the casters the game did not draw this frame).");
		slider("Light shadows", "PTLightShadows", s_light_shadows, 0.0f, 1.0f, "%.2f",
			"The game's lights (lamps, fires, the flashlight) with ray-traced shadows on top of its shadow maps (every object\ncasts, characters too): how dark those shadows get (1 = fully). 0 = the game's shadow maps alone (with Path tracing\nat 0: the game's own lights).");
		slider("Remember geometry", "PTKeepGeometry", s_keep_seconds, 0.0f, 300.0f, "%.0f s",   // v94
			"Objects that stood still on the screen stay in the ray-traced scene this long after the game stops drawing them\n"
			"(off the screen, behind something), so they keep blocking light: a remembered lamp no longer shines through a wall\n"
			"you turned away from (as GBRT and RTX Remix's anti-culling keep what the camera saw). The shadow rays only for now -\n"
			"bounce light still passes where the game draws nothing. 0 = only what the game drew this frame.");
		slider("Path tracing", "PTFull", s_full, 0.0f, 1.0f, "%.2f",
			"1 = the path tracer lights every surface (the sun and the game's lights with ray-traced shadows, path-traced bounce,\n"
			"sky and reflections). 0 = the game's own lighting (its lights with ray-traced shadows while Light shadows is above 0).\n"
			"In between: a blend. Path tracing and Light shadows at 0 switch the add-on off.");
		slider("Light size (cm)", "PTLightSize", s_light_size, 0.0f, 50.0f, "%.0f cm",
			"Smallest radius of a light for its ray-traced shadows (the game gives some lights a radius of their own):\nlarger = softer shadow edges.");
		slider("Brightness", "PTBrightness", s_brightness, 0.25f, 8.0f, "x%.2f",   // (v97: the Sun slider above is gone - the game's sun, DD2's way)
			"Overall level of the path-traced lighting (Path tracing above 0).");
		slider("Contact shadows", "PTContact", s_contact, 0.0f, 1.0f, "%.2f",
			"Shadows of the bounce and sky light under and between objects: one short ray per pixel (0.5 m) finds what is near\n"
			"(full path tracing), averaged over the frames with the bounce light (v72). 0 = off.");
		slider("Lights", "PTLampLight", s_lamps, 0.0f, 100.0f, "%.2f",   // v65: new key - Lamps restarts at 1 (v64 ini: 8); v85: up to 100;
			"Detection of lights and rendering them, adjust intensity per game or situation.",  // v97: "Lamps" renamed (user)
			ImGuiSliderFlags_Logarithmic);
		{
			bool on = s_path_reuse.load() > 0.5f;          // v68
			if (ImGui::Checkbox("Path reuse (ReSTIR PT Enhanced)", &on))
			{
				s_path_reuse = on ? 1.0f : 0.0f;
				reshade::set_config_value(nullptr, "TLOU RT", "PTPathReuse", on ? 1.0f : 0.0f);
			}
			ImGui::SetItemTooltip("%s", "NVIDIA's ReSTIR PT Enhanced (2026) on the bounce light, both renderers: each pixel's path is shared with\n"
				"three partner pixels from Gaussian pairing textures (a pair shares the work: one ray per partner), weighted by\n"
				"pairwise MIS (unbiased) and shaded as a colour-weighted sum - about four paths' worth of light per pixel.\n"
				"Fresh paths every frame (no reuse over time yet): the noise does not stick to the surfaces.\n"
				"The RE9 renderer with NVIDIA ReSTIR PT on: replaced by it (v84). Off = each pixel its own path (v67).");
		}
		{
			bool on = s_rtxdi_pt.load() > 0.5f;            // v83
			if (ImGui::Checkbox("NVIDIA ReSTIR PT (RE9)", &on))
			{
				s_rtxdi_pt = on ? 1.0f : 0.0f;
				reshade::set_config_value(nullptr, "TLOU RT", "PTRtxdiPT", on ? 1.0f : 0.0f);
			}
			ImGui::SetItemTooltip("%s", "The RE9 renderer's bounce light through NVIDIA's ReSTIR PT (RTXDI, compiled into the add-on), in place of\n"
				"Path reuse there (v84): each pixel's path kept in a reservoir and reused over the frames - last frame's path at the\n"
				"same surface shifted here (reconnected at its hit, or replayed from its random numbers on glossy surfaces), weighed\n"
				"against this frame's (pairwise MIS, a shadow ray) - then the paths of the neighbours CGNS picks (ReSTIR PT\n"
				"neighbours). The duplication cap shortens the history where many pixels share one path. With Ray Reconstruction\n"
				"stale or outlier pixels show their fresh path (Decorrelation for RR); without it a boiling filter.\n"
				"Off = Path reuse (v68), or a fresh path per pixel every frame.");
		}
		{
			int n = std::clamp(s_pt_spatial.load(), 0, 4);   // v84
			if (ImGui::SliderInt("ReSTIR PT neighbours", &n, 0, 4))
			{
				s_pt_spatial = std::clamp(n, 0, 4);
				reshade::set_config_value(nullptr, "TLOU RT", "PTSpatialSamples", static_cast<float>(s_pt_spatial.load()));
			}
			ImGui::SetItemTooltip("%s", "NVIDIA ReSTIR PT's spatial reuse: the neighbours per pixel whose paths it takes in, picked by NVIDIA's\n"
				"compatibility-guided neighbour selection (CGNS) among 32 pixels around it - those whose surfaces face the same way\n"
				"at about the same place. Up to 4 where a pixel has no history yet (just uncovered). More = less noise, slower\n"
				"(two rays each). 0 = reuse over time only (v83).");
		}
		slider("Decorrelation for RR", "PTDecorrelation", s_pt_decorrelation, 0.0f, 1.0f, "%.2f",
			"With Ray Reconstruction: how readily a pixel whose ReSTIR PT path has stayed the same for frames shows its fresh\n"
			"path instead (NVIDIA's stagnancy decorrelation: RR expects noise that changes every frame and can smear a path\n"
			"that sticks into blotches). Higher = safer for RR, noisier, less of the reuse's gain. NVIDIA's default is 0.4 - in\n"
			"v83 it swapped about three pixels in four back to their fresh path. 0 = off.");
		{
			bool on = s_restir.load() > 0.5f;              // v38 ReSTIR GI; v67: GI and DI; v68: DI only
			if (ImGui::Checkbox("Reuse light samples", &on))
			{
				s_restir = on ? 1.0f : 0.0f;
				reshade::set_config_value(nullptr, "TLOU RT", "PTRe9Reuse", on ? 1.0f : 0.0f);
			}
			ImGui::SetItemTooltip("%s", "Lamp samples reused over the frames and between neighbours - NVIDIA RTXDI's (both renderers) or the RE9\n"
				"renderer's own ReSTIR DI (the lamps: the game's emissive surfaces lit as lights; the game's lights and the sun are\n"
				"every-frame terms). Less noise; a lamp a pixel cannot see is not passed on (v72, v75; RTXDI: v76). Off = fresh lamp\n"
				"samples every frame. The bounce light has its own reuse: NVIDIA ReSTIR PT (RE9), else Path reuse.");
		}
		{
			bool on = s_rtxdi_on.load() > 0.5f;            // v76 (RE9), v77 both renderers
			if (ImGui::Checkbox("NVIDIA RTXDI lamps", &on))
			{
				s_rtxdi_on = on ? 1.0f : 0.0f;
				reshade::set_config_value(nullptr, "TLOU RT", "PTRtxdi", on ? 1.0f : 0.0f);
			}
			ImGui::SetItemTooltip("%s", "The lamps' light at the surfaces the camera sees from NVIDIA's RTXDI library (its ReSTIR DI, compiled into\n"
				"the add-on) in place of the add-on's own: the lamps drawn per pixel (from the pixel's ReGIR cell with \"NVIDIA\n"
				"ReGIR\" on), reused over the frames and between neighbours (\"Reuse light samples\"), and a lamp a pixel cannot\n"
				"see dropped before it is passed on. Diffuse and specular (v82; v86: kept apart for Ray Reconstruction); with\n"
				"\"NVIDIA RTXDI game lights\" the game's own lights in it too. Both renderers (v77; v76: RE9).");
			bool regir = s_regir_on.load() > 0.5f;         // v77
			if (ImGui::Checkbox("NVIDIA ReGIR", &regir))
			{
				s_regir_on = regir ? 1.0f : 0.0f;
				reshade::set_config_value(nullptr, "TLOU RT", "PTRegir", regir ? 1.0f : 0.0f);
			}
			ImGui::SetItemTooltip("%s", "NVIDIA's ReGIR (RTXDI): a world-space onion of cells around the camera, each holding the lamps that matter\n"
				"there, rebuilt every frame. RTXDI's lamps draw their candidates from the pixel's cell, and the paths' bounce hits\n"
				"(both renderers) light themselves from their cell - in place of uniform picks over every lamp (less noise in the\n"
				"lamp-lit bounce light, most with many lamps). Off = the bounce hits' uniform picks (v76), RTXDI's lamps drawn by\n"
				"power.");
			bool game = s_rtxdi_game.load() > 0.5f;            // v86
			if (ImGui::Checkbox("NVIDIA RTXDI game lights", &game))
			{
				s_rtxdi_game = game ? 1.0f : 0.0f;
				reshade::set_config_value(nullptr, "TLOU RT", "PTRtxdiGame", game ? 1.0f : 0.0f);
			}
			ImGui::SetItemTooltip("%s", "The game's own lights (its point, spot and box lights, with their shadow maps, cones and cookies) join the\n"
				"lamps in RTXDI: one ReSTIR DI estimate for both at the surfaces the camera sees (with NVIDIA RTXDI lamps on), and\n"
				"the paths' bounce hits pick a lamp or a game's light from their ReGIR cell by how much it lights them (one shadow\n"
				"ray). Off = every game light summed at each pixel with its own ray and one picked at random at a bounce hit (v71).");
			bool cells = s_regir_cells.load() > 0.5f;          // v90
			if (ImGui::Checkbox("ReGIR surface cells", &cells))
			{
				s_regir_cells = cells ? 1.0f : 0.0f;
				reshade::set_config_value(nullptr, "TLOU RT", "PTRegirCells", cells ? 1.0f : 0.0f);
			}
			ImGui::SetItemTooltip("%s", "The ReGIR article's grid (with NVIDIA ReGIR on): cells on the scene's surfaces where the bounce rays land (NVIDIA's\n"
				"hash grid from the SHARC SDK), each holding the lamps and game lights that can light its surfaces - facing them,\n"
				"in reach, in their cones - so a bounce hit picks among lights that matter there. A hit without a cell yet uses\n"
				"NVIDIA ReGIR's cells around the camera, as before. Debug view 10 shows the cells. Off = v88.");
			slider("ReGIR cell detail", "PTRegirScale", s_regir_scale, 4.0f, 64.0f, "%.0f",
				"The surface cells' size: higher = smaller cells (more precise, more of them to fill). At 16 a cell is about\n"
				"1/16 to 1/32 of its distance from the camera across (25 cm at 4 m, 1 m at 16 m).", ImGuiSliderFlags_Logarithmic);
			slider("ReGIR candidates", "PTRegirCandidates", s_regir_candidates, 1.0f, 32.0f, "%.0f",
				"Lights tried for each of a ReGIR cell's light slots (NVIDIA's default 8). More = each slot closer to the cell's best\n"
				"lights - but the cells do not know shadows: where the strongest light is shadowed, many candidates fill every slot\n"
				"with it and the other lights turn into bright noise (v88-v90 used 32). Fewer = more variety, more plain noise.\n"
				"v92: applies to the slots that are not plain (below).");
			slider("ReGIR plain slots", "PTRegirPlain", s_regir_plain, 0.0f, 100.0f, "%.0f%%",
				"The share of each ReGIR cell's light slots that hold one light picked by brightness alone (the ReGIR article's\n"
				"\"canonical\" samples): every light that reaches the cell keeps a fair chance, so a strong light that is shadowed\n"
				"cannot crowd the others out (v88-v91's bright noise). The rest use the candidates above. 0 = v91.");
			slider("ReGIR game-light share", "PTRegirGameShare", s_regir_game_share, 0.0f, 100.0f, "%.0f%%",   // v96
				"The share of each ReGIR cell's light candidates drawn evenly among the game's own lights (the rest by power, as\n"
				"before): a light that is dim in power but reaches the surface - the fill light the game aims at a wall - keeps\n"
				"coming up when bright lamps hold most of the power (Lights far above 1), instead of in a few cells with huge\n"
				"weights (blotches that Ray Reconstruction turns into a pulse). The light stays the same on average. 0 = v95.");
			bool vis_cache = s_regir_vis_cache.load() > 0.5f;  // v93
			if (ImGui::Checkbox("ReGIR visibility cache", &vis_cache))
			{
				s_regir_vis_cache = vis_cache ? 1.0f : 0.0f;
				reshade::set_config_value(nullptr, "TLOU RT", "PTRegirVisCache", vis_cache ? 1.0f : 0.0f);
			}
			ImGui::SetItemTooltip("%s", "The ReGIR article's NEE++: the shadow rays already traced (RTXDI's at the camera's surfaces, the bounce\n"
				"hits' picks) teach a cache how well each patch of surface sees each light, and the light picks weigh every light\n"
				"by that chance - a lamp behind a wall, a light whose shadow covers the patch, is tried less, so the lights that\n"
				"do reach it are found more often (less noise in shadowed and indoor areas). Never below the floor below: no\n"
				"light is ever ruled out. Off = v92.");
			slider("ReGIR visibility floor", "PTRegirVisFloor", s_regir_vis_floor, 0.01f, 0.5f, "%.2f",
				"The least weight the visibility cache leaves a light it has seen blocked: lower = blocked lights tried less (less\n"
				"noise where the cache is right, more where it is wrong - a light that just came into view, a door opened). 0.05\n"
				"default.", ImGuiSliderFlags_Logarithmic);
			int bias = std::clamp(s_rtxdi_bias.load(), 0, 3);
			if (ImGui::Combo("RTXDI bias correction", &bias, "Off (fastest)\0Basic\0Pairwise\0Ray traced (unbiased)\0"))
			{
				s_rtxdi_bias = bias;
				reshade::set_config_value(nullptr, "TLOU RT", "PTRtxdiBias", static_cast<float>(bias));
			}
			ImGui::SetItemTooltip("%s", "How RTXDI weighs the lamps it takes from last frame and the neighbours: Ray traced traces a shadow ray\n"
				"for each (correct in shadows, up to three more rays per pixel); Basic and Pairwise assume they are seen (faster,\n"
				"slightly dark at shadow edges); Off counts samples only (darkest).");
		}
		{
			bool on = s_sharc_nv.load() > 0.5f;                // v87
			if (ImGui::Checkbox("NVIDIA SHaRC", &on))
			{
				s_sharc_nv = on ? 1.0f : 0.0f;
				reshade::set_config_value(nullptr, "TLOU RT", "PTSharcNV", on ? 1.0f : 0.0f);
			}
			ImGui::SetItemTooltip("%s", "NVIDIA's SHaRC radiance cache (its SDK compiled into the add-on) in place of the add-on's own (v23): the light\n"
				"leaving surfaces kept in world-space voxels, learnt each frame from sparse paths (one pixel in each 5x5 block,\n"
				"up to 4 bounces) and from what the camera sees. A bounce that reaches a surface the camera does not see takes\n"
				"the voxel's light there and ends - only where the ray was long and the lobe wide enough for a voxel (NVIDIA's\n"
				"gates). Both renderers and ReSTIR PT. Off = the add-on's own cache. Debug views 8 and 9 show it.");
			slider("SHaRC voxel detail", "PTSharcScale", s_sharc_scale, 1.0f, 100.0f, "%.0f",
				"NVIDIA SHaRC's scene scale: higher = smaller voxels (finer light, slower to fill, more of the cache), lower =\n"
				"larger voxels (smoother, light can leak through thin walls). NVIDIA's default is 50. Changing it clears the cache.");
			slider("SHaRC frames", "PTSharcFrames", s_sharc_frames, 1.0f, 100.0f, "%.0f",
				"How many frames of samples each voxel of NVIDIA SHaRC averages: more = steadier, slower to follow a light that\n"
				"changes. NVIDIA's default is 32.");
			if (ImGui::Button("Reset SHaRC"))
				s_sharc_reset = true;
			ImGui::SetItemTooltip("%s", "Empties NVIDIA SHaRC's cache: it fills again over the next frames.");
		}
		{
			bool on = s_relight.load() > 0.5f;             // v50
			if (ImGui::Checkbox("Relight forward layers", &on))
			{
				s_relight = on ? 1.0f : 0.0f;
				reshade::set_config_value(nullptr, "TLOU RT", "PTRelight", on ? 1.0f : 0.0f);
			}
			ImGui::SetItemTooltip("%s", "With path tracing: what the game draws over its lighting with its own light (the eyes, some objects)\n"
				"follows the path tracing's light around it, before the fog. Off = those layers keep the game's light (they glow in the dark).");
		}
		{
			bool on = s_rr.load() > 0.5f;                  // v59
			if (ImGui::Checkbox("Ray Reconstruction (DLSS)", &on))
			{
				s_rr = on ? 1.0f : 0.0f;
				reshade::set_config_value(nullptr, "TLOU RT", "PTRayReconstruction", on ? 1.0f : 0.0f);
			}
			ImGui::SetItemTooltip("%s", "NVIDIA DLSS Ray Reconstruction denoises the path tracing (both renderers) in place of the add-on's\n"
				"accumulation. It runs in a helper program (tlou-rt-rr\\tlou-rt-rr.exe beside the add-on, its own process: inside the\n"
				"game RR hangs RenoDX's Neural Rendering) and its light arrives one frame later, moved onto the frame by the\n"
				"motion; where the frame before did not see a surface the accumulation's light stays. Not with a Debug view.\n"
				"Its state is shown below; the helper's log: tlou-rt-rr\\tlou-rt-rr.log.");
			std::string message;
			{
				const std::lock_guard<std::mutex> lock(s_rr_message_mutex);
				message = s_rr_message;
			}
			ImGui::TextDisabled("Ray Reconstruction: %s", message.c_str());
		}
		{
			// v80: RR in place of the game's DLSS upscaling (rr_game_evaluate); v81: it denoises too (the path tracing's noisy light),
			// saved - a session that ends while RR is being made switches it off (rr_game_check_marker)
			bool on = s_rr_up.load() > 0.5f;
			ImGui::BeginDisabled(!s_sl_hooked.load());
			if (ImGui::Checkbox("Ray Reconstruction in the game (denoise + upscale)", &on))
			{
				s_rr_up = on ? 1.0f : 0.0f;
				reshade::set_config_value(nullptr, "TLOU RT", "PTRRInGame", on ? 1.0f : 0.0f);
				if (on && s_probe_state.load() < 0)
					s_probe_state = 0;                     // a failed creation is tried again
			}
			ImGui::EndDisabled();
			ImGui::SetItemTooltip("%s", "DLSS Ray Reconstruction takes over the frame as in a game with RR (Resident Evil Requiem's path tracing):\n"
				"the path tracing's noisy light goes into the frame and RR, in place of the game's DLSS, denoises and upscales it\n"
				"(render size to 1920x1080) - the game's colour, depth, motion, exposure and jitter, the path tracing's albedo,\n"
				"normal and roughness. With path tracing on; the game's DLSS upscales whenever anything is missing (the reason\n"
				"below). The helper's Ray Reconstruction above rests meanwhile. The steps go to tlou-rt-rr\\tlou-rt-rr-game.log.");
			std::string state, reason, hook;
			{
				const std::lock_guard<std::mutex> lock(s_probe_message_mutex);
				state = s_probe_message;
				reason = s_rr_up_reason;
				hook = s_sl_hook_message;
			}
			ImGui::TextDisabled("RR upscaling: %s | %llu frames by RR, %llu by the game's DLSS%s%s | the game's DLSS evaluates %llu, hooks %s", state.c_str(),
				static_cast<unsigned long long>(s_rr_up_frames.load()), static_cast<unsigned long long>(s_rr_up_fallbacks.load()), reason.empty() ? "" : " - last: ",
				reason.c_str(), static_cast<unsigned long long>(s_dlss_evaluates.load()), hook.c_str());
		}
		ImGui::TextDisabled("v%d: %s, %llu frames", TLOU_RT_VERSION, get_status().c_str(), static_cast<unsigned long long>(s_injected.load()));
		const std::lock_guard<std::mutex> lock(s_status_mutex);
		for (const std::string &line : s_rt_status)
			if (!line.empty())
				ImGui::TextDisabled("%s", line.c_str());
	}

	// ---- root signatures ----

	bool is_static_sampler_param(const pipeline_layout_param &p)
	{
		return p.type == pipeline_layout_param_type::push_descriptors_with_ranges_and_flags && p.descriptor_table_with_flags.count != 0 &&
			p.descriptor_table_with_flags.ranges[0].type == descriptor_type::sampler && p.descriptor_table_with_flags.ranges[0].static_samplers != nullptr;
	}

	void on_init_pipeline_layout(device *, uint32_t count, const pipeline_layout_param *params, pipeline_layout layout)
	{
		auto saved = std::make_shared<saved_layout>();
		saved->params.assign(params, params + count);
		for (pipeline_layout_param &p : saved->params)
		{
			switch (p.type)
			{
			case pipeline_layout_param_type::descriptor_table:
			case pipeline_layout_param_type::push_descriptors_with_ranges:
				if (p.descriptor_table.count != 0 && p.descriptor_table.ranges != nullptr)
				{
					auto copy = std::make_unique<descriptor_range[]>(p.descriptor_table.count);
					std::copy_n(p.descriptor_table.ranges, p.descriptor_table.count, copy.get());
					p.descriptor_table.ranges = copy.get();
					saved->ranges.push_back(std::move(copy));
				}
				break;
			case pipeline_layout_param_type::descriptor_table_with_flags:
			case pipeline_layout_param_type::push_descriptors_with_ranges_and_flags:
				if (p.descriptor_table_with_flags.count != 0 && p.descriptor_table_with_flags.ranges != nullptr)
				{
					auto copy = std::make_unique<descriptor_range_with_flags[]>(p.descriptor_table_with_flags.count);
					std::copy_n(p.descriptor_table_with_flags.ranges, p.descriptor_table_with_flags.count, copy.get());
					for (uint32_t i = 0; i < p.descriptor_table_with_flags.count; ++i)
						if (copy[i].static_samplers != nullptr && copy[i].count != 0)
						{
							auto samplers = std::make_unique<sampler_desc[]>(copy[i].count);
							std::copy_n(copy[i].static_samplers, copy[i].count, samplers.get());
							copy[i].static_samplers = samplers.get();
							saved->samplers.push_back(std::move(samplers));
						}
					p.descriptor_table_with_flags.ranges = copy.get();
					saved->franges.push_back(std::move(copy));
				}
				break;
			default:                                       // push_constants, push_descriptors: stored inline
				break;
			}
		}
		const std::lock_guard<std::mutex> lock(s_layout_mutex);
		s_layouts[layout.handle] = std::move(saved);
	}

	// A root signature the game creates later can get the same address: nothing cached under this one may be found for it
	// (its stream-out copy and the add-on's lighting pipelines are retired, its prepass pipelines stop streaming)
	void on_destroy_pipeline_layout(device *, pipeline_layout layout)
	{
		{
			const std::lock_guard<std::mutex> lock(s_layout_mutex);
			s_layouts.erase(layout.handle);
		}
		{
			const std::unique_lock<std::shared_mutex> lock(s_geo_mutex);
			if (const auto it = s_so_roots.find(layout.handle); it != s_so_roots.end())
			{
				if (it->second != nullptr)
					retire(it->second);
				s_so_roots.erase(it);
				for (auto &[pipe, info] : s_prepass)
					if (info->root == layout.handle)
					{
						info->root = 0;
						info->so_root = nullptr;               // its clone is released with the game's pipeline
					}
			}
		}
		const std::unique_lock<std::shared_mutex> lock(s_mutex);
		if (const auto it = s_inject.find(layout.handle); it != s_inject.end())
		{
			for (ID3D12PipelineState *pso : it->second.pso)
				if (pso != nullptr)
					retire(pso);
			if (it->second.layout != 0)
				retire(nullptr, it->second.layout);
			s_inject.erase(it);
		}
		for (auto it = s_lighting.begin(); it != s_lighting.end();)
			it = it->second == layout.handle ? s_lighting.erase(it) : std::next(it);
	}

	std::shared_ptr<saved_layout> find_layout(uint64_t root)
	{
		const std::lock_guard<std::mutex> lock(s_layout_mutex);
		const auto it = s_layouts.find(root);
		return it != s_layouts.end() ? it->second : nullptr;
	}

	std::string param_name(const pipeline_layout_param &p)
	{
		switch (p.type)
		{
		case pipeline_layout_param_type::push_constants: return strf("%u constants", p.push_constants.count);
		case pipeline_layout_param_type::descriptor_table: case pipeline_layout_param_type::descriptor_table_with_flags: return "table";
		case pipeline_layout_param_type::push_descriptors: return "root descriptor";
		default: return "root descriptor/samplers";
		}
	}

	D3D12_DESCRIPTOR_RANGE_TYPE range_type(descriptor_type type)
	{
		switch (type)
		{
		case descriptor_type::sampler: return D3D12_DESCRIPTOR_RANGE_TYPE_SAMPLER;
		case descriptor_type::unordered_access_view: case descriptor_type::buffer_unordered_access_view: return D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
		case descriptor_type::constant_buffer: return D3D12_DESCRIPTOR_RANGE_TYPE_CBV;
		default: return D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
		}
	}

	D3D12_SHADER_VISIBILITY visibility(shader_stage stage)
	{
		switch (stage)
		{
		case shader_stage::vertex: return D3D12_SHADER_VISIBILITY_VERTEX;
		case shader_stage::hull: return D3D12_SHADER_VISIBILITY_HULL;
		case shader_stage::domain: return D3D12_SHADER_VISIBILITY_DOMAIN;
		case shader_stage::geometry: return D3D12_SHADER_VISIBILITY_GEOMETRY;
		case shader_stage::pixel: return D3D12_SHADER_VISIBILITY_PIXEL;
		case shader_stage::amplification: return D3D12_SHADER_VISIBILITY_AMPLIFICATION;
		case shader_stage::mesh: return D3D12_SHADER_VISIBILITY_MESH;
		default: return D3D12_SHADER_VISIBILITY_ALL;
		}
	}

	// Native copy of a game root signature with ALLOW_STREAM_OUTPUT (conversions as ReShade 6.8's d3d12_impl_device.cpp /
	// d3d12_impl_type_convert.cpp: flags are casts, compare_op + 1, ranges keep their explicit table offsets)
	ID3D12RootSignature *create_so_root_signature(ID3D12Device *d, const saved_layout &layout)
	{
		std::vector<D3D12_ROOT_PARAMETER1> params;
		std::vector<std::vector<D3D12_DESCRIPTOR_RANGE1>> ranges(layout.params.size());
		std::vector<D3D12_STATIC_SAMPLER_DESC> samplers;
		for (size_t i = 0; i < layout.params.size(); ++i)
		{
			const pipeline_layout_param &p = layout.params[i];
			if (is_static_sampler_param(p))
			{
				for (uint32_t k = 0; k < p.descriptor_table_with_flags.count; ++k)
				{
					const descriptor_range_with_flags &r = p.descriptor_table_with_flags.ranges[k];
					for (uint32_t j = 0; j < r.count; ++j)
					{
						const sampler_desc &s = r.static_samplers[j];
						D3D12_STATIC_SAMPLER_DESC desc = {};
						desc.Filter = static_cast<D3D12_FILTER>(s.filter);
						desc.AddressU = static_cast<D3D12_TEXTURE_ADDRESS_MODE>(s.address_u);
						desc.AddressV = static_cast<D3D12_TEXTURE_ADDRESS_MODE>(s.address_v);
						desc.AddressW = static_cast<D3D12_TEXTURE_ADDRESS_MODE>(s.address_w);
						desc.MipLODBias = s.mip_lod_bias;
						desc.MaxAnisotropy = static_cast<UINT>(s.max_anisotropy);
						desc.ComparisonFunc = static_cast<D3D12_COMPARISON_FUNC>(static_cast<uint32_t>(s.compare_op) + 1);
						desc.BorderColor = s.border_color[3] == 0.0f ? D3D12_STATIC_BORDER_COLOR_TRANSPARENT_BLACK :
							(s.border_color[0] == 0.0f && s.border_color[1] == 0.0f && s.border_color[2] == 0.0f) ? D3D12_STATIC_BORDER_COLOR_OPAQUE_BLACK : D3D12_STATIC_BORDER_COLOR_OPAQUE_WHITE;
						desc.MinLOD = s.min_lod;
						desc.MaxLOD = s.max_lod;
						desc.ShaderRegister = r.dx_register_index + j;
						desc.RegisterSpace = r.dx_register_space;
						desc.ShaderVisibility = visibility(r.visibility);
						samplers.push_back(desc);
					}
				}
				continue;
			}
			D3D12_ROOT_PARAMETER1 rp = {};
			switch (p.type)
			{
			case pipeline_layout_param_type::push_constants:
				rp.ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
				rp.Constants.ShaderRegister = p.push_constants.dx_register_index;
				rp.Constants.RegisterSpace = p.push_constants.dx_register_space;
				rp.Constants.Num32BitValues = p.push_constants.count;
				rp.ShaderVisibility = visibility(p.push_constants.visibility);
				break;
			case pipeline_layout_param_type::push_descriptors:
			case pipeline_layout_param_type::push_descriptors_with_ranges_and_flags:
			{
				const bool with_flags = p.type == pipeline_layout_param_type::push_descriptors_with_ranges_and_flags;
				const descriptor_range &r = with_flags ? static_cast<const descriptor_range &>(p.descriptor_table_with_flags.ranges[0]) : p.push_descriptors;
				rp.ParameterType = r.type == descriptor_type::constant_buffer ? D3D12_ROOT_PARAMETER_TYPE_CBV :
					(r.type == descriptor_type::unordered_access_view || r.type == descriptor_type::buffer_unordered_access_view) ? D3D12_ROOT_PARAMETER_TYPE_UAV : D3D12_ROOT_PARAMETER_TYPE_SRV;
				rp.Descriptor.ShaderRegister = r.dx_register_index;
				rp.Descriptor.RegisterSpace = r.dx_register_space;
				rp.Descriptor.Flags = with_flags ? static_cast<D3D12_ROOT_DESCRIPTOR_FLAGS>(p.descriptor_table_with_flags.ranges[0].flags) : D3D12_ROOT_DESCRIPTOR_FLAG_DATA_VOLATILE;
				rp.ShaderVisibility = visibility(r.visibility);
				break;
			}
			default:                                       // descriptor tables
			{
				const bool with_flags = p.type == pipeline_layout_param_type::descriptor_table_with_flags;
				const uint32_t count = with_flags ? p.descriptor_table_with_flags.count : p.descriptor_table.count;
				for (uint32_t k = 0; k < count; ++k)
				{
					const descriptor_range &r = with_flags ? static_cast<const descriptor_range &>(p.descriptor_table_with_flags.ranges[k]) : p.descriptor_table.ranges[k];
					D3D12_DESCRIPTOR_RANGE1 range = {};
					range.RangeType = range_type(r.type);
					range.NumDescriptors = r.count;
					range.BaseShaderRegister = r.dx_register_index;
					range.RegisterSpace = r.dx_register_space;
					range.Flags = with_flags ? static_cast<D3D12_DESCRIPTOR_RANGE_FLAGS>(p.descriptor_table_with_flags.ranges[k].flags) :
						range.RangeType == D3D12_DESCRIPTOR_RANGE_TYPE_SAMPLER ? D3D12_DESCRIPTOR_RANGE_FLAG_DESCRIPTORS_VOLATILE :
						D3D12_DESCRIPTOR_RANGE_FLAG_DESCRIPTORS_VOLATILE | D3D12_DESCRIPTOR_RANGE_FLAG_DATA_VOLATILE;
					range.OffsetInDescriptorsFromTableStart = r.binding;
					ranges[i].push_back(range);
				}
				rp.ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
				rp.DescriptorTable.NumDescriptorRanges = static_cast<UINT>(ranges[i].size());
				rp.DescriptorTable.pDescriptorRanges = ranges[i].data();
				rp.ShaderVisibility = count != 0 ? visibility(with_flags ? p.descriptor_table_with_flags.ranges[0].visibility : p.descriptor_table.ranges[0].visibility) : D3D12_SHADER_VISIBILITY_ALL;
				break;
			}
			}
			params.push_back(rp);
		}
		D3D12_VERSIONED_ROOT_SIGNATURE_DESC desc = {};
		desc.Version = D3D_ROOT_SIGNATURE_VERSION_1_1;
		desc.Desc_1_1.NumParameters = static_cast<UINT>(params.size());
		desc.Desc_1_1.pParameters = params.data();
		desc.Desc_1_1.NumStaticSamplers = static_cast<UINT>(samplers.size());
		desc.Desc_1_1.pStaticSamplers = samplers.data();
		desc.Desc_1_1.Flags = D3D12_ROOT_SIGNATURE_FLAG_ALLOW_INPUT_ASSEMBLER_INPUT_LAYOUT | D3D12_ROOT_SIGNATURE_FLAG_ALLOW_STREAM_OUTPUT;

		static const auto serialize = reinterpret_cast<decltype(&D3D12SerializeVersionedRootSignature)>(
			GetProcAddress(GetModuleHandleW(L"d3d12.dll"), "D3D12SerializeVersionedRootSignature"));
		ID3DBlob *blob = nullptr, *error = nullptr;
		ID3D12RootSignature *root = nullptr;
		if (serialize != nullptr && SUCCEEDED(serialize(&desc, &blob, &error)))
		{
			if (FAILED(d->CreateRootSignature(0, blob->GetBufferPointer(), blob->GetBufferSize(), IID_PPV_ARGS(&root))))
				root = nullptr;
		}
		else if (error != nullptr)
			log(reshade::log::level::error, "TLOU RT: serializing a stream-out root signature failed: %s", static_cast<const char *>(error->GetBufferPointer()));
		if (blob != nullptr)
			blob->Release();
		if (error != nullptr)
			error->Release();
		return root;
	}

	// The add-on's lighting root signature (the game's parameters + root UAVs u0/u1, root SRVs t0/t1 and 8 root constants,
	// all in space 100) and PSOs
	inject_set build_inject_set(device *dev, uint64_t root, uint64_t ibl_layout)
	{
		inject_set set;
		std::fill(std::begin(set.ibl_param), std::end(set.ibl_param), UINT32_MAX);
		D3D12_FEATURE_DATA_FORMAT_SUPPORT support = { DXGI_FORMAT_R11G11B10_FLOAT };
		ID3D12Device *const d = reinterpret_cast<ID3D12Device *>(dev->get_native());
		if (FAILED(d->CheckFeatureSupport(D3D12_FEATURE_FORMAT_SUPPORT, &support, sizeof(support))) || (support.Support2 & D3D12_FORMAT_SUPPORT2_UAV_TYPED_LOAD) == 0)
		{
			set_status("this GPU cannot read R11G11B10_FLOAT UAVs");
			log(reshade::log::level::error, "TLOU RT: %s, nothing will be injected", get_status().c_str());
			return set;
		}

		const std::shared_ptr<saved_layout> saved = find_layout(root);
		if (saved == nullptr)
		{
			set_status("the lighting root signature was created before the add-on loaded");
			log(reshade::log::level::error, "TLOU RT: %s", get_status().c_str());
			return set;
		}
		std::vector<pipeline_layout_param> params = saved->params; // points into *saved, kept alive by the shared_ptr
		std::string summary;
		for (const pipeline_layout_param &p : params)
			summary += (summary.empty() ? "" : ", ") + (is_static_sampler_param(p) ? std::string("static samplers") : param_name(p));
		log(reshade::log::level::info, "TLOU RT: game lighting root signature %p: %zu parameters (%s)", reinterpret_cast<void *>(root), params.size(), summary.c_str());

		const auto root_descriptor = [](descriptor_type type, uint32_t reg) {
			descriptor_range r = {};
			r.binding = 0;
			r.dx_register_index = reg;
			r.dx_register_space = 100;
			r.count = 1;
			r.visibility = shader_stage::all_compute;
			r.array_size = 1;
			r.type = type;
			return pipeline_layout_param(r);
		};
		constant_range constants = {};
		constants.binding = 0;
		constants.dx_register_index = 0;
		constants.dx_register_space = 100;
		constants.count = sizeof(rt_constants) / 4;
		constants.visibility = shader_stage::all_compute;
		const size_t insert_at = !params.empty() && is_static_sampler_param(params.back()) ? params.size() - 1 : params.size();
		const pipeline_layout_param added[] = {
			root_descriptor(descriptor_type::buffer_unordered_access_view, 0),      // Data
			pipeline_layout_param(constants),                                      // RtConstants
			root_descriptor(descriptor_type::buffer_unordered_access_view, 1),      // Geo
			root_descriptor(descriptor_type::buffer_shader_resource_view, 0),       // Scene (TLAS)
			root_descriptor(descriptor_type::buffer_shader_resource_view, 1),       // Table
			root_descriptor(descriptor_type::buffer_shader_resource_view, 2),       // LightCounts (v18: the game's t13 range)
			root_descriptor(descriptor_type::buffer_unordered_access_view, 2),      // RtxdiReservoirs (v76: rtxdi.hlsli)
			root_descriptor(descriptor_type::buffer_unordered_access_view, 3),      // RtxdiRis (v77)
			root_descriptor(descriptor_type::constant_buffer, 1),                   // g_rtxdi (v77: the frame's RTXDI constants)
			root_descriptor(descriptor_type::buffer_unordered_access_view, 4),      // RtxdiPTReservoirs (v83: rtxdi_pt_frame.hlsli)
			root_descriptor(descriptor_type::constant_buffer, 2),                   // g_pt (v83: the frame's ReSTIR PT constants)
			root_descriptor(descriptor_type::buffer_unordered_access_view, 5),      // SharcHashEntries (v87: sharc.hlsli)
			root_descriptor(descriptor_type::buffer_unordered_access_view, 6),      // SharcAccumulation
			root_descriptor(descriptor_type::buffer_unordered_access_view, 7),      // SharcResolved
			root_descriptor(descriptor_type::buffer_unordered_access_view, 8) };    // RegirKeys (v90: regir_cells.hlsli)
		params.insert(params.begin() + insert_at, std::begin(added), std::end(added));
		// v19: Cs_SpecularIbl's parameters (its probes' buffers, cubemaps and constants) with their registers in space 101 + their
		// space, after the add-on's (its sampler tables and static samplers are left out: the add-on's EnvSampler)
		std::vector<std::unique_ptr<descriptor_range[]>> mirror_ranges;
		std::vector<std::unique_ptr<descriptor_range_with_flags[]>> mirror_franges;
		std::vector<pipeline_layout_param> mirrored;
		const std::shared_ptr<saved_layout> ibl = ibl_layout != 0 ? find_layout(ibl_layout) : nullptr;
		for (uint32_t p = 0; ibl != nullptr && p < ibl->params.size() && p < 64; ++p)
		{
			pipeline_layout_param param = ibl->params[p];
			bool keep = true;
			switch (param.type)
			{
			case pipeline_layout_param_type::push_constants:
				param.push_constants.dx_register_space += 101;
				break;
			case pipeline_layout_param_type::push_descriptors:
				keep = param.push_descriptors.type != descriptor_type::sampler;
				param.push_descriptors.dx_register_space += 101;
				break;
			case pipeline_layout_param_type::descriptor_table:
			case pipeline_layout_param_type::push_descriptors_with_ranges:
			{
				auto copy = std::make_unique<descriptor_range[]>(std::max(param.descriptor_table.count, 1u));
				keep = false;
				for (uint32_t k = 0; k < param.descriptor_table.count; ++k)
				{
					copy[k] = param.descriptor_table.ranges[k];
					copy[k].dx_register_space += 101;
					keep |= copy[k].type != descriptor_type::sampler;
				}
				param.descriptor_table.ranges = copy.get();
				mirror_ranges.push_back(std::move(copy));
				break;
			}
			default:                                           // with flags (tables, root descriptors, static samplers)
			{
				auto copy = std::make_unique<descriptor_range_with_flags[]>(std::max(param.descriptor_table_with_flags.count, 1u));
				keep = false;
				for (uint32_t k = 0; k < param.descriptor_table_with_flags.count; ++k)
				{
					copy[k] = param.descriptor_table_with_flags.ranges[k];
					copy[k].dx_register_space += 101;
					keep |= copy[k].type != descriptor_type::sampler;
				}
				param.descriptor_table_with_flags.ranges = copy.get();
				mirror_franges.push_back(std::move(copy));
				break;
			}
			}
			if (!keep)
				continue;
			set.ibl_param[p] = static_cast<uint32_t>(insert_at + std::size(added) + mirrored.size());
			mirrored.push_back(param);
		}
		set.ibl_layout = ibl_layout;
		set.ibl_count = static_cast<uint32_t>(mirrored.size());
		// without Cs_SpecularIbl's root signature (not created yet, or nothing mirrored): its registers as placeholders that
		// are never bound (g_env_on 0: the rays take the baked sky), since every register the passes declare must be in the
		// root signature for their pipelines to be created
		descriptor_range placeholder_ranges[2] = {};
		descriptor_range placeholder_cbv = {};
		if (mirrored.empty())
		{
			for (descriptor_range &r : placeholder_ranges)
			{
				r.dx_register_space = 101;
				r.visibility = shader_stage::all_compute;
				r.array_size = 1;
				r.type = descriptor_type::shader_resource_view;
			}
			placeholder_ranges[0].binding = 0;                     // t0, t1: the probes' descriptions and tile masks
			placeholder_ranges[0].dx_register_index = 0;
			placeholder_ranges[0].count = 2;
			placeholder_ranges[1].binding = 2;                     // t8: the 250 cubemaps
			placeholder_ranges[1].dx_register_index = 8;
			placeholder_ranges[1].count = 250;
			placeholder_cbv.dx_register_space = 101;               // b0: their constants
			placeholder_cbv.count = 1;
			placeholder_cbv.visibility = shader_stage::all_compute;
			placeholder_cbv.array_size = 1;
			placeholder_cbv.type = descriptor_type::constant_buffer;
			mirrored.push_back(pipeline_layout_param(2, placeholder_ranges));
			mirrored.push_back(pipeline_layout_param(placeholder_cbv));
		}
		params.insert(params.begin() + insert_at + std::size(added), mirrored.begin(), mirrored.end());
		// v30: the game's whole CBV/SRV/UAV heap as Texture2D (t0, space 102, unbounded): the cut-outs' masks by heap slot
		descriptor_range heap_range = {};
		heap_range.binding = 0;
		heap_range.dx_register_index = 0;
		heap_range.dx_register_space = 102;
		heap_range.count = UINT32_MAX;
		heap_range.visibility = shader_stage::all_compute;
		heap_range.array_size = 1;
		heap_range.type = descriptor_type::shader_resource_view;
		set.heap_param = static_cast<uint32_t>(params.size());
		params.push_back(pipeline_layout_param(1, &heap_range));
		// the add-on's static sampler for the probes (s0, space 100): trilinear, clamp
		const sampler_desc env_sampler = {};
		descriptor_range_with_flags sampler_range = {};
		sampler_range.binding = 0;
		sampler_range.dx_register_index = 0;
		sampler_range.dx_register_space = 100;
		sampler_range.count = 1;
		sampler_range.visibility = shader_stage::all_compute;
		sampler_range.array_size = 1;
		sampler_range.type = descriptor_type::sampler;
		sampler_range.static_samplers = &env_sampler;
		params.push_back(pipeline_layout_param(sampler_range));
		set.uav_param = static_cast<uint32_t>(insert_at);
		set.const_param = set.uav_param + 1;
		set.geo_param = set.uav_param + 2;
		set.tlas_param = set.uav_param + 3;
		set.table_param = set.uav_param + 4;
		set.counts_param = set.uav_param + 5;
		set.rtxdi_param = set.uav_param + 6;
		set.rtxdi_ris_param = set.uav_param + 7;
		set.rtxdi_cb_param = set.uav_param + 8;
		set.rtxdi_pt_param = set.uav_param + 9;
		set.rtxdi_pt_cb_param = set.uav_param + 10;
		set.sharc_param = set.uav_param + 11;              // v87: + 12, + 13
		set.regir_param = set.uav_param + 14;              // v90

		if (!dev->create_pipeline_layout(static_cast<uint32_t>(params.size()), params.data(), &set.layout))
		{
			set_status("creating the extended root signature failed");
			log(reshade::log::level::error, "TLOU RT: %s", get_status().c_str());
			return set;
		}
		const bool rt = rt_supported(d);
		set.rt_ok = rt;
		for (int p = 0; p < pass_count; ++p)
		{
			if (k_pass_rt[p] && !rt)
				continue;
			D3D12_COMPUTE_PIPELINE_STATE_DESC desc = {};
			desc.pRootSignature = reinterpret_cast<ID3D12RootSignature *>(set.layout.handle);
			desc.CS = k_pass_code[p];
			const HRESULT hr = d->CreateComputePipelineState(&desc, IID_PPV_ARGS(&set.pso[p]));
			if (FAILED(hr))
			{
				set.pso[p] = nullptr;
				log(reshade::log::level::error, "TLOU RT: creating the %s pipeline failed (0x%08X)", k_pass_names[p], static_cast<unsigned>(hr));
				if (p == pass_rtxdi_di || p == pass_rtxdi_pdf || p == pass_rtxdi_presample || p == pass_regir_build || p == pass_rr_inputs ||
					p >= pass_pt_initial)
					continue;                                  // v76, v77: optional passes - the add-on's own lamp sampling stays (v78: RR off;
					                                           //   v83: ReSTIR PT off, the RE9 renderer's own bounce; v86: the game's
					                                           //   lights outside RTXDI)
				if (k_pass_rt[p])
				{
					set.rt_ok = false;
					continue;
				}
				set_status(std::string("creating the ") + k_pass_names[p] + " pipeline failed");
				return set;
			}
		}
		set.ok = true;
		set_status("ready");
		log(reshade::log::level::info, "TLOU RT v%d: pipelines created (root parameters %u-%u, %u mirrored from the environment probes' root signature %p; hardware ray tracing passes %s)",
			TLOU_RT_VERSION, set.uav_param, set.counts_param, set.ibl_count, reinterpret_cast<void *>(ibl_layout), set.rt_ok ? "ready" : "unavailable");
		return set;
	}

	// Stream-out clone of a prepass pipeline (VS only, clip-space xyz out, no rasterisation) and the SO-capable copy of its
	// root signature, created right after the game created its pipeline
	void create_clone(ID3D12Device *d, prepass_info &info, const shader_desc &vs, const DXGI_FORMAT (&rts)[8], UINT num_rts, DXGI_FORMAT dsv, UINT samples)
	{
		ID3D12RootSignature *root = nullptr;
		{
			const std::unique_lock<std::shared_mutex> lock(s_geo_mutex);
			if (const auto it = s_so_roots.find(info.root); it != s_so_roots.end())
				root = it->second;
			else
			{
				const std::shared_ptr<saved_layout> layout = find_layout(info.root);
				root = layout != nullptr ? create_so_root_signature(d, *layout) : nullptr;
				s_so_roots[info.root] = root;
				log(root != nullptr ? reshade::log::level::info : reshade::log::level::error, "TLOU RT: stream-out copy of the prepass root signature %p %s",
					reinterpret_cast<void *>(info.root), root != nullptr ? "created" : "could not be created");
			}
		}
		if (root == nullptr)
			return;
		// v30: an alpha-tested draw's clone also writes the mask's coordinates (2 floats) to slot 1
		const D3D12_SO_DECLARATION_ENTRY entries[2] = { { 0, "SV_Position", 0, 0, 3, 0 }, { 0, "TEXCOORD", info.uv_index, 0, 2, 1 } };
		const UINT strides[2] = { static_cast<UINT>(k_vertex_bytes), 8 };
		D3D12_GRAPHICS_PIPELINE_STATE_DESC desc = {};
		desc.pRootSignature = root;
		desc.VS = { vs.code, vs.code_size };
		desc.StreamOutput = { entries, info.alpha ? 2u : 1u, strides, info.alpha ? 2u : 1u, D3D12_SO_NO_RASTERIZED_STREAM };
		desc.BlendState.RenderTarget[0].RenderTargetWriteMask = 0;
		desc.SampleMask = UINT_MAX;
		desc.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
		desc.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
		desc.RasterizerState.DepthClipEnable = TRUE;
		desc.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
		desc.NumRenderTargets = num_rts;
		std::copy_n(rts, 8, desc.RTVFormats);
		desc.DSVFormat = dsv;
		desc.SampleDesc.Count = samples;
		HRESULT hr = d->CreateGraphicsPipelineState(&desc, IID_PPV_ARGS(&info.clone));
		if (FAILED(hr) && info.alpha)
		{
			// v30: the vertex shader does not write those coordinates: the positions alone (the card's fixed transmission)
			if (s_alpha_clone_failed.fetch_add(1) == 0)
				log(reshade::log::level::info, "TLOU RT v%d: a cut-out's vertex shader does not write TEXCOORD%u: its rays use the fixed transmission", TLOU_RT_VERSION, info.uv_index);
			info.alpha = false;
			desc.StreamOutput = { entries, 1, strides, 1, D3D12_SO_NO_RASTERIZED_STREAM };
			hr = d->CreateGraphicsPipelineState(&desc, IID_PPV_ARGS(&info.clone));
		}
		if (FAILED(hr))
		{
			info.clone = nullptr;
			if (s_clones_failed.fetch_add(1) == 0)
				log(reshade::log::level::error, "TLOU RT: creating a stream-out clone of a prepass pipeline failed (0x%08X)", static_cast<unsigned>(hr));
			return;
		}
		info.so_root = root;
		s_clones.fetch_add(1);
	}

	void on_init_pipeline(device *dev, pipeline_layout layout, uint32_t count, const pipeline_subobject *subobjects, pipeline pipe)
	{
		if (pipe == 0 || layout == 0)
			return;
		const shader_desc *cs = nullptr, *vs = nullptr, *ps = nullptr;
		const format *rts = nullptr;
		uint32_t rt_count = 0, samples = 1;
		format dsv = format::unknown;
		for (uint32_t i = 0; i < count; ++i)
		{
			const pipeline_subobject &so = subobjects[i];
			if (so.data == nullptr || so.count == 0)
				continue;
			const shader_desc *const sd = static_cast<const shader_desc *>(so.data);
			switch (so.type)
			{
			case pipeline_subobject_type::compute_shader: if (sd->code != nullptr && sd->code_size != 0) cs = sd; break;
			case pipeline_subobject_type::vertex_shader: if (sd->code != nullptr && sd->code_size != 0) vs = sd; break;
			case pipeline_subobject_type::pixel_shader: if (sd->code != nullptr && sd->code_size != 0) ps = sd; break;
			case pipeline_subobject_type::render_target_formats: rts = static_cast<const format *>(so.data); rt_count = std::min(so.count, 8u); break;
			case pipeline_subobject_type::depth_stencil_format: dsv = *static_cast<const format *>(so.data); break;
			case pipeline_subobject_type::sample_count: samples = *static_cast<const uint32_t *>(so.data); break;
			default: break;
			}
		}

		// The visibility prepass: the only render target is RG32_UINT (MainPsDepthOnly*, MainVsDepthOnly)
		if (vs != nullptr && rt_count == 1 && rts[0] == format::r32g32_uint && (ps == nullptr || contains(ps, "MainPsDepthOnly") || contains(ps, "HairAlphaDepthOnly")))
		{
			ID3D12Device *const d = reinterpret_cast<ID3D12Device *>(dev->get_native());
			if (!rt_supported(d))
				return;
			auto info = std::make_unique<prepass_info>();
			info->root = layout.handle;
			info->hair = ps != nullptr && (contains(ps, "HairDither") || contains(ps, "HairAlpha"));   // hair strands
			// v54: the custom-depth passes (MainPsDepthOnlyCustomDepth*: parallax relief - snow ruts, decals - 41 shaders writing
			// SV_DepthGreaterEqual, 39 without a discard) are solid: the texture they sample is a height map, which v30-v53 took
			// for the mask and the rays blocked the light in its pattern (black lines along tyre tracks, black shapes by litter)
			const bool custom_depth = ps != nullptr && contains(ps, "CustomDepth");
			info->cutout = ps != nullptr && !info->hair && !custom_depth && binds_sampler(ps);   // v22: alpha-tested cards
			if (custom_depth)
				s_custom_depth_pipelines.fetch_add(1);
			// v30: the mask the depth pass tests, and where its table is in the root signature
			if ((info->cutout || info->hair) && alpha_inputs(ps, info->uv_index, info->alpha_space, info->alpha_reg))
				if (const std::shared_ptr<saved_layout> saved = find_layout(layout.handle); saved != nullptr)
					for (uint32_t pi = 0; pi < saved->params.size() && pi < 64 && info->alpha_param == UINT32_MAX; ++pi)
					{
						const pipeline_layout_param &param = saved->params[pi];
						const bool with_flags = param.type == pipeline_layout_param_type::descriptor_table_with_flags;
						if (param.type != pipeline_layout_param_type::descriptor_table && !with_flags)
							continue;
						const uint32_t ranges = with_flags ? param.descriptor_table_with_flags.count : param.descriptor_table.count;
						uint32_t next = 0;
						for (uint32_t r = 0; r < ranges; ++r)
						{
							const descriptor_range &range = with_flags ? static_cast<const descriptor_range &>(param.descriptor_table_with_flags.ranges[r]) : param.descriptor_table.ranges[r];
							const uint32_t base = range.binding == UINT32_MAX ? next : range.binding;
							next = base + range.count;
							const bool srv = range.type == descriptor_type::shader_resource_view || range.type == descriptor_type::texture_shader_resource_view;
							if (srv && range.dx_register_space == info->alpha_space && info->alpha_reg >= range.dx_register_index && info->alpha_reg - range.dx_register_index < range.count)
							{
								info->alpha_param = pi;
								info->alpha_offset = base + (info->alpha_reg - range.dx_register_index);
								info->alpha = true;
								s_alpha_pipelines.fetch_add(1);
								break;
							}
						}
					}
			DXGI_FORMAT formats[8] = {};
			for (uint32_t i = 0; i < rt_count; ++i)
				formats[i] = static_cast<DXGI_FORMAT>(rts[i]);
			create_clone(d, *info, *vs, formats, rt_count, static_cast<DXGI_FORMAT>(dsv), std::max(samples, 1u));
			const std::unique_lock<std::shared_mutex> lock(s_geo_mutex);
			s_prepass[pipe.handle] = std::move(info);
			return;
		}

		if (cs != nullptr && contains(cs, "Cs_SpecularIbl"))
		{
			const std::unique_lock<std::shared_mutex> lock(s_mutex);
			s_ibl[pipe.handle] = layout.handle;
			s_ibl_layout = layout.handle;
			return;
		}
		if (cs != nullptr && contains(cs, "CS_ApplyFogDirectlyToFullRes"))
		{
			const std::unique_lock<std::shared_mutex> lock(s_mutex);   // v50: the forward relight runs before it
			s_fog[pipe.handle] = layout.handle;
			return;
		}
		if (cs == nullptr || !contains(cs, "CS_DeferredLighting"))
			return;
		const std::unique_lock<std::shared_mutex> lock(s_mutex);
		s_device = dev;
		s_lighting[pipe.handle] = layout.handle;
		if (s_inject.find(layout.handle) == s_inject.end())
			s_inject[layout.handle] = build_inject_set(dev, layout.handle, s_ibl_layout.load());
	}

	// The game releases a pipeline only once the GPU is done with it, and the clone is used in the same lists only
	void on_destroy_pipeline(device *, pipeline pipe)
	{
		{
			const std::unique_lock<std::shared_mutex> lock(s_mutex);
			s_lighting.erase(pipe.handle);
			s_ibl.erase(pipe.handle);
			s_fog.erase(pipe.handle);
		}
		const std::unique_lock<std::shared_mutex> lock(s_geo_mutex);
		if (const auto it = s_prepass.find(pipe.handle); it != s_prepass.end())
		{
			if (it->second->clone != nullptr)
				it->second->clone->Release();
			s_prepass.erase(it);
		}
	}

	// ---- recording ----

	void on_bind_pipeline(command_list *cmd, pipeline_stage, pipeline pipe)
	{
		uint64_t root = 0, ibl = 0;
		bool fog = false;
		{
			const std::shared_lock<std::shared_mutex> lock(s_mutex);
			if (const auto it = s_lighting.find(pipe.handle); it != s_lighting.end())
				root = it->second;
			else if (const auto ib = s_ibl.find(pipe.handle); ib != s_ibl.end())
				ibl = ib->second;
			else
				fog = s_fog.find(pipe.handle) != s_fog.end();
		}
		list_state &s = state_of(cmd);
		s.pipe = pipe.handle;
		s.pipe_root = root;
		s.pipe_ibl = ibl;
		s.pipe_fog = fog;
		s.is_prepass = false;
		if (!s_streaming.load(std::memory_order_relaxed))
			return;
		const std::shared_lock<std::shared_mutex> lock(s_geo_mutex);
		if (const auto it = s_prepass.find(pipe.handle); it != s_prepass.end())
		{
			s.prepass = *it->second;
			s.is_prepass = true;
		}
	}

	void on_reset_command_list(command_list *cmd)
	{
		state_of(cmd).reset();
	}

	void pre_lighting(command_list *cmd, list_state &s);   // the add-on's passes before the game's lighting (injection section)
	void relight(command_list *cmd, list_state &s);        // v50: the forward relight before the game's fog (injection section)
	// v30: whether the cut-outs' masks can be read on this list: their heap (s_alpha_heap) is the one the lighting's tables are
	// in (the game binds one CBV/SRV/UAV heap); s.alpha_gpu = its GPU start, else 0 (g_alpha_on 0: the fixed transmission)
	std::atomic<uint32_t> s_alpha_lists_ok { 0 }, s_alpha_lists_other { 0 }, s_alpha_lists_none { 0 };   // v31
	bool alpha_heap(device *dev, list_state &s)
	{
		s.alpha_gpu = 0;
		const uint64_t heap = s_alpha_heap.load(std::memory_order_relaxed);
		if (heap == 0 || s.table_mask == 0)
		{
			s_alpha_lists_none.fetch_add(1, std::memory_order_relaxed);
			return false;
		}
		uint32_t p = 0;
		while (((s.table_mask >> p) & 1) == 0)
			++p;
		descriptor_heap lighting = {};
		uint32_t slot = 0;
		dev->get_descriptor_heap_offset(descriptor_table { s.tables[p] }, 0, 0, &lighting, &slot);
		if (lighting.handle != heap)
		{
			s_alpha_lists_other.fetch_add(1, std::memory_order_relaxed);
			return false;
		}
		s.alpha_gpu = reinterpret_cast<ID3D12DescriptorHeap *>(heap)->GetGPUDescriptorHandleForHeapStart().ptr;
		s_alpha_lists_ok.fetch_add(1, std::memory_order_relaxed);
		return s.alpha_gpu != 0;
	}
	void note_state(uint64_t resource, uint32_t state);    // barrier states per resource (descriptor section)
	bool switch_off_game_lights(device *dev, list_state &s); // v18 (descriptor section)

	// The first lighting dispatch of a list runs the add-on's passes first (the game's lighting state is bound by then); a
	// later lighting dispatch with another descriptor table gets its light loop switched off too
	void before_dispatch(command_list *cmd, list_state &s)
	{
		if (s.pipe_fog)
			relight(cmd, s);                               // v50
		if (s.pipe_ibl != 0 && s.args_layout == s.pipe_ibl)
		{
			// v19: the environment probes' root arguments (Cs_SpecularIbl's dispatch), for the add-on's rays
			const std::lock_guard<std::mutex> lock(s_ibl_mutex);
			ibl_args &a = s_ibl_args;
			a.present = s_present_index.load();
			a.layout = s.args_layout;
			a.table_mask = s.table_mask;
			a.root_mask = s.root_mask;
			a.const_mask = s.c_const_mask;
			std::memcpy(a.tables, s.tables, sizeof(a.tables));
			std::memcpy(a.root_va, s.root_va, sizeof(a.root_va));
			std::memcpy(a.root_type, s.root_type, sizeof(a.root_type));
			std::memcpy(a.const_count, s.c_const_count, sizeof(a.const_count));
			std::memcpy(a.consts, s.c_consts, sizeof(a.consts));
		}
		if (s.pipe_root == 0)
			return;
		if (!s.pre)
		{
			s.pre = true;
			pre_lighting(cmd, s);
		}
		else if (s.lights_off && s.counts_param < 64 && (s.table_mask & (1ull << s.counts_param)) != 0 && s.tables[s.counts_param] != s.counts_table)
			switch_off_game_lights(cmd->get_device(), s);
	}

	void note_dispatch(list_state &s)
	{
		if (s.pipe_root != 0)
		{
			s.inject = true;
			s.inject_root = s.pipe_root;
			s.dirty = false;
		}
		else if (s.inject)
			s.dirty = true;
	}

	inline void note_other(list_state &s)
	{
		if (s.inject)
			s.dirty = true;
	}

	void rebind_graphics(ID3D12GraphicsCommandList *cl, const list_state &s)
	{
		for (uint32_t i = 0; i < 64; ++i)
		{
			const uint64_t bit = 1ull << i;
			if (s.g_table_mask & bit)
				cl->SetGraphicsRootDescriptorTable(i, D3D12_GPU_DESCRIPTOR_HANDLE { s.g_tables[i] });
			if (s.g_root_mask & bit)
			{
				if (s.g_root_type[i] == 0)
					cl->SetGraphicsRootConstantBufferView(i, s.g_root_va[i]);
				else if (s.g_root_type[i] == 1)
					cl->SetGraphicsRootShaderResourceView(i, s.g_root_va[i]);
				else
					cl->SetGraphicsRootUnorderedAccessView(i, s.g_root_va[i]);
			}
			if (s.g_const_mask & bit)
				cl->SetGraphicsRoot32BitConstants(i, s.g_const_count[i], s.g_consts[i], 0);
		}
	}

	heap_info *heap_by_original(uint64_t orig_heap);       // descriptor section
	// v37: the identity of the texture in a slot of the game's shader-visible heap: the staging descriptor last copied into
	// it (or the slot itself when a view was written in place), hashed to 32 bits, never 0 (0: unknown)
	uint32_t mask_source(uint64_t orig_heap, uint32_t slot)
	{
		thread_local uint64_t t_heap = 0;
		thread_local heap_info *t_info = nullptr;
		if (t_heap != orig_heap || t_info == nullptr)
		{
			t_info = heap_by_original(orig_heap);
			t_heap = orig_heap;
			if (t_info == nullptr)
				return 0;
		}
		const uint64_t *const slots = t_info->slots.load(std::memory_order_acquire);
		if (slots == nullptr || slot >= t_info->count)
			return 0;
		const uint64_t r = slots[slot];
		if ((r >> 63) == 0)
			return 0;
		return static_cast<uint32_t>(splitmix(r & 0x0000FFFFFFFFFFFFull)) | 1u;
	}

	// Inserts the stream-out version of the prepass draw that is about to be recorded (state as the game set it)
	void stream_out(command_list *cmd, list_state &s, bool indexed, uint32_t count, uint32_t instances, uint32_t first, int32_t vertex_offset, uint32_t first_instance)
	{
		if (!s_streaming.load(std::memory_order_relaxed) || !s.is_prepass)
			return;
		const prepass_info &info = s.prepass;
		if (info.clone == nullptr || info.so_root == nullptr)
			return void(s_skip_clone.fetch_add(1));
		if (s.g_layout != info.root)
			return void(s_skip_args.fetch_add(1));
		ID3D12Resource *const geo = s_geo.load();
		const UINT64 vertices = UINT64(count) * instances;     // triangle lists: one output vertex per index / vertex, per instance
		if (geo == nullptr || vertices == 0 || vertices % 3 != 0)
			return;
		// the mesh: index buffer + draw arguments (same key = same triangles in the same order, see the BLAS cache)
		const uint64_t ib = indexed && s.ib ? s.ib_va : 0;
		uint64_t key = splitmix(ib ^ (indexed ? 1ull : 0ull));
		key = splitmix(key ^ (uint64_t(count) | uint64_t(instances) << 32));
		key = splitmix(key ^ (uint64_t(first) | uint64_t(static_cast<uint32_t>(vertex_offset)) << 32));
		key = splitmix(key ^ uint64_t(first_instance));
		const UINT64 bytes = vertices * k_vertex_bytes;
		// v34: counted per target size; a draw into another size than the main view's is not the frame's scene
		{
			const std::lock_guard<std::mutex> lock(s_epoch_mutex);
			uint32_t k = 0;
			while (k < s_view_hist_n && s_view_hist[k].view != s.view)
				++k;
			if (k == s_view_hist_n && k < std::size(s_view_hist))
				s_view_hist[s_view_hist_n++] = { s.view, 0 };
			if (k < s_view_hist_n)
				++s_view_hist[k].draws;
		}
		const uint32_t main_view = s_main_view.load(std::memory_order_relaxed);
		if (main_view != 0 && s.view != 0 && s.view != main_view)
		{
			s_skip_view.fetch_add(1, std::memory_order_relaxed);
			s_skip_view_size.store(s.view, std::memory_order_relaxed);
			return;
		}
		// v30: the mask's slot in the game's heap (the table bound for this draw), and room for the coordinates
		uint32_t alpha = k_no_uv, source = 0;
		if (info.alpha && info.alpha_param < 64 && (s.g_table_mask & (1ull << info.alpha_param)) != 0)
		{
			descriptor_heap heap = {};
			uint32_t slot = 0;
			cmd->get_device()->get_descriptor_heap_offset(descriptor_table { s.g_tables[info.alpha_param] }, info.alpha_offset, 0, &heap, &slot);
			if (heap.handle != 0)
			{
				alpha = slot;
				source = mask_source(heap.handle, slot);   // v37
				s_alpha_heap.store(heap.handle, std::memory_order_relaxed);
				s_alpha_resolved.fetch_add(1, std::memory_order_relaxed);
			}
		}
		if (info.alpha)
			s_alpha_draws.fetch_add(1, std::memory_order_relaxed);
		UINT64 data, counter, uv = 0;
		{
			const std::lock_guard<std::mutex> lock(s_epoch_mutex);
			const uint32_t region = s_epoch % k_regions;
			const uint32_t slot = static_cast<uint32_t>(s_epoch_draws.size());
			if (s_epoch_bytes + bytes > k_region_bytes || slot >= k_region_draws)
			{
				const uint64_t mine = std::min<UINT64>(vertices, 0xFFFFFFFFull) << 32 | instances;
				uint64_t largest = s_skip_largest.load(std::memory_order_relaxed);
				while (mine > largest && !s_skip_largest.compare_exchange_weak(largest, mine, std::memory_order_relaxed)) {}
				return void(s_skip_space.fetch_add(1));
			}
			data = k_data_base + region * k_region_bytes + s_epoch_bytes;
			counter = region * k_counter_bytes + UINT64(slot) * 16;
			s_epoch_bytes += bytes;
			if (info.alpha)
			{
				if (s_epoch_uv_bytes + vertices * 8 <= k_uv_region_bytes)
				{
					uv = k_uv_base + region * k_uv_region_bytes + s_epoch_uv_bytes;
					s_epoch_uv_bytes += vertices * 8;
				}
				else
					s_alpha_no_uv_space.fetch_add(1, std::memory_order_relaxed);
			}
			s_epoch_draws.push_back({ static_cast<uint32_t>(data), static_cast<uint32_t>(vertices), static_cast<uint32_t>(counter), (info.hair ? 1u : 0u) | (info.cutout ? 4u : 0u), key,
				uv != 0 ? static_cast<uint32_t>(uv) : k_no_uv, uv != 0 ? alpha : k_no_uv, uv != 0 ? source : 0u });
		}
		ID3D12GraphicsCommandList *const cl = reinterpret_cast<ID3D12GraphicsCommandList *>(cmd->get_native());
		const D3D12_GPU_VIRTUAL_ADDRESS va = geo->GetGPUVirtualAddress();
		// slot 1 (v30): the coordinates, or nothing (a null view discards them) when the region is full
		const D3D12_STREAM_OUTPUT_BUFFER_VIEW views[2] = { { va + data, bytes, va + counter },
			uv != 0 ? D3D12_STREAM_OUTPUT_BUFFER_VIEW { va + uv, vertices * 8, va + counter + 8 } : D3D12_STREAM_OUTPUT_BUFFER_VIEW {} };
		const D3D12_STREAM_OUTPUT_BUFFER_VIEW none[2] = {};
		const UINT slots = info.alpha ? 2u : 1u;
		cl->SetGraphicsRootSignature(info.so_root);
		rebind_graphics(cl, s);
		cl->SOSetTargets(0, slots, views);
		cl->SetPipelineState(info.clone);
		if (indexed)
			cl->DrawIndexedInstanced(count, instances, first, vertex_offset, first_instance);
		else
			cl->DrawInstanced(count, instances, first, first_instance);
		cl->SOSetTargets(0, slots, none);
		cl->SetGraphicsRootSignature(reinterpret_cast<ID3D12RootSignature *>(info.root));
		rebind_graphics(cl, s);
		cl->SetPipelineState(reinterpret_cast<ID3D12PipelineState *>(s.pipe));
		s.so = true;
	}

	bool on_dispatch(command_list *cmd, uint32_t, uint32_t, uint32_t)
	{
		list_state &s = state_of(cmd);
		before_dispatch(cmd, s);
		note_dispatch(s);
		return false;
	}
	bool on_indirect(command_list *cmd, indirect_command, resource, uint64_t, uint32_t, uint32_t)
	{
		list_state &s = state_of(cmd);
		before_dispatch(cmd, s);
		note_dispatch(s);
		return false;
	}
	bool on_draw(command_list *cmd, uint32_t vertex_count, uint32_t instance_count, uint32_t first_vertex, uint32_t first_instance)
	{
		list_state &s = state_of(cmd);
		note_other(s);
		if (s.is_prepass)
			stream_out(cmd, s, false, vertex_count, instance_count, first_vertex, 0, first_instance);
		return false;
	}
	bool on_draw_indexed(command_list *cmd, uint32_t index_count, uint32_t instance_count, uint32_t first_index, int32_t vertex_offset, uint32_t first_instance)
	{
		list_state &s = state_of(cmd);
		note_other(s);
		if (s.is_prepass)
			stream_out(cmd, s, true, index_count, instance_count, first_index, vertex_offset, first_instance);
		return false;
	}
	void on_execute_bundle(command_list *cmd, command_list *) { note_other(state_of(cmd)); }

	// v36: the queues the depth-pass lists and the lighting lists are submitted to (cs_late reads one queue's order)
	std::atomic<uint64_t> s_queue_depth { 0 }, s_queue_lighting { 0 };
	std::atomic<uint32_t> s_queue_depth_type { 0 }, s_queue_lighting_type { 0 }, s_queue_depth_changes { 0 };
	void rr_on_execute(ID3D12CommandQueue *queue, uint64_t list);   // v78: Ray Reconstruction (below)
	void note_submission(uint64_t queue, bool lighting);
	void on_execute_command_list(command_queue *queue, command_list *cmd)
	{
		const list_state &s = state_of(cmd);
		// v78: a lighting list that takes RR's output - the game's queue waits for it first (rr_on_execute); the submission
		// layout for the status line
		rr_on_execute(reinterpret_cast<ID3D12CommandQueue *>(queue->get_native()), cmd->get_native());
		note_submission(queue->get_native(), s.pre);
		if (!s.streamed && !s.pre)
			return;
		const uint64_t q = queue->get_native();
		const uint32_t type = static_cast<uint32_t>(queue->get_type());
		if (s.streamed)
		{
			if (s_queue_depth.exchange(q, std::memory_order_relaxed) != q)
				s_queue_depth_changes.fetch_add(1, std::memory_order_relaxed);
			s_queue_depth_type.store(type, std::memory_order_relaxed);
		}
		if (s.pre)
		{
			s_queue_lighting.store(q, std::memory_order_relaxed);
			s_queue_lighting_type.store(type, std::memory_order_relaxed);
		}
	}

	void on_bind_index_buffer(command_list *cmd, resource buffer, uint64_t offset, uint32_t)
	{
		list_state &s = state_of(cmd);
		s.ib = true;
		s.ib_va = buffer != 0 ? reinterpret_cast<ID3D12Resource *>(buffer.handle)->GetGPUVirtualAddress() + offset : 0;
	}

	// A texture changing state after the lighting could be the light buffer leaving the UAV state: no injection then.
	// Buffer transitions (tile lists, indirect arguments) and UAV barriers (no state change) are fine.
	void on_barrier(command_list *cmd, uint32_t count, const resource *resources, const resource_usage *old_states, const resource_usage *new_states)
	{
		// every resource's state after its last barrier (the copies into the lighting's inputs start from there)
		for (uint32_t i = 0; i < count; ++i)
			if (resources[i] != 0)
				note_state(resources[i].handle, (static_cast<uint32_t>(new_states[i]) & 0x80000000u) != 0 ? 0u : static_cast<uint32_t>(new_states[i]));
		list_state &s = state_of(cmd);
		if (!s.inject)
			return;
		device *const dev = cmd->get_device();
		for (uint32_t i = 0; i < count; ++i)
			if (old_states[i] != new_states[i] && (resources[i] == 0 || dev->get_resource_desc(resources[i]).type != resource_type::buffer))
				s.dirty = true;
	}

	// Root arguments recorded on this list for its current root signature (from the list's start, so the set is complete when
	// streaming switches on in the middle of a list): compute ones are re-bound around the add-on's passes, graphics ones
	// around the stream-out draws
	void track_args(list_state &s, shader_stage stages, pipeline_layout layout)
	{
		if (is_compute(stages))
		{
			if (s.inject && layout.handle != s.inject_root)
				s.dirty = true;                            // another compute root signature after the lighting
			if (s.args_layout != layout.handle)
			{
				s.args_layout = layout.handle;
				s.table_mask = 0;
				s.root_mask = 0;
				s.c_const_mask = 0;
			}
		}
		else if (s.g_layout != layout.handle)
		{
			s.g_layout = layout.handle;
			s.g_table_mask = 0;
			s.g_root_mask = 0;
			s.g_const_mask = 0;
		}
	}

	void on_bind_descriptor_tables(command_list *cmd, shader_stage stages, pipeline_layout layout, uint32_t first, uint32_t count, const descriptor_table *tables, uint32_t, const uint32_t *)
	{
		const bool compute = is_compute(stages);
		list_state &s = state_of(cmd);
		track_args(s, stages, layout);
		for (uint32_t i = 0; i < count && first + i < 64; ++i)
		{
			(compute ? s.tables : s.g_tables)[first + i] = tables[i].handle;
			(compute ? s.table_mask : s.g_table_mask) |= 1ull << (first + i);
		}
	}

	void on_push_descriptors(command_list *cmd, shader_stage stages, pipeline_layout layout, uint32_t param, const descriptor_table_update &update)
	{
		const bool compute = is_compute(stages);
		list_state &s = state_of(cmd);
		track_args(s, stages, layout);
		if (param >= 64 || update.count == 0 || update.descriptors == nullptr)
			return;
		// ReShade 6.8 (d3d12_command_list.cpp): a root CBV arrives as a buffer_range (resolved from the GPU address), but a
		// root SRV / UAV / acceleration structure as a pointer to the raw D3D12_GPU_VIRTUAL_ADDRESS (v2 read that as a
		// buffer_range and dereferenced the address as a resource: access violation)
		uint64_t va = 0;
		uint8_t type;
		switch (update.type)
		{
		case descriptor_type::constant_buffer:
		{
			const buffer_range &range = static_cast<const buffer_range *>(update.descriptors)[0];
			ID3D12Resource *const buffer = reinterpret_cast<ID3D12Resource *>(range.buffer.handle);
			if (buffer == nullptr)
				return;
			va = buffer->GetGPUVirtualAddress() + range.offset;
			type = 0;
			break;
		}
		case descriptor_type::buffer_shader_resource_view:
		case descriptor_type::acceleration_structure:
			va = *static_cast<const uint64_t *>(update.descriptors);
			type = 1;
			break;
		case descriptor_type::buffer_unordered_access_view:
			va = *static_cast<const uint64_t *>(update.descriptors);
			type = 2;
			break;
		default:
			return;
		}
		if (va == 0)
			return;
		(compute ? s.root_va : s.g_root_va)[param] = va;
		(compute ? s.root_type : s.g_root_type)[param] = type;
		(compute ? s.root_mask : s.g_root_mask) |= 1ull << param;
	}

	void on_push_constants(command_list *cmd, shader_stage stages, pipeline_layout layout, uint32_t param, uint32_t first, uint32_t count, const void *values)
	{
		const bool compute = is_compute(stages);
		list_state &s = state_of(cmd);
		track_args(s, stages, layout);
		if (param >= 64 || values == nullptr || first >= 32 || count > 32 - first)
			return;
		// compute: restored after the add-on's passes before the game's lighting; graphics: re-bound around stream-out draws
		uint64_t &mask = compute ? s.c_const_mask : s.g_const_mask;
		uint32_t &n = (compute ? s.c_const_count : s.g_const_count)[param];
		std::memcpy((compute ? s.c_consts : s.g_consts)[param] + first, values, count * sizeof(uint32_t));
		if ((mask & (1ull << param)) == 0)
			n = 0;
		n = std::max(n, first + count);
		mask |= 1ull << param;
	}

	// Render resolution from the G-buffer pass (7 render targets, the first RGBA16_UINT); its targets 4 / 5 are the ambient's
	// fallback when the lighting's descriptors cannot be followed (the first frames)
	void on_bind_render_targets(command_list *cmd, uint32_t count, const resource_view *rtvs, resource_view dsv)
	{
		{
			// v34: the size of what the list draws into (a depth-pass draw joins the scene only at the main view's size)
			list_state &s = state_of(cmd);
			s.view = 0;
			const resource_view v = count != 0 && rtvs[0] != 0 ? rtvs[0] : dsv;
			if (v != 0)
				if (const resource r = cmd->get_device()->get_resource_from_view(v); r != 0)
				{
					const resource_desc rd = cmd->get_device()->get_resource_desc(r);
					s.view = std::min(rd.texture.width, 0xFFFFu) << 16 | std::min(rd.texture.height, 0xFFFFu);
				}
		}
		if (count != 7 || rtvs[0] == 0)
			return;
		device *const dev = cmd->get_device();
		if (dev->get_resource_view_desc(rtvs[0]).format != format::r16g16b16a16_uint)
			return;
		const resource res = dev->get_resource_from_view(rtvs[0]);
		if (res == 0)
			return;
		const resource_desc desc = dev->get_resource_desc(res);
		s_width.store(desc.texture.width);
		s_height.store(desc.texture.height);
		for (uint32_t i = 0; i < 7; ++i)
			s_gbuffer_res[i] = rtvs[i] != 0 ? dev->get_resource_from_view(rtvs[i]).handle : 0;
		s_gbuffer_res[7] = dsv != 0 ? dev->get_resource_from_view(dsv).handle : 0;
	}

	// G-buffer targets the game destroys (a level load can recreate them) are forgotten until its next G-buffer pass, and
	// destroyed textures leave the live set
	void on_destroy_resource(device *, resource res)
	{
		if (res.handle == 0)
			return;
		{
			const std::unique_lock<std::shared_mutex> lock(s_textures_mutex);
			s_textures.erase(res.handle);
			s_buffers.erase(res.handle);
		}
		for (std::atomic<uint64_t> &h : s_gbuffer_res)
		{
			uint64_t expected = res.handle;
			h.compare_exchange_strong(expected, 0);
		}
	}

	// ---- descriptor copies and the lighting's inputs per frame (v16) ----

	// The add-on's record of a descriptor heap (ReShade's heap index, from an encoded handle), made on its first copy:
	// size, increment and the original heap's CPU start; a slot table once it is the destination of a copy
	heap_info *heap_of(device *dev, uint64_t table, bool destination)
	{
		const uint32_t index = static_cast<uint32_t>(table >> 28) & 0xFFFFFFFu;
		if (index >= k_max_heaps)
			return nullptr;
		heap_info &h = s_heaps[index];
		if (!h.ready.load(std::memory_order_acquire))
		{
			const std::lock_guard<std::mutex> lock(s_heap_mutex);
			if (!h.ready.load(std::memory_order_relaxed))
			{
				descriptor_heap heap = {};
				dev->get_descriptor_heap_offset(descriptor_table { table }, 0, 0, &heap, nullptr);
				ID3D12DescriptorHeap *const native = reinterpret_cast<ID3D12DescriptorHeap *>(heap.handle);
				if (native == nullptr)
					return nullptr;
				const D3D12_DESCRIPTOR_HEAP_DESC desc = native->GetDesc();
				h.count = desc.NumDescriptors;
				h.increment = reinterpret_cast<ID3D12Device *>(dev->get_native())->GetDescriptorHandleIncrementSize(desc.Type);
				h.orig_cpu = native->GetCPUDescriptorHandleForHeapStart().ptr;
				h.orig_heap = heap.handle;
				s_heap_list.push_back(index);
				h.ready.store(true, std::memory_order_release);
			}
		}
		if (destination && h.slots.load(std::memory_order_acquire) == nullptr)
		{
			const std::lock_guard<std::mutex> lock(s_heap_mutex);
			if (h.slots.load(std::memory_order_relaxed) == nullptr && h.count != 0)
				h.slots.store(new uint64_t[h.count](), std::memory_order_release);
		}
		return h.increment != 0 ? &h : nullptr;
	}

	// Every copy between CBV/SRV/UAV descriptors, recorded per destination slot (its source's heap index and slot): a few
	// bit operations per copy, no ReShade calls (ReShade 6.8's encoded CPU handles, see heap_info above)
	bool on_copy_descriptor_tables(device *dev, uint32_t count, const descriptor_table_copy *copies)
	{
		const bool timed = ++t_copy_events == k_timing_period;
		LARGE_INTEGER start = {}, end = {};
		if (timed)
			QueryPerformanceCounter(&start);
		const uint32_t present = s_present_index.load(std::memory_order_relaxed);
		uint64_t descriptors = 0;
		for (uint32_t i = 0; i < count; ++i)
		{
			const descriptor_table_copy &c = copies[i];
			const uint64_t dst = c.dest_table.handle, src = c.source_table.handle;
			if ((dst >> 60) != 0xF || (src >> 60) != 0xF || (dst & 3) != D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV || c.count == 0)
				continue;                                  // CPU descriptors of CBV/SRV/UAV heaps only
			heap_info *const hd = heap_of(dev, dst, true);
			heap_info *const hs = heap_of(dev, src, false);
			if (hd == nullptr || hs == nullptr)
				continue;
			uint64_t *const slots = hd->slots.load(std::memory_order_acquire);
			if (slots == nullptr)
				continue;
			const uint32_t d0 = static_cast<uint32_t>((dst & 0x0FFFFFF8ull) / hd->increment) + c.dest_binding + c.dest_array_offset;
			const uint32_t s0 = static_cast<uint32_t>((src & 0x0FFFFFF8ull) / hs->increment) + c.source_binding + c.source_array_offset;
			const uint64_t source = record_of(present, static_cast<uint32_t>(src >> 28) & 0xFFFFFFFu, 0);
			for (uint32_t k = 0; k < c.count && d0 + k < hd->count; ++k)
				slots[d0 + k] = source | (s0 + k);
			descriptors += c.count;
		}
		t_copy_descriptors += descriptors;
		if (timed)
		{
			QueryPerformanceCounter(&end);
			s_copy_calls.fetch_add(k_timing_period, std::memory_order_relaxed);
			s_copy_descriptors.fetch_add(t_copy_descriptors, std::memory_order_relaxed);
			s_copy_ticks.fetch_add((end.QuadPart - start.QuadPart) * k_timing_period, std::memory_order_relaxed);
			t_copy_events = 0;
			t_copy_descriptors = 0;
		}
		return false;
	}

	// Views written in place into a CBV/SRV/UAV heap (CreateShaderResourceView ...): the slot's record names itself
	bool on_update_descriptor_tables(device *dev, uint32_t count, const descriptor_table_update *updates)
	{
		const bool timed = ++t_update_events == k_timing_period;
		LARGE_INTEGER start = {}, end = {};
		if (timed)
			QueryPerformanceCounter(&start);
		const uint32_t present = s_present_index.load(std::memory_order_relaxed);
		for (uint32_t i = 0; i < count; ++i)
		{
			const descriptor_table_update &u = updates[i];
			const uint64_t dst = u.table.handle;
			if ((dst >> 60) != 0xF || (dst & 3) != D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV || u.count == 0)
				continue;
			heap_info *const h = heap_of(dev, dst, true);
			if (h == nullptr)
				continue;
			uint64_t *const slots = h->slots.load(std::memory_order_acquire);
			if (slots == nullptr)
				continue;
			const uint32_t heap = static_cast<uint32_t>(dst >> 28) & 0xFFFFFFFu;
			const uint32_t d0 = static_cast<uint32_t>((dst & 0x0FFFFFF8ull) / h->increment) + u.binding + u.array_offset;
			for (uint32_t k = 0; k < u.count && d0 + k < h->count; ++k)
				slots[d0 + k] = record_of(present, heap, d0 + k);
		}
		if (timed)
		{
			QueryPerformanceCounter(&end);
			s_update_calls.fetch_add(k_timing_period, std::memory_order_relaxed);
			s_copy_ticks.fetch_add((end.QuadPart - start.QuadPart) * k_timing_period, std::memory_order_relaxed);
			t_update_events = 0;
		}
		return false;
	}

	void on_init_resource(device *, const resource_desc &desc, const subresource_data *, resource_usage, resource res)
	{
		if (res == 0)
			return;
		if (desc.type == resource_type::buffer)
		{
			if ((static_cast<uint32_t>(desc.usage) & static_cast<uint32_t>(resource_usage::unordered_access)) == 0)
				return;
			const std::unique_lock<std::shared_mutex> lock(s_textures_mutex);
			s_buffers[res.handle] = desc.buffer.size;
			return;
		}
		if (desc.type != resource_type::texture_2d)
			return;
		const format f = desc.texture.format;
		if (f != format::r11g11b10_float && f != format::r8g8b8a8_unorm && f != format::r8g8b8a8_typeless)
			return;
		const std::unique_lock<std::shared_mutex> lock(s_textures_mutex);
		s_textures[res.handle] = { desc.texture.width, desc.texture.height, f };
	}

	bool live_texture(uint64_t res, texture_info &info)
	{
		const std::shared_lock<std::shared_mutex> lock(s_textures_mutex);
		const auto it = s_textures.find(res);
		if (it == s_textures.end())
			return false;
		info = it->second;
		return true;
	}

	bool live_buffer(uint64_t res, uint64_t &bytes)
	{
		const std::shared_lock<std::shared_mutex> lock(s_textures_mutex);
		const auto it = s_buffers.find(res);
		if (it == s_buffers.end())
			return false;
		bytes = it->second;
		return true;
	}

	// The record of the heap a GPU descriptor table lives in (the lighting's tables are GPU handles: ReShade names the
	// original heap)
	heap_info *heap_by_original(uint64_t orig_heap)
	{
		const std::lock_guard<std::mutex> lock(s_heap_mutex);
		for (const uint32_t index : s_heap_list)
			if (s_heaps[index].orig_heap == orig_heap)
				return &s_heaps[index];
		return nullptr;
	}

	// What register t<reg> (space 0) of the lighting's descriptor tables names this frame
	struct resolved_view
	{
		uint64_t resource = 0;                             // the live resource
		uint64_t view = 0;                                 // the view ReShade registered (in place, or the copy's source)
		uint64_t slot_cpu = 0;                             // the table's own descriptor: original CPU address in the shader-visible heap
		uint32_t param = 0;                                // the table's root parameter
		texture_info texture = {};
		uint64_t buffer_bytes = 0;
	};

	// The live texture (or, v18, live UAV buffer) behind register t<reg> (space 0) of the lighting's descriptor tables
	// recorded on this list, this frame: the slot's record (written in the last two presents) names a view ReShade
	// registered, in place or the copy's source (followed up to three copies deep); false when anything is not certain
	bool resolve_lighting_srv(device *dev, const list_state &s, uint32_t reg, bool buffer, resolved_view &out, bool uav = false)
	{
		out = resolved_view();
		const std::shared_ptr<saved_layout> layout = find_layout(s.args_layout);
		if (layout == nullptr)
			return false;
		for (uint32_t p = 0; p < layout->params.size() && p < 64; ++p)
		{
			const pipeline_layout_param &param = layout->params[p];
			const bool with_flags = param.type == pipeline_layout_param_type::descriptor_table_with_flags;
			if ((param.type != pipeline_layout_param_type::descriptor_table && !with_flags) || (s.table_mask & (1ull << p)) == 0)
				continue;
			const uint32_t ranges = with_flags ? param.descriptor_table_with_flags.count : param.descriptor_table.count;
			uint32_t next = 0;                                 // D3D12_DESCRIPTOR_RANGE_OFFSET_APPEND: right after the previous range
			for (uint32_t r = 0; r < ranges; ++r)
			{
				const descriptor_range &range = with_flags ? static_cast<const descriptor_range &>(param.descriptor_table_with_flags.ranges[r]) : param.descriptor_table.ranges[r];
				const uint32_t base = range.binding == UINT32_MAX ? next : range.binding;
				next = base + range.count;
				const bool srv = uav ? (range.type == descriptor_type::unordered_access_view || range.type == descriptor_type::buffer_unordered_access_view) :
					(range.type == descriptor_type::shader_resource_view || range.type == descriptor_type::texture_shader_resource_view ||
					range.type == descriptor_type::buffer_shader_resource_view);   // v50: or u<reg> (the fog's light buffer)
				if (!srv || range.dx_register_space != 0 || reg < range.dx_register_index || reg - range.dx_register_index >= range.count)
					continue;
				descriptor_heap heap = {};
				uint32_t slot = 0;
				dev->get_descriptor_heap_offset(descriptor_table { s.tables[p] }, base + (reg - range.dx_register_index), 0, &heap, &slot);
				const heap_info *h = heap_by_original(heap.handle);
				if (h == nullptr || slot >= h->count)
					return false;
				out.slot_cpu = h->orig_cpu + static_cast<uint64_t>(slot) * h->increment;
				out.param = p;
				const uint32_t present = s_present_index.load(std::memory_order_relaxed);
				for (int depth = 0; h != nullptr && depth < 4 && slot < h->count; ++depth)
				{
					const uint64_t *const slots = h->slots.load(std::memory_order_acquire);
					const uint64_t record = slots != nullptr ? slots[slot] : 0;
					if ((record >> 63) == 0 || (depth == 0 && ((present - static_cast<uint32_t>(record >> 48)) & 0x3FFFu) > 2))
						return false;                          // never written, or not this frame: not certain
					const uint32_t index = static_cast<uint32_t>(record >> 32) & 0xFFFFu, source = static_cast<uint32_t>(record);
					if (index >= k_max_heaps || !s_heaps[index].ready.load(std::memory_order_acquire))
						return false;
					const heap_info *const hs = &s_heaps[index];
					// a view ReShade registered at the source's original descriptor, if it is a live candidate resource
					const resource_view view { hs->orig_cpu + static_cast<uint64_t>(source) * hs->increment };
					const resource res = dev->get_resource_from_view(view);
					if (res != 0 && (buffer ? live_buffer(res.handle, out.buffer_bytes) : live_texture(res.handle, out.texture)))
					{
						out.resource = res.handle;
						out.view = view.handle;
						return true;
					}
					if (hs == h && source == slot)
						return false;                          // written in place, not a candidate
					h = hs;
					slot = source;
				}
				return false;
			}
		}
		return false;
	}

	// v18: the zero count buffer and its descriptor (s_rt_mutex held)
	bool ensure_zero_counts(ID3D12Device *d)
	{
		if (s_zero_heap != nullptr)
			return true;
		ID3D12Resource *const zeros = create_buffer(d, UINT64(k_zero_counts) * 4, D3D12_HEAP_TYPE_DEFAULT, D3D12_RESOURCE_FLAG_NONE, D3D12_RESOURCE_STATE_COMMON);
		D3D12_DESCRIPTOR_HEAP_DESC hd = {};
		hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
		hd.NumDescriptors = 1;
		ID3D12DescriptorHeap *heap = nullptr;
		if (zeros == nullptr || FAILED(d->CreateDescriptorHeap(&hd, IID_PPV_ARGS(&heap))))
		{
			if (zeros != nullptr)
				zeros->Release();
			return false;
		}
		D3D12_SHADER_RESOURCE_VIEW_DESC view = {};             // as the lighting's t13: StructuredBuffer<uint>
		view.Format = DXGI_FORMAT_UNKNOWN;
		view.ViewDimension = D3D12_SRV_DIMENSION_BUFFER;
		view.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
		view.Buffer.NumElements = k_zero_counts;
		view.Buffer.StructureByteStride = 4;
		d->CreateShaderResourceView(zeros, &view, heap->GetCPUDescriptorHandleForHeapStart());
		s_zero_counts = zeros;                                 // committed resources start zeroed; never written
		s_zero_heap = heap;
		log(reshade::log::level::info, "TLOU RT v%d: zero light count buffer created", TLOU_RT_VERSION);
		return true;
	}

	// v18: switches CS_DeferredLighting's light loop off for the table bound now: the zero count descriptor goes into the
	// table's own t13 slot (filled from the game's staging descriptors this frame, so for this frame's lighting only). The
	// real counts stay readable for the add-on's passes as a root SRV of the view's range. Only a light count view as the
	// lighting reads it is touched: a live UAV buffer, structured with 4-byte elements, covering every tile.
	bool switch_off_game_lights(device *dev, list_state &s)
	{
		ID3D12DescriptorHeap *const zero_heap = s_zero_heap;
		if (zero_heap == nullptr)
			return s_light_skip = light_skip_zero, false;
		resolved_view rv;
		if (!resolve_lighting_srv(dev, s, 13, true, rv) || rv.slot_cpu == 0 || rv.param >= 64)
			return s_light_skip = light_skip_slot, false;
		const resource_view_desc vd = dev->get_resource_view_desc(resource_view { rv.view });
		const uint32_t width = s_width.load(), height = s_height.load();
		const uint64_t tiles = uint64_t(4 * ((width + 63) / 64)) * ((height + 15) / 16);
		if (vd.type != resource_view_type::buffer || vd.format != format::unknown || vd.buffer.structured.stride != 4 || vd.buffer.structured.count < tiles ||
			vd.buffer.offset + uint64_t(vd.buffer.structured.count) * 4 > rv.buffer_bytes || (vd.buffer.offset & 3) != 0)
			return s_light_skip = light_skip_view, false;
		ID3D12Device *const d = reinterpret_cast<ID3D12Device *>(dev->get_native());
		d->CopyDescriptorsSimple(1, D3D12_CPU_DESCRIPTOR_HANDLE { static_cast<SIZE_T>(rv.slot_cpu) }, zero_heap->GetCPUDescriptorHandleForHeapStart(),
			D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
		if (!s.lights_off)
		{
			s.counts_va = reinterpret_cast<ID3D12Resource *>(rv.resource)->GetGPUVirtualAddress() + vd.buffer.offset;
			s.counts_count = vd.buffer.structured.count;
		}
		s.lights_off = true;
		s.counts_param = rv.param;
		s.counts_table = s.tables[rv.param];
		return true;
	}

	// Barrier states per resource (ReShade's usage bits are D3D12's states, general = COMMON), stamped with the present
	void note_state(uint64_t resource, uint32_t state)
	{
		uint32_t i = static_cast<uint32_t>(((resource >> 4) * 0x9E3779B97F4A7C15ull) >> 40) & (k_state_slots - 1);
		const uint32_t present = s_present_index.load(std::memory_order_relaxed);
		for (uint32_t probe = 0; probe < 8; ++probe, i = (i + 1) & (k_state_slots - 1))
		{
			state_entry &e = s_states[i];
			const uint64_t key = e.resource.load(std::memory_order_relaxed);
			if (key != resource && key != 0 && probe != 7)
				continue;                                  // another resource's (the last probe takes the slot over)
			e.state.store(state, std::memory_order_relaxed);
			e.present.store(present, std::memory_order_relaxed);
			e.resource.store(resource, std::memory_order_release);
			return;
		}
	}

	// The state a resource's last barrier left it in, when that barrier was recorded in the last two presents
	uint32_t recent_state(uint64_t resource)
	{
		uint32_t i = static_cast<uint32_t>(((resource >> 4) * 0x9E3779B97F4A7C15ull) >> 40) & (k_state_slots - 1);
		const uint32_t present = s_present_index.load(std::memory_order_relaxed);
		for (uint32_t probe = 0; probe < 8; ++probe, i = (i + 1) & (k_state_slots - 1))
		{
			const state_entry &e = s_states[i];
			if (e.resource.load(std::memory_order_acquire) != resource)
				continue;
			const uint32_t state = e.state.load(std::memory_order_relaxed);
			return present - e.present.load(std::memory_order_relaxed) <= 2 ? state : k_state_unknown;
		}
		return k_state_unknown;
	}

	// ---- injection ----

	// v77: RTXDI's RIS buffer and ReGIR, static (their sizes fix the data buffer's layout): the lamps' RIS tiles first (RTXDI's
	// presampling writes them from offset 0), then ReGIR's onion of cells around the camera - 128 lamp slots a cell, each filled by
	// RIS over 8 power-proportional candidates; cells of 1 m near the camera, growing with the distance
	struct rtxdi_statics
	{
		rtxdi::RISBufferSegmentAllocator allocator;
		RTXDI_RISBufferSegmentParameters local_ris = {};
		std::unique_ptr<rtxdi::ReGIRContext> regir;
		uint32_t ris_elements = 0;
	};
	rtxdi_statics &rtxdi_static()
	{
		static rtxdi_statics s = [] {
			rtxdi_statics r;
			r.local_ris.tileSize = 1024;
			r.local_ris.tileCount = 128;
			r.local_ris.bufferOffset = r.allocator.AllocateSegment(r.local_ris.tileSize * r.local_ris.tileCount);
			rtxdi::ReGIRStaticParameters regir;
			regir.mode = rtxdi::ReGIRMode::Onion;
			regir.lightsPerCell = 128;
			// v88 (the ReGIR article: finer cells where the light changes over a few metres): the onion's 8 detail layer groups,
			// RTXDI's most (RTXDI_ONION_MAX_LAYER_GROUPS, 52 rings) - 5481 cells, about 17% of their distance across (v77-v87:
			// NVIDIA's default 5, 2229 cells, 26%)
			regir.onionParameters.onionDetailLayers = 8;
			r.regir = std::make_unique<rtxdi::ReGIRContext>(regir, r.allocator);
			rtxdi::ReGIRDynamicParameters dynamic;
			dynamic.regirCellSize = 1.0f;
			dynamic.center = { 0.0f, 0.0f, 0.0f };         // the camera: the add-on's positions are relative to it
			dynamic.fallbackSamplingMode = rtxdi::LocalLightReGIRFallbackSamplingMode::Power_RIS;
			dynamic.presamplingMode = rtxdi::LocalLightReGIRPresamplingMode::Power_RIS;
			dynamic.regirSamplingJitter = 1.0f;
			dynamic.regirNumBuildSamples = 8;              // (v88-v90: 32; v91: the "ReGIR candidates" slider, fill_regir)
			r.regir->SetDynamicParameters(dynamic);
			r.ris_elements = r.allocator.GetTotalSizeInElements();
			return r;
		}();
		return s;
	}

	// The data buffer's layout (rt.hlsl: plane_offset, history_offset, copy_pitch, copy_offset): a 256-byte frame block,
	// 9 half-resolution float4 planes, the full-resolution history (R11G11B10 per pixel) and the two copy-out images for
	// G-buffer targets 4 and 5 (R11G11B10 rows of pitch bytes, 512-aligned placed footprints)
	struct data_layout
	{
		UINT64 history = 0, copy = 0, pitch = 0, image = 0, total = 0;
		UINT64 relight_image = 0, relight_gp = 0, relight_tiles = 0;   // v50: re9.hlsl relight_*_offset
		UINT64 rtxdi = 0;                                  // v76: RTXDI's reservoirs (rtxdi_di.hlsl's root UAV), at the end
		UINT64 rtxdi_ris = 0, rtxdi_pdf = 0;               // v77: its RIS buffer (a root UAV) and the lamps' PDF mips (Data, g_rtxdi.pdfAt)
		UINT64 rr = 0, rr_pitch8 = 0, rr_pitch4 = 0, rr_plane = 0;   // v78: Ray Reconstruction's region (re9.hlsl RR_*)
		UINT64 pt = 0, pt_surface = 0, pt_neighbors = 0, pt_dup = 0, pt_smooth = 0;   // v83: ReSTIR PT's reservoirs and planes (rtxdi_pt_frame.hlsli)
		UINT64 rtxdi_game = 0;                             // v86: the game's lights for RTXDI (cs_rtxdi_game's two tables)
		UINT64 sharc_keys = 0, sharc_acc = 0, sharc_res = 0;   // v87: NVIDIA SHaRC's buffers (sharc.hlsli u5-u7)
		UINT64 regir_keys = 0, regir_cells = 0;            // v90: ReGIR's surface cells (regir_cells.hlsli u8, the cells' bytes)
		UINT64 regir_vis = 0;                              // v93: the ReGIR visibility cache (regir_vis.hlsli)
		UINT64 lamps = 0;                                  // v95: the emitters' lists to the lamps' maps (rt.hlsl emit_list_base; the capture)
	};
	data_layout layout_for(uint32_t width, uint32_t height)
	{
		const auto align = [](UINT64 v, UINT64 a) { return (v + a - 1) & ~(a - 1); };
		data_layout l;
		const UINT64 half = UINT64((width + 1) / 2) * ((height + 1) / 2);
		l.history = align(k_frame_bytes + k_planes * half * 16, 512);
		l.pitch = align(UINT64(width) * 4, 256);
		l.image = align(l.pitch * height, 512);        // each copy-out image starts 512-aligned (placed footprint rule)
		l.copy = align(l.history + UINT64(width) * height * 4, 512);
		l.total = l.copy + k_copy_images * l.image + k_light_bytes_per_pixel * width * height;   // + the lights' planes (v18)
		l.total = align(l.total, 256) + k_sharc_capacity * 28;                                   // + SHaRC (v23)
		l.total = align(l.total, 256) + 2 * align(half * 48, 256);                               // + ReSTIR GI's reservoirs (v38)
		l.lamps = align(l.total, 256) + align(UINT64(width) * height * 4, 256);                  // (v95: emit_list_base, k_dump_lamp_bytes on)
		l.total = align(l.total, 256) + align(UINT64(width) * height * 4, 256) + 2 * (16 + 1024 * 32);   // + emitters: plane, lists (v39; v76 two)
		l.total = align(l.total + 16 + 1024 * 32, 256) + 4096 * 96 + 2 * 4096 * 4;              // + v67: observations, the lamps' memory (rt.hlsl
		                                                                                         //   lamp_offset); v76: their two maps
		l.total = align(l.total, 256) + 2 * align(UINT64(width) * height * 48, 256);            // + ReSTIR DI's reservoirs (v42)
		l.total = align(l.total, 256) + 2 * align(half * 64, 256);                               // + ReSTIR PT's path reservoirs (v43)
		l.total = align(l.total, 256) + 2 * align(UINT64(width) * height * 48, 256);            // + v76 the adapter's surfaces (adapter.hlsl)
		l.total = align(l.total, 256) + 15 * align(UINT64(width) * height * 16, 256);           // + the RE9 renderer's planes (v44, RE9_PLANES; v47 13, v81 15,
		                                                                                         //   v76 14)
		l.total = align(l.total, 256) + 4 * align(UINT64(width) * height * 16, 256);            // + its ReSTIR GI reservoirs (v48: 2 lobes x 2 frames)
		l.relight_image = align(l.total, 512);                                                   // + the forward relight (v50): the light buffer's copy,
		l.relight_gp = align(l.relight_image + l.pitch * height, 256);                            //   G and P per pixel,
		l.relight_tiles = align(l.relight_gp + UINT64(width) * height * 8, 256);                  //   a header and the tiles' sums
		l.total = l.relight_tiles + 16 + UINT64((width + 15) / 16) * ((height + 15) / 16) * 8;
		l.total = align(l.total, 256) + align(UINT64(width) * height * 16, 256);                 // + v68 the path reuse: the paths' origins (re9.hlsl),
		l.total = align(l.total, 256) + align(UINT64(width) * height * 32, 256);                 //   the shifts (reuse.hlsl),
		l.total = align(l.total, 256) + 1938208;                                                  //   the pairing textures (PAIR_BYTES)
		l.rtxdi = align(l.total, 256);                                                             // + v76 RTXDI's reservoir arrays
		l.total = l.rtxdi + UINT64(rtxdi::c_NumReSTIRDIReservoirBuffers) * sizeof(RTXDI_PackedDIReservoir) *
			rtxdi::CalculateReservoirBufferParameters(width, height, rtxdi::CheckerboardMode::Off).reservoirArrayPitch;
		l.rtxdi_ris = align(l.total, 256);                                                         // + v77 RTXDI's RIS buffer (uint2 per entry)
		l.total = l.rtxdi_ris + UINT64(rtxdi_static().ris_elements) * 8;
		l.rtxdi_pdf = align(l.total, 256);                                                         // + v77 the lamps' PDF mips
		l.total = l.rtxdi_pdf + k_rtxdi_pdf_bytes;
		l.rr = align(l.total, 65536);                                                              // + v78 Ray Reconstruction: the slots' frame constants,
		l.rr_pitch8 = align(UINT64(width) * 8, 256);                                              //   then from 64 KB one plane per rr_kind (its inputs,
		l.rr_pitch4 = align(UINT64(width) * 4, 256);                                              //   its output), 64 KB-aligned placed footprints - rows
		l.rr_plane = align(l.rr_pitch8 * height, 65536);                                           //   of 8 or 4 bytes per pixel
		l.total = l.rr + 65536 + rr_kinds * l.rr_plane;
		const UINT64 pixels = UINT64(width) * height;
		l.pt = align(l.total, 256);                                                                // + v83 ReSTIR PT: its reservoir arrays (64 bytes each),
		l.total = l.pt + UINT64(rtxdi::c_NumReSTIRPTReservoirBuffers) * sizeof(RTXDI_PackedPTReservoir) *
			rtxdi::CalculateReservoirBufferParameters(width, height, rtxdi::CheckerboardMode::Off).reservoirArrayPitch;
		l.pt_surface = align(l.total, 256);                                                        //   the primary surfaces (two planes of 32 bytes),
		l.total = l.pt_surface + 2 * align(pixels * 32, 256);
		l.pt_neighbors = align(l.total, 256);                                                      //   v84: CGNS's picks (4 x 4 bytes; v83: the paths'
		l.total = l.pt_neighbors + align(pixels * 16, 256);                                        //   first vertices, two planes of 16),
		l.pt_dup = align(l.total, 256);                                                            //   the duplication map (16),
		l.total = l.pt_dup + align(pixels * 16, 256);
		l.pt_smooth = align(l.total, 256);                                                         //   the smoothed stagnancy (two of 4)
		l.total = l.pt_smooth + 2 * align(pixels * 4, 256);
		l.rtxdi_game = align(l.total, 256);                                                        // + v86 the game's lights for RTXDI
		l.total = l.rtxdi_game + k_rtxdi_game_bytes;
		l.sharc_keys = align(l.total, 256);                                                        // + v87 NVIDIA SHaRC: 64-bit hash keys,
		l.total = l.sharc_keys + UINT64(k_sharc_nv_capacity) * 8;
		l.sharc_acc = align(l.total, 256);                                                         //   the frame's accumulation (16 bytes),
		l.total = l.sharc_acc + UINT64(k_sharc_nv_capacity) * 16;
		l.sharc_res = align(l.total, 256);                                                         //   the resolved light (16 bytes)
		l.total = l.sharc_res + UINT64(k_sharc_nv_capacity) * 16;
		l.regir_keys = align(l.total, 256);                                                        // + v90 ReGIR's surface cells: their keys,
		l.total = l.regir_keys + UINT64(k_regir_capacity) * 8;
		l.regir_cells = align(l.total, 256);                                                       //   their headers and slots
		l.total = l.regir_cells + UINT64(k_regir_capacity) * k_regir_cell_bytes;
		l.regir_vis = align(l.total, 256);                                                         // + v93 the visibility cache
		l.total = l.regir_vis + UINT64(k_regir_vis_capacity) * 16;
		return l;
	}

	ID3D12Resource *ensure_buffer(ID3D12Device *d, uint32_t width, uint32_t height, uint32_t frame)
	{
		const std::lock_guard<std::mutex> lock(s_buffer_mutex);
		for (auto it = s_retired.begin(); it != s_retired.end();)
			if (frame - it->second > 16)
			{
				it->first->Release();
				it = s_retired.erase(it);
			}
			else
				++it;
		if (s_buffer != nullptr && s_buffer_w == width && s_buffer_h == height)
			return s_buffer;
		if (s_buffer != nullptr)
			s_retired.emplace_back(s_buffer, frame);
		const UINT64 bytes = layout_for(width, height).total;
		s_buffer = create_buffer(d, bytes, D3D12_HEAP_TYPE_DEFAULT, D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COMMON);
		if (s_buffer == nullptr)
		{
			set_status("creating the data buffer failed");
			log(reshade::log::level::error, "TLOU RT: %s", get_status().c_str());
			return nullptr;
		}
		s_buffer_w = width;
		s_buffer_h = height;
		log(reshade::log::level::info, "TLOU RT: data buffer for %ux%u (%.1f MB)", width, height, bytes / 1048576.0);
		return s_buffer;
	}

	void release(ID3D12Resource *&res)
	{
		if (res != nullptr)
			res->Release();
		res = nullptr;
	}

	void release_rt()
	{
		if (s_upload != nullptr && s_upload_ptr != nullptr)
			s_upload->Unmap(0, nullptr);
		if (s_readback != nullptr && s_readback_ptr != nullptr)
		{
			const D3D12_RANGE none = { 0, 0 };
			s_readback->Unmap(0, &none);
		}
		s_upload_ptr = nullptr;
		s_readback_ptr = nullptr;
		if (s_relight_pso != nullptr)                         // v50
			s_relight_pso->Release();
		if (s_relight_root != nullptr)
			s_relight_root->Release();
		s_relight_pso = nullptr;
		s_relight_root = nullptr;
		s_relight_failed = false;
		for (ID3D12Resource **res : { &s_upload, &s_readback, &s_scratch, &s_tlas, &s_tlas_scratch })
			release(*res);
		for (auto &[res, frame] : s_rt_retired)
			res->Release();
		s_rt_retired.clear();
		s_entries.clear();
		s_entry_count = 0;
		s_pending_free.clear();
		s_material_free.clear();
		s_material_used = 0;
		for (arena &a : s_arenas)
			a.buffer->Release();
		s_arenas.clear();
		s_arena_total = s_blas_used = s_scratch_bytes = 0;
		if (s_queries != nullptr)
			s_queries->Release();
		s_queries = nullptr;
		if (s_device5 != nullptr)
			s_device5->Release();
		s_device5 = nullptr;
		if (ID3D12Resource *const geo = s_geo.exchange(nullptr))
			geo->Release();
		s_rt_state = 0;
	}

	D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS tlas_inputs(D3D12_GPU_VIRTUAL_ADDRESS instances, uint32_t count)
	{
		D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS in = {};
		in.Type = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_TYPE_TOP_LEVEL;
		in.Flags = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_PREFER_FAST_BUILD;
		in.NumDescs = count;
		in.DescsLayout = D3D12_ELEMENTS_LAYOUT_ARRAY;
		in.InstanceDescs = instances;
		return in;
	}

	D3D12_RAYTRACING_GEOMETRY_DESC blas_geometry(D3D12_GPU_VIRTUAL_ADDRESS vertices, UINT64 count)
	{
		D3D12_RAYTRACING_GEOMETRY_DESC g = {};
		g.Type = D3D12_RAYTRACING_GEOMETRY_TYPE_TRIANGLES;
		g.Flags = D3D12_RAYTRACING_GEOMETRY_FLAG_OPAQUE;    // cut-outs (leaves, hair) are solid for now
		g.Triangles.VertexFormat = DXGI_FORMAT_R32G32B32_FLOAT;
		g.Triangles.VertexCount = static_cast<UINT>(count);
		g.Triangles.VertexBuffer = { vertices, k_vertex_bytes };
		return g;
	}

	// Build and refit use the same inputs, only PERFORM_UPDATE differs (a requirement of DXR updates)
	D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS blas_inputs(const D3D12_RAYTRACING_GEOMETRY_DESC *geometry, bool update)
	{
		D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS in = {};
		in.Type = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_TYPE_BOTTOM_LEVEL;
		in.Flags = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_ALLOW_UPDATE | D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_PREFER_FAST_BUILD |
			(update ? D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_PERFORM_UPDATE : D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_NONE);
		in.NumDescs = 1;
		in.DescsLayout = D3D12_ELEMENTS_LAYOUT_ARRAY;
		in.pGeometryDescs = geometry;
		return in;
	}

	// The geometry buffer, the per-frame upload / readback rings, the timestamp queries, the BLAS scratch and the TLAS (once)
	bool ensure_rt(ID3D12Device *d)
	{
		if (s_rt_state != 0)
			return s_rt_state > 0;
		s_rt_state = -1;
		if (FAILED(d->QueryInterface(IID_PPV_ARGS(&s_device5))))
		{
			s_device5 = nullptr;
			log(reshade::log::level::error, "TLOU RT: ID3D12Device5 not available, screen-space rays only");
			return false;
		}
		ID3D12Resource *const geo = create_buffer(d, k_geo_bytes, D3D12_HEAP_TYPE_DEFAULT, D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COMMON);
		s_geo = geo;
		s_material_free = { { 0u, k_material_slots } };
		s_material_used = 0;
		s_upload = create_buffer(d, k_ring * k_table_bytes, D3D12_HEAP_TYPE_UPLOAD, D3D12_RESOURCE_FLAG_NONE, D3D12_RESOURCE_STATE_GENERIC_READ);
		s_readback = create_buffer(d, k_ring * k_readback_bytes, D3D12_HEAP_TYPE_READBACK, D3D12_RESOURCE_FLAG_NONE, D3D12_RESOURCE_STATE_COPY_DEST);
		s_scratch = create_buffer(d, k_scratch_min, D3D12_HEAP_TYPE_DEFAULT, D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
		s_scratch_bytes = s_scratch != nullptr ? k_scratch_min : 0;
		D3D12_QUERY_HEAP_DESC qd = { D3D12_QUERY_HEAP_TYPE_TIMESTAMP, k_ring * k_queries_per_slot, 0 };
		if (FAILED(d->CreateQueryHeap(&qd, IID_PPV_ARGS(&s_queries))))
			s_queries = nullptr;
		void *mapped = nullptr;
		const D3D12_RANGE none = { 0, 0 };
		if (s_upload != nullptr && SUCCEEDED(s_upload->Map(0, &none, &mapped)))
			s_upload_ptr = static_cast<uint8_t *>(mapped);
		const D3D12_RANGE all = { 0, static_cast<SIZE_T>(k_ring * k_readback_bytes) };
		if (s_readback != nullptr && SUCCEEDED(s_readback->Map(0, &all, &mapped)))
			s_readback_ptr = static_cast<const uint8_t *>(mapped);
		D3D12_RAYTRACING_ACCELERATION_STRUCTURE_PREBUILD_INFO tlas = {};
		const D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS in = tlas_inputs(0, k_region_draws);
		s_device5->GetRaytracingAccelerationStructurePrebuildInfo(&in, &tlas);
		if (tlas.ResultDataMaxSizeInBytes != 0)
		{
			s_tlas = create_buffer(d, tlas.ResultDataMaxSizeInBytes, D3D12_HEAP_TYPE_DEFAULT, D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_RAYTRACING_ACCELERATION_STRUCTURE);
			s_tlas_scratch = create_buffer(d, std::max<UINT64>(tlas.ScratchDataSizeInBytes, 256), D3D12_HEAP_TYPE_DEFAULT, D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
		}
		if (geo == nullptr || s_upload_ptr == nullptr || s_readback_ptr == nullptr || s_scratch == nullptr || s_queries == nullptr || s_tlas == nullptr || s_tlas_scratch == nullptr)
		{
			log(reshade::log::level::error, "TLOU RT: creating the ray tracing buffers failed (geometry %p, upload %p, readback %p, scratch %p, queries %p, TLAS %p / %p), screen-space rays only",
				static_cast<void *>(geo), static_cast<void *>(s_upload_ptr), static_cast<const void *>(s_readback_ptr), static_cast<void *>(s_scratch), static_cast<void *>(s_queries),
				static_cast<void *>(s_tlas), static_cast<void *>(s_tlas_scratch));
			release_rt();
			s_rt_state = -1;
			return false;
		}
		s_rt_state = 1;
		log(reshade::log::level::info, "TLOU RT: ray tracing buffers created (scene geometry %.1f MB, BLAS scratch %.0f MB, TLAS for %u instances %.1f MB)",
			k_geo_bytes / 1048576.0, k_scratch_min / 1048576.0, k_region_draws, tlas.ResultDataMaxSizeInBytes / 1048576.0);
		return true;
	}

	// ---- per-draw BLAS cache ----

	bool arena_alloc(ID3D12Device *d, UINT64 size, uint32_t &index, UINT64 &offset)
	{
		for (uint32_t i = 0; i < s_arenas.size(); ++i)
		{
			std::map<UINT64, UINT64> &free = s_arenas[i].free;
			for (auto it = free.begin(); it != free.end(); ++it)
				if (it->second >= size)
				{
					index = i;
					offset = it->first;
					const UINT64 rest = it->second - size;
					free.erase(it);
					if (rest != 0)
						free.emplace(offset + size, rest);
					return true;
				}
		}
		const UINT64 bytes = std::max(k_arena_bytes, size);
		if (s_arena_total + bytes > k_arena_budget)
			return false;
		ID3D12Resource *const buffer = create_buffer(d, bytes, D3D12_HEAP_TYPE_DEFAULT, D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_RAYTRACING_ACCELERATION_STRUCTURE);
		if (buffer == nullptr)
			return false;
		arena a;
		a.buffer = buffer;
		a.size = bytes;
		if (bytes > size)
			a.free.emplace(size, bytes - size);
		s_arenas.push_back(std::move(a));
		s_arena_total += bytes;
		index = static_cast<uint32_t>(s_arenas.size() - 1);
		offset = 0;
		log(reshade::log::level::info, "TLOU RT: BLAS arena %u created (%.0f MB, %.0f MB in total)", index, bytes / 1048576.0, s_arena_total / 1048576.0);
		return true;
	}

	void arena_free(uint32_t index, UINT64 offset, UINT64 size)
	{
		std::map<UINT64, UINT64> &free = s_arenas[index].free;
		auto next = free.lower_bound(offset);
		if (next != free.end() && offset + size == next->first)
		{
			size += next->second;
			next = free.erase(next);
		}
		if (next != free.begin())
		{
			const auto prev = std::prev(next);
			if (prev->first + prev->second == offset)
			{
				prev->second += size;
				return;
			}
		}
		free.emplace(offset, size);
	}

	// Material slots for an entry's triangles (first fit), k_no_material when the region is full (then its triangles stay
	// unknown: the mean albedo)
	uint32_t material_alloc(uint32_t count)
	{
		for (auto it = s_material_free.begin(); it != s_material_free.end(); ++it)
			if (it->second >= count)
			{
				const uint32_t offset = it->first, rest = it->second - count;
				s_material_free.erase(it);
				if (rest != 0)
					s_material_free.emplace(offset + count, rest);
				s_material_used += count;
				return offset;
			}
		return k_no_material;
	}

	void material_free(uint32_t offset, uint32_t count)
	{
		if (offset == k_no_material || count == 0)
			return;
		s_material_used -= count;
		auto next = s_material_free.lower_bound(offset);
		if (next != s_material_free.end() && offset + count == next->first)
		{
			count += next->second;
			next = s_material_free.erase(next);
		}
		if (next != s_material_free.begin())
		{
			const auto prev = std::prev(next);
			if (prev->first + prev->second == offset)
			{
				prev->second += count;
				return;
			}
		}
		s_material_free.emplace(offset, count);
	}

	// A new BLAS entry for a mesh: memory for the result (refit in place), scratch sizes for build and refit
	std::unique_ptr<blas_entry> create_entry(ID3D12Device *d, uint64_t key, uint32_t vertices, uint32_t frame)
	{
		const D3D12_RAYTRACING_GEOMETRY_DESC geometry = blas_geometry(0, vertices);
		const D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS in = blas_inputs(&geometry, false);
		D3D12_RAYTRACING_ACCELERATION_STRUCTURE_PREBUILD_INFO info = {};
		s_device5->GetRaytracingAccelerationStructurePrebuildInfo(&in, &info);
		if (info.ResultDataMaxSizeInBytes == 0)
			return nullptr;
		auto e = std::make_unique<blas_entry>();
		e->size = align256(info.ResultDataMaxSizeInBytes);
		if (!arena_alloc(d, e->size, e->arena, e->offset))
		{
			s_blas_pressure = true;                        // v34: the next build evicts entries unused for 8 frames
			return nullptr;
		}
		e->key = key;
		e->vertices = vertices;
		e->build_scratch = align256(info.ScratchDataSizeInBytes);
		e->update_scratch = align256(info.UpdateScratchDataSizeInBytes);
		e->last_frame = frame;
		e->material = material_alloc(vertices / 3);
		e->material_clear = e->material != k_no_material;
		e->keep = keep_alloc();                            // v94
		e->keep_new = e->keep != k_no_keep;
		s_blas_used += e->size;
		++s_entry_count;
		return e;
	}

	// Entries unused for k_evict_frames go (v94: and not drawn within "Remember geometry" seconds, unless the budget is full);
	// their memory is reused once the GPU is surely done with them
	void collect(uint32_t frame)
	{
		for (auto it = s_pending_free.begin(); it != s_pending_free.end();)
			if (frame - it->frame > k_ring + 2)
			{
				arena_free(it->arena, it->offset, it->size);
				material_free(it->material, it->triangles);
				if (it->keep != k_no_keep)
					s_keep_free.push_back(it->keep);
				it = s_pending_free.erase(it);
			}
			else
				++it;
		const bool pressure = s_blas_pressure.exchange(false);   // v34: the budget was full: unused for 8 frames goes
		if (frame % 32 != 0 && !pressure)
			return;
		const uint32_t age = pressure ? 8u : k_evict_frames;
		const double keep = pressure ? 0.0 : s_keep_seconds.load(), now = seconds_now();
		for (auto it = s_entries.begin(); it != s_entries.end();)
		{
			std::vector<std::unique_ptr<blas_entry>> &pool = it->second;
			pool.erase(std::remove_if(pool.begin(), pool.end(), [frame, age, keep, now](const std::unique_ptr<blas_entry> &e) {
				if (frame - e->last_frame <= age || now - e->last_seen <= keep)
					return false;
				s_pending_free.push_back({ e->arena, e->offset, e->size, frame, e->material, e->vertices / 3, e->keep });
				s_blas_used -= e->size;
				--s_entry_count;
				return true;
			}), pool.end());
			it = pool.empty() ? s_entries.erase(it) : std::next(it);
		}
	}

	// The frame's prepass draws end with its lighting list: take them and start the next frame's region
	struct frame_geometry
	{
		std::vector<epoch_draw> draws;
		uint32_t region = 0;
		uint32_t presents = 0;                             // presents since the epoch began (> 2 frames' presents: stale, not built)
		uint32_t epoch = 0;                                // v20: the epoch's number (region = epoch % k_regions)
	};
	frame_geometry take_epoch()
	{
		frame_geometry g;
		const uint32_t present = s_present_index.load();
		const std::lock_guard<std::mutex> lock(s_epoch_mutex);
		g.draws.swap(s_epoch_draws);
		g.region = s_epoch % k_regions;
		{
			// v34: the main view: the render size when it took 16 draws or more, else the size with the most draws when it
			// had the most in the epoch before too (one odd frame does not switch it)
			const uint32_t render = std::min(s_width.load(), 0xFFFFu) << 16 | std::min(s_height.load(), 0xFFFFu);
			uint32_t best = 0, best_draws = 0, render_draws = 0;
			for (uint32_t k = 0; k < s_view_hist_n; ++k)
			{
				if (s_view_hist[k].view == render)
					render_draws = s_view_hist[k].draws;
				if (s_view_hist[k].view != 0 && s_view_hist[k].draws > best_draws)
				{
					best = s_view_hist[k].view;
					best_draws = s_view_hist[k].draws;
				}
			}
			if (render_draws >= 16)
				s_main_view = render;
			else if (best != 0 && best_draws >= 16 && best == s_view_candidate)
				s_main_view = best;
			s_view_candidate = best;
			s_view_hist_n = 0;
		}
		g.epoch = s_epoch;
		g.presents = present - s_epoch_present;
		if (g.presents <= 8)                               // v72: (a longer gap - a menu, a load - says nothing of the rate)
		{
			s_presents_mean += (static_cast<float>(g.presents) - s_presents_mean) * 0.05f;
			s_presents_per_frame.store(std::clamp(static_cast<uint32_t>(s_presents_mean + 0.5f), 1u, 4u), std::memory_order_relaxed);
		}
		s_dirty[g.region] = std::max(s_dirty[g.region], static_cast<uint32_t>(g.draws.size()));
		++s_epoch;
		s_epoch_bytes = 0;
		s_epoch_uv_bytes = 0;
		s_epoch_present = present;
		s_epoch_draws.reserve(g.draws.size() + 256);
		return g;
	}

	// Counters of a region to zero now (the injection records the zero pass); the region counts as clean afterwards
	uint32_t take_dirty(uint32_t region)
	{
		const std::lock_guard<std::mutex> lock(s_epoch_mutex);
		const uint32_t count = s_dirty[region];
		s_dirty[region] = 0;
		return count;
	}

	// The game's compute state as it was before the add-on's passes: its lighting root signature, the root arguments recorded
	// on this list, and the bound lighting pipeline (the game's ExecuteIndirect follows)
	void restore_compute(ID3D12GraphicsCommandList *cl, const list_state &s)
	{
		cl->SetComputeRootSignature(reinterpret_cast<ID3D12RootSignature *>(s.args_layout));
		for (uint32_t i = 0; i < 64; ++i)
		{
			const uint64_t bit = 1ull << i;
			if (s.table_mask & bit)
				cl->SetComputeRootDescriptorTable(i, D3D12_GPU_DESCRIPTOR_HANDLE { s.tables[i] });
			if (s.root_mask & bit)
			{
				if (s.root_type[i] == 0)
					cl->SetComputeRootConstantBufferView(i, s.root_va[i]);
				else if (s.root_type[i] == 1)
					cl->SetComputeRootShaderResourceView(i, s.root_va[i]);
				else
					cl->SetComputeRootUnorderedAccessView(i, s.root_va[i]);
			}
			if (s.c_const_mask & bit)
				cl->SetComputeRoot32BitConstants(i, s.c_const_count[i], s.c_consts[i], 0);
		}
		cl->SetPipelineState(reinterpret_cast<ID3D12PipelineState *>(s.pipe));
	}

	// v50: the forward relight's root signature (a root UAV u0: the data buffer; 8 constants b0) and pipeline (s_rt_mutex held)
	bool ensure_relight(ID3D12Device *d)
	{
		if (s_relight_pso != nullptr)
			return true;
		if (s_relight_failed)
			return false;
		s_relight_failed = true;
		D3D12_ROOT_PARAMETER1 p[2] = {};
		p[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_UAV;
		p[0].Descriptor.ShaderRegister = 0;
		p[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
		p[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
		p[1].Constants.ShaderRegister = 0;
		p[1].Constants.Num32BitValues = 8;
		p[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
		D3D12_VERSIONED_ROOT_SIGNATURE_DESC desc = {};
		desc.Version = D3D_ROOT_SIGNATURE_VERSION_1_1;
		desc.Desc_1_1.NumParameters = 2;
		desc.Desc_1_1.pParameters = p;
		static const auto serialize = reinterpret_cast<decltype(&D3D12SerializeVersionedRootSignature)>(
			GetProcAddress(GetModuleHandleW(L"d3d12.dll"), "D3D12SerializeVersionedRootSignature"));
		ID3DBlob *blob = nullptr, *error = nullptr;
		if (serialize != nullptr && SUCCEEDED(serialize(&desc, &blob, &error)))
		{
			if (FAILED(d->CreateRootSignature(0, blob->GetBufferPointer(), blob->GetBufferSize(), IID_PPV_ARGS(&s_relight_root))))
				s_relight_root = nullptr;
		}
		if (blob != nullptr)
			blob->Release();
		if (error != nullptr)
			error->Release();
		if (s_relight_root == nullptr)
		{
			log(reshade::log::level::error, "TLOU RT: the forward relight's root signature could not be created");
			return false;
		}
		D3D12_COMPUTE_PIPELINE_STATE_DESC pso = {};
		pso.pRootSignature = s_relight_root;
		pso.CS = { g_cs_relight, sizeof(g_cs_relight) };
		const HRESULT hr = d->CreateComputePipelineState(&pso, IID_PPV_ARGS(&s_relight_pso));
		if (FAILED(hr))
		{
			s_relight_pso = nullptr;
			log(reshade::log::level::error, "TLOU RT: creating the forward relight pipeline failed (0x%08X)", static_cast<unsigned>(hr));
			return false;
		}
		s_relight_failed = false;
		return true;
	}

	// v50: the forward relight, at the game's fog dispatch (CS_ApplyFogDirectlyToFullRes: its u0 is the light buffer, in the
	// UAV state): the light buffer copied into the data buffer, src\relight.hlsl on the copy, copied back; then the game's
	// compute state (root signature, arguments, the fog pipeline) as it was. Once a frame, after an RE9 composite in this
	// frame or the last (the pass itself checks the GPU's frame token)
	void relight(command_list *cmd, list_state &s)
	{
		if (s_relight.load() <= 0.0f || s.args_layout == 0 || s.pipe == 0)
			return;                                        // (the fog's root signature and pipeline are what restore_compute puts back)
		// v72: an RE9 composite of this frame or the last counted in the add-on's frames (s_frame: one per lighting) - v50-v71
		// in presents (within 1), which frame generation's extra presents broke (1-12 of 15 fog passes relit: the eyes and
		// forward layers flickered); the presents only bound it now (8 frames' worth: the add-on idle counts no frames)
		const uint32_t present = s_present_index.load();
		const uint32_t armed = s_relight_present.load(), armed_frame = s_relight_frame.load();
		if (armed == UINT32_MAX || armed_frame == UINT32_MAX || s_frame.load() - armed_frame > 2u ||
			present - armed > 8u * s_presents_per_frame.load(std::memory_order_relaxed))
		{
			s_relight_counts[1].fetch_add(1, std::memory_order_relaxed);
			return;
		}
		if (s_relight_done.exchange(present) == present)
			return;
		device *const dev = cmd->get_device();
		resolved_view rv;
		if (!resolve_lighting_srv(dev, s, 0, false, rv, true) || rv.texture.fmt != format::r11g11b10_float)
		{
			s_relight_counts[2].fetch_add(1, std::memory_order_relaxed);
			return;
		}
		ID3D12Device *const d = reinterpret_cast<ID3D12Device *>(dev->get_native());
		ID3D12GraphicsCommandList *const cl = reinterpret_cast<ID3D12GraphicsCommandList *>(cmd->get_native());
		const std::lock_guard<std::mutex> rt_lock(s_rt_mutex);
		ID3D12Resource *const buffer = s_buffer;
		const uint32_t width = s_buffer_w, height = s_buffer_h;
		if (buffer == nullptr || rv.texture.width != width || rv.texture.height != height || !ensure_relight(d))
		{
			s_relight_counts[2].fetch_add(1, std::memory_order_relaxed);
			return;
		}
		const data_layout l = layout_for(width, height);
		ID3D12Resource *const light = reinterpret_cast<ID3D12Resource *>(rv.resource);
		D3D12_TEXTURE_COPY_LOCATION tex = {}, foot = {};
		tex.pResource = light;
		tex.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
		tex.SubresourceIndex = 0;
		foot.pResource = buffer;
		foot.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
		foot.PlacedFootprint.Offset = l.relight_image;
		foot.PlacedFootprint.Footprint = { DXGI_FORMAT_R11G11B10_FLOAT, width, height, 1, static_cast<UINT>(l.pitch) };
		transition(cl, light, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COPY_SOURCE);
		transition(cl, buffer, D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_COPY_DEST);
		cl->CopyTextureRegion(&foot, 0, 0, 0, &tex, nullptr);
		transition(cl, buffer, D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
		cl->SetComputeRootSignature(s_relight_root);
		cl->SetPipelineState(s_relight_pso);
		cl->SetComputeRootUnorderedAccessView(0, buffer->GetGPUVirtualAddress());
		const float strength = std::clamp(s_relight.load(), 0.0f, 1.0f);
		uint32_t k[8] = { width, height, static_cast<uint32_t>(l.pitch), static_cast<uint32_t>(l.relight_image), static_cast<uint32_t>(l.relight_gp),
			static_cast<uint32_t>(l.relight_tiles), 160u /* FRAME_INFO in rt.hlsl */, 0u };
		std::memcpy(&k[7], &strength, sizeof(float));
		cl->SetComputeRoot32BitConstants(1, 8, k, 0);
		cl->Dispatch((width + 7) / 8, (height + 7) / 8, 1);
		transition(cl, buffer, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COPY_SOURCE);
		transition(cl, light, D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_COPY_DEST);
		cl->CopyTextureRegion(&tex, 0, 0, 0, &foot, nullptr);
		transition(cl, light, D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
		transition(cl, buffer, D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_COMMON);
		restore_compute(cl, s);
		s_relight_counts[0].fetch_add(1, std::memory_order_relaxed);
	}

	// The add-on's root signature with the game's lighting tables / root descriptors re-bound and the add-on's root views
	void bind_own(ID3D12GraphicsCommandList *cl, const list_state &s, const inject_set &set, ID3D12Resource *buffer, bool rt, D3D12_GPU_VIRTUAL_ADDRESS table_va)
	{
		cl->SetComputeRootSignature(reinterpret_cast<ID3D12RootSignature *>(set.layout.handle));
		for (uint32_t i = 0; i < 64; ++i)
		{
			if (s.table_mask & (1ull << i))
				cl->SetComputeRootDescriptorTable(i, D3D12_GPU_DESCRIPTOR_HANDLE { s.tables[i] });
			if (s.root_mask & (1ull << i))
			{
				if (s.root_type[i] == 0)
					cl->SetComputeRootConstantBufferView(i, s.root_va[i]);
				else if (s.root_type[i] == 1)
					cl->SetComputeRootShaderResourceView(i, s.root_va[i]);
				else
					cl->SetComputeRootUnorderedAccessView(i, s.root_va[i]);
			}
		}
		cl->SetComputeRootUnorderedAccessView(set.uav_param, buffer->GetGPUVirtualAddress());
		// v76: RTXDI's reservoirs, at the data buffer's end (rtxdi.hlsli RtxdiReservoirs); v77: its RIS buffer, and the frame's RTXDI
		// constants in the frame's draw table (g_rtxdi)
		const data_layout dl = layout_for(s_width.load(), s_height.load());
		cl->SetComputeRootUnorderedAccessView(set.rtxdi_param, buffer->GetGPUVirtualAddress() + dl.rtxdi);
		cl->SetComputeRootUnorderedAccessView(set.rtxdi_ris_param, buffer->GetGPUVirtualAddress() + dl.rtxdi_ris);
		cl->SetComputeRootUnorderedAccessView(set.rtxdi_pt_param, buffer->GetGPUVirtualAddress() + dl.pt);   // v83: ReSTIR PT's reservoirs
		cl->SetComputeRootUnorderedAccessView(set.sharc_param, buffer->GetGPUVirtualAddress() + dl.sharc_keys);    // v87: NVIDIA SHaRC's
		cl->SetComputeRootUnorderedAccessView(set.sharc_param + 1, buffer->GetGPUVirtualAddress() + dl.sharc_acc); //   hash entries,
		cl->SetComputeRootUnorderedAccessView(set.sharc_param + 2, buffer->GetGPUVirtualAddress() + dl.sharc_res); //   accumulation, resolved
		cl->SetComputeRootUnorderedAccessView(set.regir_param, buffer->GetGPUVirtualAddress() + dl.regir_keys);  // v90: ReGIR's surface cells' keys
		if (table_va != 0)
		{
			cl->SetComputeRootConstantBufferView(set.rtxdi_cb_param, table_va + k_table_rtxdi);
			cl->SetComputeRootConstantBufferView(set.rtxdi_pt_cb_param, table_va + k_table_pt);   // v83: its frame's constants
		}
		if (rt)
		{
			cl->SetComputeRootUnorderedAccessView(set.geo_param, s_geo.load()->GetGPUVirtualAddress());
			cl->SetComputeRootShaderResourceView(set.tlas_param, s_tlas->GetGPUVirtualAddress());
			if (table_va != 0)
				cl->SetComputeRootShaderResourceView(set.table_param, table_va);
			// v30: the masks' heap, when the lighting's tables are in it (alpha_heap)
			if (set.heap_param != UINT32_MAX && s.alpha_gpu != 0)
				cl->SetComputeRootDescriptorTable(set.heap_param, D3D12_GPU_DESCRIPTOR_HANDLE { s.alpha_gpu });
		}
	}

	// v19: the last Cs_SpecularIbl dispatch's arguments on the mirrored parameters - only when every mirrored parameter
	// has one, from a dispatch of the last two presents with the same root signature
	bool bind_ibl(ID3D12GraphicsCommandList *cl, const inject_set &set)
	{
		if (set.ibl_count == 0)
			return false;
		const std::lock_guard<std::mutex> lock(s_ibl_mutex);
		const ibl_args &a = s_ibl_args;
		if (a.layout != set.ibl_layout || s_present_index.load() - a.present > 2)
			return false;
		for (uint32_t p = 0; p < 64; ++p)
			if (set.ibl_param[p] != UINT32_MAX && ((a.table_mask | a.root_mask | a.const_mask) & (1ull << p)) == 0)
				return false;
		for (uint32_t p = 0; p < 64; ++p)
		{
			const uint32_t to = set.ibl_param[p];
			const uint64_t bit = 1ull << p;
			if (to == UINT32_MAX)
				continue;
			if (a.table_mask & bit)
				cl->SetComputeRootDescriptorTable(to, D3D12_GPU_DESCRIPTOR_HANDLE { a.tables[p] });
			if (a.root_mask & bit)
			{
				if (a.root_type[p] == 0)
					cl->SetComputeRootConstantBufferView(to, a.root_va[p]);
				else if (a.root_type[p] == 1)
					cl->SetComputeRootShaderResourceView(to, a.root_va[p]);
				else
					cl->SetComputeRootUnorderedAccessView(to, a.root_va[p]);
			}
			if (a.const_mask & bit)
				cl->SetComputeRoot32BitConstants(to, a.const_count[p], a.consts[p], 0);
		}
		return true;
	}

	bool effect_on()
	{
		return s_full.load() > 0.0f || s_light_shadows.load() > 0.0f;   // v51: the path tracing, or the game's lights' ray-traced shadows
	}

	// G-buffer targets 4 and 5 (the lighting's t4 / t5) if they are what the add-on expects: R11G11B10_FLOAT at render size
	bool ambient_targets(device *dev, uint32_t width, uint32_t height, ID3D12Resource *(&out)[2])
	{
		for (int i = 0; i < 2; ++i)
		{
			const uint64_t h = s_gbuffer_res[4 + i].load();
			if (h == 0)
				return false;
			const resource_desc desc = dev->get_resource_desc(resource { h });
			if (desc.type != resource_type::texture_2d || desc.texture.format != format::r11g11b10_float || desc.texture.width != width || desc.texture.height != height)
				return false;
			out[i] = reinterpret_cast<ID3D12Resource *>(h);
		}
		return true;
	}

	// Before the game's first lighting dispatch on this list (the game's root signature, tables and pipeline are bound):
	// the frame's geometry (BLAS / TLAS), the near-field path tracing, and the rewritten ambient inputs copied into
	// G-buffer targets 4 and 5. The game's compute state is restored afterwards.
	void pre_lighting(command_list *cmd, list_state &s)
	{
		s_lists_lit.fetch_add(1);
		// the frame's prepass draws end with its lighting (v26: with the lighting at render size, below)
		frame_geometry geo;
		if (!effect_on())
		{
			geo = take_epoch();
			s_streaming = false;                           // nothing to trace: no stream-out either
			return note_skip(skip_off);
		}
		const uint32_t width = s_width.load(), height = s_height.load();
		if (width == 0 || height == 0)
		{
			geo = take_epoch();
			return note_skip(skip_size);
		}
		if (s.args_layout != s.pipe_root || s.table_mask == 0)
		{
			geo = take_epoch();
			if (s_skipped.fetch_add(1) == 0)
				log(reshade::log::level::warning, "TLOU RT: the lighting descriptor tables were not recorded on this list, nothing injected there");
			return note_skip(skip_args);
		}
		// The lighting's inputs this frame, through its own descriptors (pooled textures): t4 / t5 / t18 R11G11B10 and t10
		// RGBA8, all at render size, or not written
		ID3D12Resource *inputs[k_lighting_inputs] = {};
		DXGI_FORMAT input_formats[k_lighting_inputs] = {};
		{
			device *const dev = cmd->get_device();
			for (uint32_t i = 0; i < k_lighting_inputs; ++i)
			{
				resolved_view rv;
				const uint64_t res = resolve_lighting_srv(dev, s, k_input_regs[i], false, rv) ? rv.resource : 0;
				const texture_info info = rv.texture;
				s_resolved[i] = res;
				if (res == 0)
					continue;
				const bool rgba8 = info.fmt == format::r8g8b8a8_unorm || info.fmt == format::r8g8b8a8_typeless;
				if (info.width == width && info.height == height && (i == 2 ? rgba8 : info.fmt == format::r11g11b10_float))
				{
					inputs[i] = reinterpret_cast<ID3D12Resource *>(res);
					input_formats[i] = static_cast<DXGI_FORMAT>(info.fmt);
					s_input_found[i].fetch_add(1, std::memory_order_relaxed);
				}
			}
		}
		// v26: a lighting pass whose t4 is another size (not the frame's view) leaves the epoch to the frame's lighting
		if (s_resolved[0] != 0 && inputs[0] == nullptr)
		{
			if (s_other_lighting.fetch_add(1) == 0)
				log(reshade::log::level::info, "TLOU RT v%d: a lighting pass not at render size seen (its t4 is another size): left alone, the frame's geometry kept for the frame's lighting", TLOU_RT_VERSION);
			return;
		}
		geo = take_epoch();
		inject_set set;
		{
			const std::shared_lock<std::shared_mutex> lock(s_mutex);
			if (const auto it = s_inject.find(s.pipe_root); it != s_inject.end())
				set = it->second;
		}
		// v19: the add-on's root signature mirrors Cs_SpecularIbl's: rebuilt once that is known (or when it changed)
		const uint64_t ibl_layout = s_ibl_layout.load();
		if (set.ok && ibl_layout != 0 && set.ibl_layout != ibl_layout)
		{
			const std::unique_lock<std::shared_mutex> lock(s_mutex);
			if (const auto it = s_inject.find(s.pipe_root); it != s_inject.end())
			{
				if (it->second.ibl_layout != ibl_layout)
				{
					inject_set rebuilt = build_inject_set(cmd->get_device(), s.pipe_root, ibl_layout);
					if (rebuilt.ok && rebuilt.rt_ok && rebuilt.ibl_count != 0)
					{
						for (ID3D12PipelineState *pso : it->second.pso)
							if (pso != nullptr)
								retire(pso);
						if (it->second.layout != 0)
							retire(nullptr, it->second.layout);
						it->second = rebuilt;
					}
					else
					{
						for (ID3D12PipelineState *pso : rebuilt.pso)
							if (pso != nullptr)
								pso->Release();
						if (rebuilt.layout != 0)
							cmd->get_device()->destroy_pipeline_layout(rebuilt.layout);
						it->second.ibl_layout = ibl_layout;   // no retry every frame: the rays keep the baked sky
						it->second.ibl_count = 0;
					}
				}
				set = it->second;
			}
		}
		if (!set.ok || !set.rt_ok)
			return note_skip(skip_pipelines);
		ID3D12Resource *targets[2] = { inputs[0], inputs[1] };
		if ((targets[0] == nullptr || targets[1] == nullptr) && !ambient_targets(cmd->get_device(), width, height, targets))
		{
			if (s_skipped.fetch_add(1) == 0)
				log(reshade::log::level::warning, "TLOU RT: G-buffer targets 4 / 5 are not R11G11B10_FLOAT at render size, the ambient is left as it is");
			return note_skip(skip_targets);
		}
		LARGE_INTEGER qpc_start, qpc_end, qpc_frequency;
		QueryPerformanceCounter(&qpc_start);
		ID3D12Device *const d = reinterpret_cast<ID3D12Device *>(cmd->get_device()->get_native());
		const uint32_t frame = s_frame.fetch_add(1);
		ID3D12Resource *const buffer = ensure_buffer(d, width, height, frame);
		if (buffer == nullptr)
			return note_skip(skip_buffer);
		ID3D12GraphicsCommandList *const cl = reinterpret_cast<ID3D12GraphicsCommandList *>(cmd->get_native());

		const std::lock_guard<std::mutex> rt_lock(s_rt_mutex);
		const bool rt = ensure_rt(d);
		s_streaming = rt;                                  // from now on the prepass draws stream out
		if (!rt)
			return note_skip(skip_rt);
		ID3D12Resource *const geo_buffer = s_geo.load();
		ID3D12GraphicsCommandList4 *cl4 = nullptr;
		const bool have_cl4 = SUCCEEDED(cl->QueryInterface(IID_PPV_ARGS(&cl4)));
		// v72 (user: "re9 keeps flickering ... could be due to me enabling DLSS frame generation"): stale after 2 frames' presents
		// (s_presents_per_frame) - v29-v71 after 2 presents, which frame generation's 2 per frame made 1-4 epochs in 15: the
		// last scene reused, and two in a row skipped the frame whole (the game's own lighting: a flash every 1-2 s)
		const bool geometry = !geo.draws.empty() && geo.presents <= 2u * s_presents_per_frame.load(std::memory_order_relaxed);
		bool build = geometry && have_cl4;
		// v26: an epoch under half the last scene's draws, the last scene being the epoch before: that scene again - its TLAS,
		// BLASes and table (no builds, no conversion; its vertices are in the other region, intact), once; a scene that
		// really shrank is built next
		// v29: also an epoch without geometry (empty, or stale: begun more than 2 presents ago) - v19-v28 skipped that frame
		// whole and it showed the game's own lighting (a flash)
		// v33: no longer for a collapsed epoch (the retention below keeps the missing draws)
		const bool reuse = have_cl4 && s_last_scene && s_reuse_run < 1 && geo.epoch == s_last_scene_epoch + 1 && !geometry;
		if (reuse)
		{
			build = true;
			if (geo.draws.empty())
				s_reuse_empty.fetch_add(1, std::memory_order_relaxed);
			else if (!geometry)
				s_reuse_stale.fetch_add(1, std::memory_order_relaxed);
		}
		const bool fresh = build && !reuse;
		std::vector<table_entry> next_table;
		std::vector<blas_entry *> next_entries;
		uint32_t retained = 0, kept = 0;                   // (v94: kept - entries the game no longer draws, for the shadow rays)
		const double now_s = seconds_now();
		const uint32_t zero_count = take_dirty(geo.region);   // v27: this epoch's counters, zeroed after the conversion read them
		const uint32_t slot = frame % k_ring;
		const D3D12_GPU_VIRTUAL_ADDRESS table_va = s_upload->GetGPUVirtualAddress() + slot * k_table_bytes;
		const D3D12_GPU_VIRTUAL_ADDRESS geo_va = geo_buffer->GetGPUVirtualAddress();

		// A BLAS for every draw: refit the mesh's cached one, or build it (new mesh, or due for a rebuild). The table lists
		// only draws with a BLAS (cs_convert writes their TLAS instances in the same order).
		struct blas_op { blas_entry *entry; uint32_t draw; bool update; bool material_clear; bool keep_new; };
		std::vector<blas_op> ops;
		uint32_t builds = 0, refits = 0, no_memory = 0;
		UINT64 max_scratch = 0;
		if (fresh)
		{
			collect(frame);
			ops.reserve(geo.draws.size());
			next_table.reserve(geo.draws.size());
			table_entry *const table = reinterpret_cast<table_entry *>(s_upload_ptr + slot * k_table_bytes + 128);
			for (uint32_t i = 0; i < geo.draws.size(); ++i)
			{
				const epoch_draw &dr = geo.draws[i];
				std::vector<std::unique_ptr<blas_entry>> &pool = s_entries[dr.key];
				// (v94: the free one drawn most recently - one the game stopped drawing a while ago keeps the geometry it holds
				// for the shadow rays; v9-v93 the first free one)
				blas_entry *e = nullptr;
				for (const std::unique_ptr<blas_entry> &p : pool)
					if (p->last_frame != frame && p->vertices == dr.vertices && (e == nullptr || p->last_frame > e->last_frame))
						e = p.get();
				if (e == nullptr)
				{
					std::unique_ptr<blas_entry> created = create_entry(d, dr.key, dr.vertices, frame);
					if (created == nullptr)
					{
						++no_memory;
						continue;
					}
					e = created.get();
					pool.push_back(std::move(created));
				}
				e->last_frame = frame;
				e->listed_frame = frame;                       // v94
				e->draw_flags = dr.flags;
				e->last_seen = now_s;
				const bool update = e->built && e->refits < k_rebuild_period + (dr.key & 31);
				const uint32_t index = static_cast<uint32_t>(ops.size());
				// v20: the entry's vertices last epoch (the other region, converted then, intact until the next prepass)
				const uint32_t previous = e->has_data && e->last_epoch + 1 == geo.epoch ? e->last_data : k_no_previous;
				const uint32_t keep = e->keep != k_no_keep ? e->keep + 1u : 0u;   // v94: TABLE_KEEP
				table[index] = { dr.data, dr.vertices, dr.counter, dr.flags | (e->material_clear ? 2u : 0u) | (e->keep_new ? k_draw_new_record : 0u),
					e->va(), e->material, previous, dr.uv, dr.alpha, { dr.source, keep } };
				next_table.push_back({ dr.data, dr.vertices, dr.counter, dr.flags, e->va(), e->material, k_no_previous, dr.uv, dr.alpha, { dr.source, keep } });
				next_entries.push_back(e);
				ops.push_back({ e, i, update, e->material_clear, e->keep_new });
				e->material_clear = false;
				e->keep_new = false;
				max_scratch = std::max(max_scratch, update ? e->update_scratch : e->build_scratch);
				++(update ? refits : builds);
			}
			// v33: the last scene's draws this epoch lacks (the game recorded them late, or did not draw them this frame), kept
			// for one frame as they were: their BLAS (not built or refitted now), vertices (last epoch's region, intact with
			// three regions) and table entry, flagged retained (bit 3) for cs_convert; only when that scene was the epoch before
			if (!ops.empty() && s_last_scene && geo.epoch == s_last_scene_epoch + 1)
				for (size_t k = 0; k < s_last_entries.size() && k < s_last_table.size() && ops.size() + retained < k_region_draws; ++k)
				{
					blas_entry *const e = s_last_entries[k];
					if (e->last_frame == frame || !e->built)
						continue;                                  // drawn this frame (its new data is listed), or never built
					table_entry t = s_last_table[k];
					t.flags = (t.flags & ~2u) | 8u;
					t.previous = k_no_previous;
					table[ops.size() + retained] = t;
					++retained;
					e->listed_frame = frame;                   // v94
				}
			// v94 (user: GBRT "remembers any geometry the camera passes through" - RTX Remix's anti-culling; "it must be kept
			// generic"): the BLAS entries the game stopped drawing within the last "Remember geometry" seconds (off the screen,
			// behind something, or recorded late), listed after the retained ones for the shadow rays: flags bit 4 + bit 3
			// (neither converted nor refitted - their vertices and masks are gone, their BLAS holds the last geometry), no
			// coordinates. cs_convert puts one in the scene (MASK_KEPT, opaque) once its record shows KEEP_STILL_FRAMES of
			// stillness, else mask 0: characters and moving props do not leave shadows behind; hair and cut-out cards never
			// (their masks need this frame's data). The camera, bounce and material rays still see only what the game drew.
			const double keep_s = s_keep_seconds.load();
			if (keep_s > 0.0 && !ops.empty())
				for (const auto &pool : s_entries)
					for (const std::unique_ptr<blas_entry> &p : pool.second)
					{
						blas_entry *const e = p.get();
						if (ops.size() + retained + kept >= k_region_draws)
							break;
						if (!e->built || e->keep == k_no_keep || e->listed_frame == frame || (e->draw_flags & 5u) != 0u || now_s - e->last_seen > keep_s)
							continue;
						table[ops.size() + retained + kept] = { 0u, e->vertices, 0u, 8u | k_draw_kept, e->va(), e->material, k_no_previous, k_no_uv, k_no_uv,
							{ 0u, e->keep + 1u } };
						++kept;
					}
			if (ops.empty())
				build = false;
			const auto keep_clears = [&]() {               // nothing converted this frame: the new entries' slots stay uncleared
				for (const blas_op &op : ops)
				{
					if (op.material_clear)
						op.entry->material_clear = true;
					if (op.keep_new)
						op.entry->keep_new = true;                 // v94: (and their stillness records unstarted)
				}
			};
			if (max_scratch > s_scratch_bytes)                 // one op needs more scratch than there is: a bigger buffer
			{
				ID3D12Resource *const bigger = create_buffer(d, max_scratch, D3D12_HEAP_TYPE_DEFAULT, D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
				if (bigger == nullptr)
				{
					build = false;
					keep_clears();
				}
				else
				{
					s_rt_retired.emplace_back(s_scratch, frame);
					s_scratch = bigger;
					s_scratch_bytes = max_scratch;
				}
			}
		}
		for (auto it = s_rt_retired.begin(); it != s_rt_retired.end();)
			if (frame - it->second > k_ring + 2)
			{
				it->first->Release();
				it = s_rt_retired.erase(it);
			}
			else
				++it;
		if (fresh && build)                                // v20: this epoch's vertices are converted below: next frame's previous data
			for (const blas_op &op : ops)
			{
				op.entry->has_data = true;
				op.entry->last_data = geo.draws[op.draw].data;
				op.entry->last_epoch = geo.epoch;
			}
		uint32_t listed = fresh && build ? static_cast<uint32_t>(ops.size()) + retained + kept : 0u;   // (v94: + kept)
		if (reuse)
		{
			listed = static_cast<uint32_t>(s_last_table.size());
			std::memcpy(s_upload_ptr + slot * k_table_bytes + 128, s_last_table.data(), s_last_table.size() * sizeof(table_entry));
			++s_reuse_run;
			s_scene_reused.fetch_add(1, std::memory_order_relaxed);
		}
		else if (build)
		{
			s_last_table.swap(next_table);                 // this scene's own draws, for the next frame's retention or reuse
			s_last_entries.swap(next_entries);
			s_retained_sum.fetch_add(retained, std::memory_order_relaxed);
			s_last_draws = static_cast<uint32_t>(geo.draws.size());
			s_last_scene_epoch = geo.epoch;
			s_last_scene = true;
			s_reuse_run = 0;
		}
		if (!geo.draws.empty() && s_scene_draws.size() < 4096)
			s_scene_draws.push_back(static_cast<uint32_t>(geo.draws.size()));
		const uint32_t header[6] = { listed, static_cast<uint32_t>(geo.region * k_counter_bytes), zero_count,
			static_cast<uint32_t>(k_instance_offset), geo.epoch,     // v36: + the epoch (TABLE_EPOCH, cs_late's tags)
			s_auto_pbr_force.load() != 0.0f ? 1u : 0u };              // v82: + the adapter's switches (TABLE_ADAPTER: ADAPTER_FORCE_AUTO_PBR)
		std::memcpy(s_upload_ptr + slot * k_table_bytes, header, sizeof(header));

		alpha_heap(cmd->get_device(), s);                 // v30: the masks' heap for HeapTextures
		bind_own(cl, s, set, buffer, true, table_va);
		const bool env = bind_ibl(cl, set);                // v19: the game's environment probes for the rays
		if (env)
			s_env_bound.fetch_add(1, std::memory_order_relaxed);
		uav_barrier(cl, nullptr);

		const uint32_t half_w = (width + 1) / 2, half_h = (height + 1) / 2;
		rt_constants constants = { 0, frame, s_bounce.load(), s_sky.load(), s_ray_length.load(), half_w, half_h, 0.0f /* v97: Occlusion gone */,
			std::cos(s_softness.load() * 0.0174532925f), std::cos(s_sun_softness.load() * 0.0174532925f), s_reflect.load(), s_light_shadows.load(),
			s_light_size.load() * 0.01f, 0u, 0u, s_full.load(), env ? 1u : 0u, build ? 1u : 0u, 0.0f /* v97: Sun gone */, s_brightness.load(), s_baked.load(), s_contact.load(), s_lamps.load(),
			s.alpha_gpu != 0 ? 1u : 0u };
		const auto run = [&](int p, uint32_t sub, uint32_t groups_x, uint32_t groups_y) {
			constants.pass = sub;
			cl->SetComputeRoot32BitConstants(set.const_param, sizeof(constants) / 4, &constants, 0);
			cl->SetPipelineState(set.pso[p]);
			cl->Dispatch(groups_x, groups_y, 1);
			uav_barrier(cl, nullptr);
		};
		const auto stamp = [&](uint32_t k) { cl->EndQuery(s_queries, D3D12_QUERY_TYPE_TIMESTAMP, slot * k_queries_per_slot + k); };

		transition(cl, buffer, D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
		stamp(0);
		const bool convert = fresh && build;               // v26: a reused scene is neither converted nor built again
		// v83: the frame's set-up every frame the passes run, a reused scene's too (v26-v82 with a fresh scene only: a reused
		// scene's frame kept the frame before's camera - its motion, reprojection and the temporal reuses a frame behind - and
		// added its light census, statistics and counters to the frame before's)
		if (build)
			run(pass_setup, 0, 1, 1);
		// The geo buffer is COMMON here: the prepass lists returned it there at their close (or it decayed between submissions)
		if (zero_count != 0 || build)
			transition(cl, geo_buffer, D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
		if (convert)
			run(pass_convert, 0, listed, 1);               // v33: the retained draws' instances too
		if (build && listed != 0 && set.pso[pass_mask] != nullptr)   // v37: this frame's slot for each draw's mask
			run(pass_mask, 0, (listed + 63) / 64, 1);
		if (convert && set.pso[pass_late] != nullptr)      // v36: the next epoch's draws already run, this frame's camera for them
			run(pass_late, 0, k_region_draws / 64, 1);
		if (zero_count != 0)                               // v27: after the conversion (it reads them), for this region's next epoch
			run(pass_zero, 0, (zero_count + 63) / 64, 1);
		if (zero_count != 0 || build)
			transition(cl, geo_buffer, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, build ? D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE : D3D12_RESOURCE_STATE_COMMON);
		stamp(1);
		if (convert)
		{
			// the draws' BLASes, back to back (the driver overlaps builds without barriers in between), each with its own
			// scratch range; when the scratch buffer is used up, a barrier and the next batch starts at its beginning
			UINT64 scratch_at = 0;
			const D3D12_GPU_VIRTUAL_ADDRESS scratch_va = s_scratch->GetGPUVirtualAddress();
			for (const blas_op &op : ops)
			{
				const UINT64 need = op.update ? op.entry->update_scratch : op.entry->build_scratch;
				if (scratch_at + need > s_scratch_bytes)
				{
					uav_barrier(cl, s_scratch);
					scratch_at = 0;
				}
				const epoch_draw &dr = geo.draws[op.draw];
				const D3D12_RAYTRACING_GEOMETRY_DESC geometry = blas_geometry(geo_va + dr.data, dr.vertices);
				D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_DESC desc = {};
				desc.DestAccelerationStructureData = op.entry->va();
				desc.Inputs = blas_inputs(&geometry, op.update);
				desc.SourceAccelerationStructureData = op.update ? desc.DestAccelerationStructureData : 0;
				desc.ScratchAccelerationStructureData = scratch_va + scratch_at;
				cl4->BuildRaytracingAccelerationStructure(&desc, 0, nullptr);
				scratch_at += need;
				op.entry->built = true;
				op.entry->refits = op.update ? op.entry->refits + 1 : 0;
			}
			uav_barrier(cl, nullptr);                      // every BLAS written before the TLAS build reads them
			stamp(2);
			D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_DESC top = {};
			top.DestAccelerationStructureData = s_tlas->GetGPUVirtualAddress();
			top.Inputs = tlas_inputs(geo_va + k_instance_offset, listed);
			top.ScratchAccelerationStructureData = s_tlas_scratch->GetGPUVirtualAddress();
			cl4->BuildRaytracingAccelerationStructure(&top, 0, nullptr);
			uav_barrier(cl, s_tlas);
			// back to UAV: the material pass and the traces read and write the material slots (v14); COMMON at the end
			transition(cl, geo_buffer, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
		}
		else
		{
			stamp(2);
			if (build)                                     // v26: the reused scene - its geo buffer state as after a build
				transition(cl, geo_buffer, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
		}
		if (cl4 != nullptr)
			cl4->Release();
		stamp(3);
		if (build)
		{
			// v76: the game adapter's surfaces first (adapter.hlsl: TLOU's G-buffer in the add-on's format, this frame's plane -
			// last frame's stays, for RTXDI's temporal reuse)
			run(pass_adapt, 0, (width + 7) / 8, (height + 7) / 8);
			// v18: the game's light loop off for this frame's lighting (the add-on lights the frame at this list's close);
			// v20: also with Light shadows 0 when Path tracing is on (cs_full replaces the game's result, lights included);
			// v23: done before the passes (the descriptor write holds for the whole list), so the real light counts can be
			// bound for the census: the frame's light list, which the near-field rays' hits draw their lamps from
			s.lights_off = false;                          // only this frame's switch-off binds the counts (never a stale address)
			if ((s_light_shadows.load() > 0.0f || s_full.load() > 0.0f) && set.pso[pass_lights] != nullptr)
			{
				if (!ensure_zero_counts(d))
					s_light_skip = light_skip_zero;
				else if (switch_off_game_lights(cmd->get_device(), s))
					s_lights_off.fetch_add(1);
			}
			if (s.lights_off && set.pso[pass_light_census] != nullptr)
			{
				cl->SetComputeRootShaderResourceView(set.counts_param, s.counts_va);
				constants.light_tiles = s.counts_count;
				constants.lights_on = 1u;
				const uint32_t tiles = std::min(s.counts_count, 4 * ((width + 63) / 64) * ((height + 15) / 16));
				run(pass_light_census, 0, (tiles + 63) / 64, 1);
			}
			// motion (v20: where each pixel's triangle was last frame, for every history), material cache (v14), near-field
			// path tracing -> accumulation -> filter -> the rewritten t4 / t5 (packed)
			run(pass_motion, 0, (width + 7) / 8, (height + 7) / 8);
			if (set.pso[pass_sky] != nullptr)              // v35: the add-on's sky from the game's outdoor ambient
				run(pass_sky, 0, 1, 1);
			run(pass_material, 0, (half_w + 7) / 8, (half_h + 7) / 8);
			// v51: no near-field rays, filter or rewritten lighting inputs any more (TLOU RT's own path tracer): the game's
			// lighting runs on its own inputs, the RE9 renderer lights the frame after it
			// (v39-v64: the emitters here, from the light buffer before the lighting - the frame two frames back, the add-on's own
			// output in it; v65 lists them after the lighting, post_lighting)
			stamp(4);
			stamp(5);
			run(pass_check, 0, ((width + 3) / 4 + 7) / 8, ((height + 3) / 4 + 7) / 8);
			stamp(6);
			transition(cl, geo_buffer, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COMMON);
			transition(cl, buffer, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COMMON);
			s.pre_done = true;
			s.pre_frame = frame;
			s.pre_motion = build;                          // v33: a reused scene's motion plane too (its pixel flags: hair)
			s_ambient_written.fetch_add(1);
		}
		else
		{
			transition(cl, buffer, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COMMON);
			note_skip(skip_geometry);
		}
		restore_compute(cl, s);

		QueryPerformanceCounter(&qpc_end);
		QueryPerformanceFrequency(&qpc_frequency);
		s_slot_info[slot] = { frame, static_cast<uint32_t>(geo.draws.size()), build ? static_cast<uint32_t>(ops.size()) : 0u, builds, refits, no_memory, build,
			(qpc_end.QuadPart - qpc_start.QuadPart) * 1000.0 / qpc_frequency.QuadPart, fresh && build ? kept : 0u };
		if (s_injected.fetch_add(1) == 0)
		{
			set_status("running");
			log(reshade::log::level::info, "TLOU RT v%d: first injection before the game's lighting (%ux%u)", TLOU_RT_VERSION, width, height);
		}
		static bool logged_build = false;
		if (build && !logged_build)
		{
			logged_build = true;
			log(reshade::log::level::info, "TLOU RT v%d: first BLAS pass: %zu draws, %u BLAS built, %u refitted, %u without memory (%u stream-out clones, %llu failed); ambient written into G-buffer targets 4 / 5 (%p, %p)",
				TLOU_RT_VERSION, geo.draws.size(), builds, refits, no_memory, static_cast<unsigned>(s_clones.load()), static_cast<unsigned long long>(s_clones_failed.load()),
				static_cast<void *>(targets[0]), static_cast<void *>(targets[1]));
		}
	}

	// ---- v61: DLSS Ray Reconstruction in a helper process (rr_host.h, src\rr_helper.cpp) ----
	// v61-v77: the helper started next to the game (tlou-rt-rr\tlou-rt-rr.exe beside the add-on), the shared textures made at the
	// render size, a frame published every present on empty textures. v78: RR in the loop - each lighting list writes RR's
	// inputs for its frame M (rr_prepare, cs_rr_inputs, rr_copies), published once the list is submitted (at the next lighting
	// list's submission or the present: rr_publish); the next lighting list's composite reprojects RR's output of M, the game's
	// queue waiting for it before that list (rr_on_execute; the host's watcher ends the wait should the helper not)

	// the line under the setting (rr_status: the line only; rr_message: also ReShade.log)
	void rr_status(const std::string &message)
	{
		const std::lock_guard<std::mutex> lock(s_rr_message_mutex);
		s_rr_message = message;
	}
	void rr_message(const std::string &message)
	{
		rr_status(message);
		log(reshade::log::level::info, "TLOU RT v%d: Ray Reconstruction: %s", TLOU_RT_VERSION, message.c_str());
	}

	std::wstring addon_folder()
	{
		HMODULE module = nullptr;
		GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT, reinterpret_cast<LPCWSTR>(&addon_folder), &module);
		wchar_t path[MAX_PATH] = {};
		GetModuleFileNameW(module, path, MAX_PATH);
		std::wstring folder = path;
		folder.erase(folder.find_last_of(L"\\/"));
		return folder;
	}

	// s_rr_mutex held: the host's GPU objects to release later
	void rr_retire(std::vector<IUnknown *> &retired)
	{
		const uint32_t present = s_present_index.load();
		for (IUnknown *u : retired)
			s_rr_retired.emplace_back(u, present);
		retired.clear();
	}

	// v78: an entry's frame published on the queue its list went to (s_rr_mutex held): its record (the first frame of a
	// generation resets RR's history) and the input fence's signal after the work submitted so far, which holds its list
	bool rr_publish(rr_entry &e)
	{
		rr_frame f = {};
		f.mv_scale_x = f.mv_scale_y = 1.0f;
		f.pre_exposure = 1.0f;
		f.reset = e.value <= s_rr_first ? 1 : 0;
		for (int i = 0; i < 4; ++i)
			f.world_to_view[i * 5] = f.view_to_clip[i * 5] = 1.0f;
		e.signaled = e.queue != nullptr && s_rr_host.publish_value(e.queue, e.value, f);
		return e.signaled;
	}

	// v78: the entries done with (s_rr_mutex held): submitted and published (or without a frame of their own), or never
	// submitted (dropped after 120 presents: a frame value never published, which the helper passes over)
	void rr_trim()
	{
		const uint32_t present = s_present_index.load();
		s_rr_entries.erase(std::remove_if(s_rr_entries.begin(), s_rr_entries.end(), [present](const rr_entry &e) {
			return (e.executed && (e.value == 0 || e.signaled)) || (!e.executed && present - e.present > 120);
		}), s_rr_entries.end());
		s_rr_pending.store(static_cast<uint32_t>(s_rr_entries.size()));
	}

	// v78: every entry dropped (s_rr_mutex held; the helper stops or ended): a list not submitted yet keeps its accumulation
	void rr_forget()
	{
		for (rr_entry &e : s_rr_entries)
			if (!e.executed && e.reads != 0)
				*e.flags = 0u;
		s_rr_entries.clear();
		s_rr_pending.store(0);
		s_rr_frame = UINT32_MAX;
	}

	// v78: what a lighting list does for Ray Reconstruction, before its composite (s_rt_mutex held; takes s_rr_mutex): the
	// composite reprojects RR's output of the frame before when the list before this one wrote RR's inputs (and no debug view
	// is on), and the list writes this frame's inputs when the helper is done with their slot. The list is noted for its
	// submission (rr_on_execute) and its RR block written into the frame's draw table (re9.hlsl TABLE_RR) - its flag 0
	// whenever RR's output is not read (the slot's block may hold an older frame's)
	struct rr_plan
	{
		bool inputs = false, read = false;
		uint32_t in_slot = 0, out_slot = 0;
		ID3D12Resource *in[rr_kinds] = {};                 // the input slot's textures ...
		ID3D12Resource *constants = nullptr;               // ... and the slots' frame constants
		ID3D12Resource *out = nullptr;                     // the output read
	};
	rr_plan rr_prepare(uint64_t list, uint32_t frame, uint32_t table_slot, uint32_t width, uint32_t height, const data_layout &l, bool view_off, bool available,
		bool noisy)
	{
		rr_plan p;
		// the block's layout always (v80: cs_rr_inputs also runs for in-game RR, the helper off), its flag 0 until RR's output is
		// read. v81: RR_NOISY (re9.hlsl) while RR denoises in the game - the helper then rests (its frames would go unused)
		uint32_t *const block = reinterpret_cast<uint32_t *>(s_upload_ptr + UINT64(table_slot) * k_table_bytes + k_table_rr);
		const uint32_t layout[8] = { noisy ? 2u : 0u, 0u, 0u, static_cast<uint32_t>(l.rr), static_cast<uint32_t>(l.rr_pitch8), static_cast<uint32_t>(l.rr_pitch4),
			static_cast<uint32_t>(l.rr_plane), 0u };
		std::memcpy(block, layout, sizeof(layout));
		if (s_rr.load() <= 0.5f || !available || noisy)
		{
			if (noisy)
			{
				const std::lock_guard<std::mutex> lock(s_rr_mutex);
				s_rr_frame = UINT32_MAX;                   // (nothing read from the helper right after either)
			}
			return p;
		}
		const std::lock_guard<std::mutex> lock(s_rr_mutex);
		if (!s_rr_host.ready() || s_rr_host.width != width || s_rr_host.height != height || s_rr_host.constants == nullptr)
		{
			s_rr_frame = UINT32_MAX;
			return p;
		}
		if (s_rr_generation != s_rr_host.generation)
		{
			// a new generation of textures (or the helper's start): RR starts over - its first frame resets RR's history - and
			// nothing is read across it
			s_rr_generation = s_rr_host.generation;
			s_rr_value = std::max(s_rr_value, s_rr_host.published);
			s_rr_first = s_rr_value + 1;
			s_rr_frame = UINT32_MAX;
		}
		const uint32_t result = static_cast<uint32_t>(s_rr_host.shared->helper_result);
		const bool evaluates = (result & 0xFFF00000u) != 0xBAD00000u;   // NVSDK_NGX_SUCCEED of the helper's last evaluation
		if (view_off && evaluates && s_rr_value != 0 && s_rr_frame + 1 == frame)
		{
			p.read = true;
			p.out_slot = static_cast<uint32_t>(s_rr_value % TLOU_RR_SLOTS);
			p.out = s_rr_host.textures[p.out_slot][rr_output];
		}
		const int64_t reads = p.read ? s_rr_value : 0;
		const int64_t value = s_rr_value + 1;
		if (s_rr_host.slot_free(value) && s_rr_entries.size() < 8)
		{
			p.inputs = true;
			p.in_slot = static_cast<uint32_t>(value % TLOU_RR_SLOTS);
			for (int k = 0; k < rr_kinds; ++k)
				p.in[k] = s_rr_host.textures[p.in_slot][k];
			p.constants = s_rr_host.constants;
			s_rr_value = value;
			s_rr_frame = frame;
			++s_rr_written;
		}
		else
			s_rr_frame = UINT32_MAX;                       // the next list has no output of this frame to read
		if (p.inputs || p.read)
		{
			for (auto it = s_rr_entries.begin(); it != s_rr_entries.end();)   // the list recorded again before its submission
				it = it->list == list && !it->executed ? s_rr_entries.erase(it) : it + 1;
			rr_entry e;
			e.list = list;
			e.frame = frame;
			e.value = p.inputs ? value : 0;
			e.reads = reads;
			e.flags = block;
			e.present = s_present_index.load();
			s_rr_entries.push_back(e);
			s_rr_pending.store(static_cast<uint32_t>(s_rr_entries.size()));
		}
		const uint32_t b[8] = { p.read ? 1u : 0u, p.in_slot, p.out_slot, static_cast<uint32_t>(l.rr), static_cast<uint32_t>(l.rr_pitch8),
			static_cast<uint32_t>(l.rr_pitch4), static_cast<uint32_t>(l.rr_plane), 0u };
		std::memcpy(block, b, sizeof(b));
		return p;
	}

	// v78: a list's RR copies (s_rt_mutex held; the data buffer in UNORDERED_ACCESS): cs_rr_inputs's planes into the input
	// slot's shared textures and its constants into the slot's part of the shared constants buffer; RR's output of the frame
	// before into its plane, which the composite reprojects. The shared resources (simultaneous access, buffers) are promoted
	// from COMMON and decay back after the list
	// the data buffer's RR plane of a kind as a placed footprint (rows of 8 or 4 bytes per pixel); a texture's subresource 0
	D3D12_TEXTURE_COPY_LOCATION rr_plane_location(ID3D12Resource *buffer, const data_layout &l, int kind, uint32_t width, uint32_t height)
	{
		D3D12_TEXTURE_COPY_LOCATION f = {};
		f.pResource = buffer;
		f.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
		f.PlacedFootprint.Offset = l.rr + 65536 + UINT64(kind) * l.rr_plane;
		const bool wide = kind == rr_color || kind == rr_specular_albedo || kind == rr_normals || kind == rr_output;
		f.PlacedFootprint.Footprint = { k_rr_formats[kind], width, height, 1, static_cast<UINT>(wide ? l.rr_pitch8 : l.rr_pitch4) };
		return f;
	}
	D3D12_TEXTURE_COPY_LOCATION texture_location(ID3D12Resource *r)
	{
		D3D12_TEXTURE_COPY_LOCATION t = {};
		t.pResource = r;
		t.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
		t.SubresourceIndex = 0;
		return t;
	}

	void rr_copies(ID3D12GraphicsCommandList *cl, ID3D12Resource *buffer, const rr_plan &p, const data_layout &l, uint32_t width, uint32_t height)
	{
		const auto plane = [&](int kind) { return rr_plane_location(buffer, l, kind, width, height); };
		const auto texture = [](ID3D12Resource *r) { return texture_location(r); };
		if (p.inputs)
		{
			transition(cl, buffer, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COPY_SOURCE);
			for (int k = 0; k < rr_output; ++k)
			{
				const D3D12_TEXTURE_COPY_LOCATION dst = texture(p.in[k]), src = plane(k);
				cl->CopyTextureRegion(&dst, 0, 0, 0, &src, nullptr);
			}
			cl->CopyBufferRegion(p.constants, UINT64(p.in_slot) * TLOU_RR_CONSTANT_BYTES, buffer, l.rr + UINT64(p.in_slot) * TLOU_RR_CONSTANT_BYTES,
				TLOU_RR_CONSTANT_BYTES);
			transition(cl, buffer, D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
		}
		if (p.read)
		{
			transition(cl, buffer, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COPY_DEST);
			const D3D12_TEXTURE_COPY_LOCATION dst = plane(rr_output), src = texture(p.out);
			cl->CopyTextureRegion(&dst, 0, 0, 0, &src, nullptr);
			transition(cl, buffer, D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
		}
	}

	// v80: the guides of in-game RR (rr_game_evaluate) from cs_rr_inputs's planes of this frame (s_rt_mutex held; the data
	// buffer in UNORDERED_ACCESS): diffuse albedo, specular albedo, normal + roughness, made at the render size on first use
	// (replaced ones released 16 frames later), shader resource at rest - RR reads them in the game's DLSS list
	void rr_game_guides(ID3D12Device *d, ID3D12GraphicsCommandList *cl, ID3D12Resource *buffer, const data_layout &l, uint32_t width, uint32_t height, uint32_t frame)
	{
		constexpr D3D12_RESOURCE_STATES k_rest = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE | D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
		const int kinds[3] = { rr_diffuse_albedo, rr_specular_albedo, rr_normals };
		const std::lock_guard<std::mutex> lock(s_guides_mutex);
		for (auto it = s_guides_retired.begin(); it != s_guides_retired.end();)
			if (frame - it->second > 16)
			{
				it->first->Release();
				it = s_guides_retired.erase(it);
			}
			else
				++it;
		if (s_guides[0] == nullptr || s_guides_w != width || s_guides_h != height)
		{
			for (ID3D12Resource *&g : s_guides)
				if (g != nullptr)
				{
					s_guides_retired.emplace_back(g, frame);
					g = nullptr;
				}
			s_guides_present = UINT32_MAX;
			for (int g = 0; g < 3; ++g)
			{
				D3D12_HEAP_PROPERTIES heap = { D3D12_HEAP_TYPE_DEFAULT };
				D3D12_RESOURCE_DESC desc = {};
				desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
				desc.Width = width;
				desc.Height = height;
				desc.DepthOrArraySize = 1;
				desc.MipLevels = 1;
				desc.Format = k_rr_formats[kinds[g]];
				desc.SampleDesc.Count = 1;
				if (FAILED(d->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc, k_rest, nullptr, IID_PPV_ARGS(&s_guides[g]))))
				{
					for (ID3D12Resource *&made : s_guides)
						if (made != nullptr)
						{
							made->Release();
							made = nullptr;
						}
					return;
				}
			}
			s_guides_w = width;
			s_guides_h = height;
		}
		transition(cl, buffer, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COPY_SOURCE);
		for (int g = 0; g < 3; ++g)
		{
			transition(cl, s_guides[g], k_rest, D3D12_RESOURCE_STATE_COPY_DEST);
			const D3D12_TEXTURE_COPY_LOCATION dst = texture_location(s_guides[g]), src = rr_plane_location(buffer, l, kinds[g], width, height);
			cl->CopyTextureRegion(&dst, 0, 0, 0, &src, nullptr);
			transition(cl, s_guides[g], D3D12_RESOURCE_STATE_COPY_DEST, k_rest);
		}
		transition(cl, buffer, D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
		s_guides_present = s_present_index.load();
	}

	// v80: the guides go with the device (its GPU work is done)
	void rr_game_release()
	{
		const std::lock_guard<std::mutex> lock(s_guides_mutex);
		for (ID3D12Resource *&g : s_guides)
			if (g != nullptr)
			{
				g->Release();
				g = nullptr;
			}
		for (auto &[g, frame] : s_guides_retired)
			g->Release();
		s_guides_retired.clear();
		s_guides_w = s_guides_h = 0;
		s_guides_present = UINT32_MAX;
	}

	// v78: a list is submitted (on_execute_command_list: before the submission). A lighting list that reads RR's output of a
	// frame has that frame published now if it was not yet - the queue's work so far holds the list that wrote it - and the
	// queue waits for its output; when it cannot (that frame's list was never submitted, the helper is gone) its composite
	// keeps the accumulation (its RR flag cleared: the list has not run yet)
	void rr_on_execute(ID3D12CommandQueue *queue, uint64_t list)
	{
		if (s_rr_pending.load(std::memory_order_relaxed) == 0)
			return;
		const std::lock_guard<std::mutex> lock(s_rr_mutex);
		rr_entry *e = nullptr;
		for (rr_entry &x : s_rr_entries)
			if (x.list == list && !x.executed)
			{
				e = &x;
				break;
			}
		if (e == nullptr)
			return;
		e->executed = true;
		e->queue = queue;
		if (e->reads != 0)
		{
			bool ok = s_rr_host.started() && s_rr_host.helper_alive();
			for (rr_entry &r : s_rr_entries)
			{
				if (!ok || r.value == 0 || r.value > e->reads || r.signaled)
					continue;
				if (!r.executed)
				{
					if (r.value == e->reads)
						ok = false;                        // the frame read was never submitted
					continue;
				}
				ok = rr_publish(r);
			}
			if (ok && s_rr_host.published >= e->reads && s_rr_host.queue_wait(queue, e->reads))
				++s_rr_used;
			else
			{
				*e->flags = 0u;
				++s_rr_cancelled;
			}
		}
		rr_trim();
	}

	// v78: the submission layout (the status line): after a lighting list's submission the time to the next list submitted to
	// its queue - a few microseconds most likely means the same ExecuteCommandLists call (its lists' events come back to back),
	// which a same-frame RR (the queue waiting right after the lighting list) could not split
	std::atomic<int64_t> s_lighting_exec_qpc { 0 };
	std::atomic<uint64_t> s_lighting_exec_queue { 0 };
	std::mutex s_gap_mutex;
	std::vector<float> s_gaps_us;
	void note_submission(uint64_t queue, bool lighting)
	{
		LARGE_INTEGER now;
		QueryPerformanceCounter(&now);
		const int64_t before = s_lighting_exec_qpc.exchange(lighting ? now.QuadPart : 0);
		if (before != 0 && s_lighting_exec_queue.load() == queue)
		{
			static const double us = [] { LARGE_INTEGER f; QueryPerformanceFrequency(&f); return 1e6 / static_cast<double>(f.QuadPart); }();
			const std::lock_guard<std::mutex> lock(s_gap_mutex);
			if (s_gaps_us.size() < 512)
				s_gaps_us.push_back(static_cast<float>((now.QuadPart - before) * us));
		}
		if (lighting)
			s_lighting_exec_queue.store(queue);
	}

	// Every present (the present thread): the helper started or stopped with the setting, the shared textures at the render
	// size (a new generation once the helper is done with the old one). v78: the frames of the lists submitted since published
	// (everything submitted so far precedes the present's work), the status line
	void rr_tick(effect_runtime *runtime)
	{
		const uint32_t present = s_present_index.load();
		const std::lock_guard<std::mutex> lock(s_rr_mutex);
		for (auto it = s_rr_retired.begin(); it != s_rr_retired.end();)
		{
			if (present - it->second > k_rr_retire_presents)
			{
				it->first->Release();
				it = s_rr_retired.erase(it);
			}
			else
				++it;
		}
		std::vector<IUnknown *> retired;
		if (s_rr.load() <= 0.5f)
		{
			if (s_rr_host.started())
			{
				rr_forget();
				s_rr_host.stop(retired);
				rr_retire(retired);
				rr_message("off - the helper ended");
			}
			s_rr_start_failed = false;
			return;
		}
		ID3D12Device *const d = reinterpret_cast<ID3D12Device *>(runtime->get_device()->get_native());
		if (!s_rr_host.started())
		{
			if (s_rr_start_failed)
				return;
			const std::wstring dir = addon_folder() + L"\\tlou-rt-rr";
			const std::wstring exe = dir + L"\\tlou-rt-rr.exe";
			if (GetFileAttributesW(exe.c_str()) == INVALID_FILE_ATTRIBUTES)
			{
				s_rr_start_failed = true;
				return rr_message("the helper is missing (tlou-rt-rr\\tlou-rt-rr.exe next to the add-on)");
			}
			if (!s_rr_host.start(d, exe, dir))
			{
				s_rr_start_failed = true;
				const std::string error = s_rr_host.error;
				s_rr_host.stop(retired);
				rr_retire(retired);
				return rr_message("could not start: " + error);
			}
			rr_message("helper started");
		}
		if (!s_rr_host.helper_alive())
		{
			if (!s_rr_start_failed)
			{
				s_rr_start_failed = true;
				rr_forget();
				rr_message(strf("the helper ended (code %lu): %s", static_cast<unsigned long>(s_rr_host.helper_exit_code()), s_rr_host.helper_message().c_str()));
			}
			return;
		}
		const uint32_t w = s_width.load(), h = s_height.load();
		if (w != 0 && h != 0 && (w != s_rr_host.width || h != s_rr_host.height) && s_rr_host.shared->helper_state >= rr_state_ngx && s_rr_host.drained())
		{
			if (!s_rr_host.resize(d, w, h, retired))
				rr_message("the shared textures could not be made: " + s_rr_host.error);
			rr_retire(retired);
		}
		for (rr_entry &e : s_rr_entries)                   // in order; a list not submitted yet is passed over (should a later one be
			if (e.value != 0 && e.executed && !e.signaled) //   submitted before it, its frame is never published: the helper skips it)
				rr_publish(e);
		rr_trim();
		if (present - s_rr_status_present >= 60)
		{
			const bool to_log = present - s_rr_status_present >= 600 || s_rr_status_present == 0;
			s_rr_status_present = present;
			const rr_host::stats st = s_rr_host.take_stats();
			float gap = -1.0f;
			{
				const std::lock_guard<std::mutex> gap_lock(s_gap_mutex);
				if (!s_gaps_us.empty())
				{
					std::sort(s_gaps_us.begin(), s_gaps_us.end());
					gap = s_gaps_us[s_gaps_us.size() / 2];
					s_gaps_us.clear();
				}
			}
			const std::string gap_text = gap < 0.0f ? std::string("not seen") : strf("%.0f us later (median)", gap);
			const std::string line = strf("%llu frames written, %llu reprojected, %llu could not wait | latency %.1f ms (90%%: %.1f, %zu frames) | game-queue waits %llu, "
				"ended by the add-on %llu | after the lighting list the next submission %s | helper: %s",
				static_cast<unsigned long long>(s_rr_written), static_cast<unsigned long long>(s_rr_used), static_cast<unsigned long long>(s_rr_cancelled),
				st.median, st.p90, st.frames, static_cast<unsigned long long>(st.waits), static_cast<unsigned long long>(st.released),
				gap_text.c_str(), s_rr_host.helper_message().c_str());
			if (to_log)
				rr_message(line);
			else
				rr_status(line);
		}
	}

	// The device goes away: the helper ended, every object released now (the game's GPU work is done)
	void rr_shutdown()
	{
		const std::lock_guard<std::mutex> lock(s_rr_mutex);
		rr_forget();
		std::vector<IUnknown *> retired;
		s_rr_host.stop(retired);
		for (IUnknown *u : retired)
			u->Release();
		for (auto &[u, present] : s_rr_retired)
			u->Release();
		s_rr_retired.clear();
		s_rr_start_failed = false;
	}

	// ---- v79-v80: Ray Reconstruction inside the game, in place of the game's DLSS upscaling (option 3) ----
	// (user, v78: RR "should both upscale and denoise", "need to try 3, thats how ray reconstruction works in resident evil
	// requiem, path tracing enables = ray reconstruction takes over the pipeline"). v59/v60 hung in RR's creation inside the
	// game; v79's probe created it where a game with RR does - in the game's DLSS evaluate, on the game's thread, into the
	// game's DLSS command list - in 347 ms, next to RenoDX's DLSS Neural Rendering (which took it as an upscaler) and Optimizer
	// FPS. v80: "Ray Reconstruction upscaling (in the game)" - RR evaluates there in place of the game's DLSS: Streamline's
	// slEvaluateFeature (the game's import slot, patched once: the module is pinned, other add-ons' hooks chain) gets the game's
	// DLSS inputs from its local tags (colour, depth, motion, exposure at the render size, the output at the display size - all
	// in the states RR reads them in: shader resource, the output unordered access), the frame's constants from the game's
	// slSetConstants (its own hook: the jitter, the motion's scale, a cut), and the add-on's guides of this frame (rr_copies:
	// diffuse and specular albedo, normal + roughness). The game's DLSS is skipped while RR upscales; it runs instead whenever
	// anything is missing or RR fails (the frame's reason on the line under the setting). NVIDIA's runtime is started in the
	// game's process once (the DLSS SDK's static library; nvngx_dlssd.dll next to the game's exe - the runtime the game's
	// Streamline started searches only there) and never shut down there (the game's Streamline shares it). Every step goes to
	// tlou-rt-rr\tlou-rt-rr-game.log at once; a watchdog thread adds a line every second while one lasts
	constexpr const char *k_ngx_project = "5d3f9a1c-7b2e-4c80-9e41-2a6b8d0c4f17";   // the helper's (rr_helper.cpp)
	using sl_evaluate_fn = sl::Result (*)(sl::Feature, const sl::FrameToken &, const sl::BaseStructure **, uint32_t, sl::CommandBuffer *);
	using sl_constants_fn = sl::Result (*)(const sl::Constants &, const sl::FrameToken &, const sl::ViewportHandle &);
	void *s_sl_next_evaluate = nullptr, *s_sl_next_constants = nullptr;
	std::mutex s_sl_constants_mutex;
	sl::Constants s_sl_constants;                          // the last the game set (s_sl_constants_mutex), its frame
	uint32_t s_sl_constants_frame = UINT32_MAX;
	bool s_sl_constants_set = false;
	std::atomic<const char *> s_game_step { "" };
	std::atomic<int64_t> s_game_step_qpc { 0 };
	std::atomic<bool> s_game_busy { false };               // a step under way (the watchdog's lines)
	std::mutex s_game_log_mutex;
	FILE *s_game_log = nullptr;
	// the game's thread only (the DLSS evaluate hook): NVIDIA's runtime, RR's feature, its sizes, the frames since its creation
	bool s_ngx_up = false;
	NVSDK_NGX_Parameter *s_ngx_params = nullptr;
	NVSDK_NGX_Handle *s_game_feature = nullptr;
	uint32_t s_game_in_w = 0, s_game_in_h = 0, s_game_out_w = 0, s_game_out_h = 0;
	uint64_t s_game_evaluated = 0;
	std::string s_game_last_fallback;

	void game_log(const char *format, ...)
	{
		char text[1024];
		va_list args;
		va_start(args, format);
		std::vsnprintf(text, sizeof(text), format, args);
		va_end(args);
		const std::lock_guard<std::mutex> lock(s_game_log_mutex);
		if (s_game_log == nullptr)
			s_game_log = _wfsopen((addon_folder() + L"\\tlou-rt-rr\\tlou-rt-rr-game.log").c_str(), L"a", _SH_DENYNO);   // readable while the game runs
		if (s_game_log == nullptr)
			return;
		SYSTEMTIME t;
		GetLocalTime(&t);
		std::fprintf(s_game_log, "%02u:%02u:%02u.%03u [%lu] %s\n", t.wHour, t.wMinute, t.wSecond, t.wMilliseconds, GetCurrentThreadId(), text);
		std::fflush(s_game_log);
	}
	void game_message(const std::string &message)
	{
		{
			const std::lock_guard<std::mutex> lock(s_probe_message_mutex);
			s_probe_message = message;
		}
		game_log("%s", message.c_str());
		log(reshade::log::level::info, "TLOU RT v%d: RR in the game: %s", TLOU_RT_VERSION, message.c_str());
	}
	void NVSDK_CONV game_ngx_log(const char *message, NVSDK_NGX_Logging_Level, NVSDK_NGX_Feature)
	{
		std::string line = message != nullptr ? message : "";
		while (!line.empty() && (line.back() == '\n' || line.back() == '\r'))
			line.pop_back();
		if (line.find("Descriptor heap wrap around") == std::string::npos)   // (the game's own DLSS, every few seconds)
			game_log("NGX: %s", line.c_str());
	}
	void game_step(const char *what)
	{
		LARGE_INTEGER now;
		QueryPerformanceCounter(&now);
		s_game_step = what;
		s_game_step_qpc = now.QuadPart;
		s_game_busy = true;
		game_log("step: %s", what);
	}
	// a line every second while a step lasts (a hang shows where it stopped and for how long)
	void game_watchdog()
	{
		LARGE_INTEGER frequency;
		QueryPerformanceFrequency(&frequency);
		for (;;)
		{
			Sleep(1000);
			if (!s_game_busy.load())
				continue;
			LARGE_INTEGER now;
			QueryPerformanceCounter(&now);
			const double seconds = static_cast<double>(now.QuadPart - s_game_step_qpc.load()) / static_cast<double>(frequency.QuadPart);
			if (seconds >= 1.0)
				game_log("watchdog: still in '%s' after %.0f s", s_game_step.load(), seconds);
		}
	}

	std::wstring rr_game_marker();                         // v81 (below)

	// NVIDIA's runtime in the game's process (once) and RR created on the game's DLSS list - the render size to the DLSS output's
	// size (the game's thread, inside its DLSS evaluate); a feature of another size is released first
	bool rr_game_create(ID3D12GraphicsCommandList *cl, uint32_t in_w, uint32_t in_h, uint32_t out_w, uint32_t out_h, uint64_t evaluate)
	{
		static bool watchdog = false;
		if (!watchdog)
		{
			watchdog = true;
			std::thread(game_watchdog).detach();           // (the module is pinned: the thread may outlive the add-on's state)
		}
		game_log("creating RR at the game's DLSS evaluate #%llu (list %p): render %ux%u -> output %ux%u, RR helper %s", static_cast<unsigned long long>(evaluate),
			static_cast<void *>(cl), in_w, in_h, out_w, out_h, s_rr.load() > 0.5f ? "on" : "off");
		ID3D12Device *device = nullptr;
		if (FAILED(cl->GetDevice(IID_PPV_ARGS(&device))) || device == nullptr)
		{
			game_message("failed: the DLSS list's device");
			return false;
		}
		// v81: the marker stands until this returns (rr_game_check_marker)
		struct marker_guard
		{
			std::wstring path;
			marker_guard() : path(rr_game_marker())
			{
				const HANDLE h = CreateFileW(path.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
				if (h != INVALID_HANDLE_VALUE)
					CloseHandle(h);
			}
			~marker_guard() { DeleteFileW(path.c_str()); }
		} marker;
		NVSDK_NGX_Result r = NVSDK_NGX_Result_Success;
		if (!s_ngx_up)
		{
			game_step("NVIDIA's runtime in the game (NVSDK_NGX_D3D12_Init_with_ProjectID)");
			const std::wstring dir = addon_folder() + L"\\tlou-rt-rr";
			const std::wstring data = dir + L"\\ngx-game";
			CreateDirectoryW(data.c_str(), nullptr);
			const wchar_t *const paths[1] = { dir.c_str() };
			NVSDK_NGX_FeatureCommonInfo info = {};
			info.PathListInfo.Path = paths;
			info.PathListInfo.Length = 1;
			info.LoggingInfo.LoggingCallback = game_ngx_log;
			info.LoggingInfo.MinimumLoggingLevel = NVSDK_NGX_LOGGING_LEVEL_ON;
			r = NVSDK_NGX_D3D12_Init_with_ProjectID(k_ngx_project, NVSDK_NGX_ENGINE_TYPE_CUSTOM, "1.0", data.c_str(), device, &info);
			game_log("init returned 0x%08X (device %p)", static_cast<unsigned>(r), static_cast<void *>(device));
			int available = 0;
			if (NVSDK_NGX_SUCCEED(r))
			{
				game_step("RR's availability (NVSDK_NGX_D3D12_GetCapabilityParameters)");
				r = NVSDK_NGX_D3D12_GetCapabilityParameters(&s_ngx_params);
				if (NVSDK_NGX_SUCCEED(r) && s_ngx_params != nullptr)
					NVSDK_NGX_Parameter_GetI(s_ngx_params, NVSDK_NGX_Parameter_SuperSamplingDenoising_Available, &available);
				game_log("capabilities returned 0x%08X, RR available %d", static_cast<unsigned>(r), available);
			}
			s_game_busy = false;
			if (!available)
			{
				device->Release();
				game_message(strf("failed: RR is not available in the game (0x%08X) - nvngx_dlssd.dll next to the game's exe?", static_cast<unsigned>(r)));
				return false;
			}
			s_ngx_up = true;
		}
		device->Release();
		if (s_game_feature != nullptr)
		{
			game_log("releasing the RR feature of %ux%u -> %ux%u", s_game_in_w, s_game_in_h, s_game_out_w, s_game_out_h);
			NVSDK_NGX_D3D12_ReleaseFeature(s_game_feature);   // (NVIDIA's runtime delays the destruction past the GPU's use)
			s_game_feature = nullptr;
		}
		game_step("RR's creation (NGX_D3D12_CREATE_DLSSD_EXT) on the game's DLSS list");
		NVSDK_NGX_DLSSD_Create_Params create = {};
		create.InDenoiseMode = NVSDK_NGX_DLSS_Denoise_Mode_DLUnified;
		create.InRoughnessMode = NVSDK_NGX_DLSS_Roughness_Mode_Packed;
		create.InUseHWDepth = NVSDK_NGX_DLSS_Depth_Type_HW;
		create.InWidth = in_w;
		create.InHeight = in_h;
		create.InTargetWidth = out_w;
		create.InTargetHeight = out_h;
		const float ratio = static_cast<float>(in_w) / static_cast<float>(out_w);   // DLSS's mode for the game's ratio
		create.InPerfQualityValue = ratio >= 0.99f ? NVSDK_NGX_PerfQuality_Value_DLAA : ratio >= 0.65f ? NVSDK_NGX_PerfQuality_Value_MaxQuality :
			ratio >= 0.56f ? NVSDK_NGX_PerfQuality_Value_Balanced : ratio >= 0.45f ? NVSDK_NGX_PerfQuality_Value_MaxPerf : NVSDK_NGX_PerfQuality_Value_UltraPerformance;
		create.InFeatureCreateFlags = NVSDK_NGX_DLSS_Feature_Flags_IsHDR | NVSDK_NGX_DLSS_Feature_Flags_MVLowRes;   // the game's own motion: not jittered
		LARGE_INTEGER frequency, t0, t1;
		QueryPerformanceFrequency(&frequency);
		QueryPerformanceCounter(&t0);
		r = NGX_D3D12_CREATE_DLSSD_EXT(cl, 1, 1, &s_game_feature, s_ngx_params, &create);
		QueryPerformanceCounter(&t1);
		s_game_busy = false;
		const double ms = static_cast<double>(t1.QuadPart - t0.QuadPart) * 1000.0 / static_cast<double>(frequency.QuadPart);
		if (NVSDK_NGX_FAILED(r) || s_game_feature == nullptr)
		{
			s_game_feature = nullptr;
			game_message(strf("failed: RR's creation returned 0x%08X after %.0f ms", static_cast<unsigned>(r), ms));
			return false;
		}
		s_game_in_w = in_w;
		s_game_in_h = in_h;
		s_game_out_w = out_w;
		s_game_out_h = out_h;
		s_game_evaluated = 0;
		game_message(strf("RR created in the game in %.0f ms (%ux%u -> %ux%u)", ms, in_w, in_h, out_w, out_h));
		return true;
	}

	// The game's DLSS evaluate is RR's this frame when this returns true; false: the game's DLSS runs (the reason counted)
	bool rr_game_fallback(const char *reason)
	{
		s_rr_up_fallbacks.fetch_add(1);
		if (s_game_last_fallback != reason)
		{
			s_game_last_fallback = reason;
			game_log("the game's DLSS upscales: %s", reason);
			const std::lock_guard<std::mutex> lock(s_probe_message_mutex);
			s_rr_up_reason = reason;
		}
		return false;
	}
	bool rr_game_evaluate(ID3D12GraphicsCommandList *cl, const sl::FrameToken &frame, const sl::BaseStructure **inputs, uint32_t count, uint64_t evaluate)
	{
		if (s_probe_state.load() < 0)
			return rr_game_fallback("RR could not be made in the game (see its line)");
		// the game's DLSS inputs (its local tags)
		const sl::ResourceTag *tags[5] = {};                // colour, output, depth, motion, exposure
		for (uint32_t i = 0; inputs != nullptr && i < count; ++i)
		{
			if (inputs[i] == nullptr || std::memcmp(&inputs[i]->structType, &sl::ResourceTag::s_structType, sizeof(sl::StructType)) != 0)
				continue;
			const sl::ResourceTag *const tag = static_cast<const sl::ResourceTag *>(inputs[i]);
			if (tag->resource == nullptr || tag->resource->native == nullptr)
				continue;
			const int k = tag->type == sl::kBufferTypeScalingInputColor ? 0 : tag->type == sl::kBufferTypeScalingOutputColor ? 1 : tag->type == sl::kBufferTypeDepth ? 2 :
				tag->type == sl::kBufferTypeMotionVectors ? 3 : tag->type == sl::kBufferTypeExposure ? 4 : -1;
			if (k >= 0)
				tags[k] = tag;
		}
		if (tags[0] == nullptr || tags[1] == nullptr || tags[2] == nullptr || tags[3] == nullptr)
			return rr_game_fallback("the game's DLSS inputs are not all tagged with its evaluate");
		// the frame's constants
		sl::Constants k;
		uint32_t k_frame = UINT32_MAX;
		{
			const std::lock_guard<std::mutex> lock(s_sl_constants_mutex);
			if (!s_sl_constants_set)
				return rr_game_fallback("the game has not set its DLSS constants (slSetConstants)");
			k = s_sl_constants;
			k_frame = s_sl_constants_frame;
		}
		const uint32_t frame_index = static_cast<uint32_t>(frame);
		// the add-on's guides of this frame: written by this frame's lighting list - v81: or one of the last 8 frames' (a list the
		// add-on passed over; frame generation presents twice). v80 took 2 frames: the game's DLSS upscaled a frame or a few every
		// few seconds - a switch between the upscalers is worse than a guide a few frames old. Older ones: path tracing is off
		ID3D12Resource *guides[3] = {};
		{
			const std::lock_guard<std::mutex> lock(s_guides_mutex);
			if (s_guides[0] == nullptr || s_guides_present == UINT32_MAX)
				return rr_game_fallback("the add-on's guides are not written (path tracing off?)");
			if (s_present_index.load() - s_guides_present > 8u * s_presents_per_frame.load(std::memory_order_relaxed))
				return rr_game_fallback("the add-on's guides are older than 8 frames (path tracing off?)");
			for (int g = 0; g < 3; ++g)
				guides[g] = s_guides[g];
		}
		// the sizes: the colour's tagged extent (else the whole texture), the output's texture
		ID3D12Resource *const color = static_cast<ID3D12Resource *>(tags[0]->resource->native), *const output = static_cast<ID3D12Resource *>(tags[1]->resource->native);
		const D3D12_RESOURCE_DESC cd = color->GetDesc(), od = output->GetDesc();
		const sl::Extent &ce = tags[0]->extent;
		const uint32_t in_w = ce ? ce.width : static_cast<uint32_t>(cd.Width), in_h = ce ? ce.height : cd.Height;
		const uint32_t out_w = static_cast<uint32_t>(od.Width), out_h = od.Height;
		if (s_game_feature == nullptr || out_w != s_game_out_w || out_h != s_game_out_h || in_w > s_game_in_w || in_h > s_game_in_h)
		{
			if (!rr_game_create(cl, in_w, in_h, out_w, out_h, evaluate))
			{
				s_probe_state = -1;
				return rr_game_fallback("RR could not be made in the game (see its line)");
			}
			s_probe_state = 2;
		}
		const auto base = [](const sl::ResourceTag *t) { return t->extent ? NVSDK_NGX_Coordinates { t->extent.left, t->extent.top } : NVSDK_NGX_Coordinates { 0, 0 }; };
		float identity[16] = {};
		for (int i = 0; i < 4; ++i)
			identity[i * 5] = 1.0f;
		NVSDK_NGX_D3D12_DLSSD_Eval_Params eval = {};
		eval.pInColor = color;
		eval.pInOutput = output;
		eval.pInDepth = static_cast<ID3D12Resource *>(tags[2]->resource->native);
		eval.pInMotionVectors = static_cast<ID3D12Resource *>(tags[3]->resource->native);
		eval.pInExposureTexture = tags[4] != nullptr ? static_cast<ID3D12Resource *>(tags[4]->resource->native) : nullptr;
		eval.pInDiffuseAlbedo = guides[0];
		eval.pInSpecularAlbedo = guides[1];
		eval.pInNormals = guides[2];
		eval.InColorSubrectBase = base(tags[0]);
		eval.InDepthSubrectBase = base(tags[2]);
		eval.InMVSubrectBase = base(tags[3]);
		eval.InRenderSubrectDimensions = { in_w, in_h };
		eval.InJitterOffsetX = k.jitterOffset.x;
		eval.InJitterOffsetY = k.jitterOffset.y;
		eval.InMVScaleX = k.mvecScale.x * static_cast<float>(in_w);   // Streamline's motion is normalised (x mvecScale), RR's in pixels
		eval.InMVScaleY = k.mvecScale.y * static_cast<float>(in_h);
		eval.InReset = (k.reset == sl::Boolean::eTrue || s_game_evaluated == 0) ? 1 : 0;
		eval.InPreExposure = 1.0f;
		eval.pInWorldToViewMatrix = identity;              // (no specular hit distance yet: RR takes them only with it)
		eval.pInViewToClipMatrix = identity;
		const NVSDK_NGX_Result r = NGX_D3D12_EVALUATE_DLSSD_EXT(cl, s_game_feature, s_ngx_params, &eval);
		if (NVSDK_NGX_FAILED(r))
		{
			char reason[96];
			std::snprintf(reason, sizeof(reason), "RR's evaluation failed (0x%08X)", static_cast<unsigned>(r));
			return rr_game_fallback(reason);   // (nothing recorded by a failed evaluation: the game's DLSS records this frame)
		}
		if (s_game_evaluated++ == 0)
			game_log("first RR evaluate: render %ux%u -> %ux%u, jitter %+.3f %+.3f, motion scale %.1f x %.1f, exposure %s, constants of frame %u (evaluate's %u), reset %d",
				in_w, in_h, out_w, out_h, eval.InJitterOffsetX, eval.InJitterOffsetY, eval.InMVScaleX, eval.InMVScaleY, eval.pInExposureTexture != nullptr ? "tagged" : "none",
				k_frame, frame_index, eval.InReset);
		if (!s_game_last_fallback.empty())
		{
			s_game_last_fallback.clear();
			game_log("RR upscales again");
		}
		s_rr_up_frames.fetch_add(1);
		s_rr_up_last_present = s_present_index.load();     // v81: the composites write the noisy light while this is recent
		return true;
	}

	// v81: RR denoises in the game this frame - the setting on, RR made and upscaling (its last frame within 30 presents), no
	// debug view: the composites write the noisy light (RR_NOISY), the helper rests
	bool rr_game_active()
	{
		const uint32_t last = s_rr_up_last_present.load();
		return s_rr_up.load() > 0.5f && s_probe_state.load() == 2 && last != UINT32_MAX && s_present_index.load() - last <= 30u && s_debug_view.load() == 0;
	}
	// v99: Ray Reconstruction denoises the path-traced light - in the game (as rr_game_active, a debug view or not) or in the
	// helper (Ray Reconstruction): the RTXPT renderer then leaves ReSTIR DI out, as RTXPT with DLSS-RR (DisableReSTIRsWithDLSSRR)
	bool rr_denoising()
	{
		const uint32_t last = s_rr_up_last_present.load();
		return (s_rr_up.load() > 0.5f && s_probe_state.load() == 2 && last != UINT32_MAX && s_present_index.load() - last <= 30u) || s_rr.load() > 0.5f;
	}

	// v81: the setting is saved now - a marker file stands while NVIDIA's runtime starts or RR is made in the game; found at
	// the next start (that session ended inside it: a hang) the setting goes off, so a hang does not come back with every start
	std::wstring rr_game_marker()
	{
		return addon_folder() + L"\\tlou-rt-rr\\rr-game-creating.marker";
	}
	void rr_game_check_marker()
	{
		const std::wstring marker = rr_game_marker();
		if (GetFileAttributesW(marker.c_str()) == INVALID_FILE_ATTRIBUTES)
			return;
		DeleteFileW(marker.c_str());
		s_rr_up = 0.0f;
		reshade::set_config_value(nullptr, "TLOU RT", "PTRRInGame", 0.0f);
		game_message("off: the last session ended while RR was being made in the game (a hang?) - the setting was switched off");
	}

	// The game's DLSS evaluate (its slEvaluateFeature import, chained): RR's in place of the game's DLSS (sl::kFeatureDLSS) with
	// "Ray Reconstruction upscaling (in the game)", else the game's call
	sl::Result hook_sl_evaluate(sl::Feature feature, const sl::FrameToken &frame, const sl::BaseStructure **inputs, uint32_t count, sl::CommandBuffer *cmd)
	{
		if (feature == sl::kFeatureDLSS)
		{
			const uint64_t evaluate = s_dlss_evaluates.fetch_add(1) + 1;
			if (cmd != nullptr && s_rr_up.load() > 0.5f && rr_game_evaluate(static_cast<ID3D12GraphicsCommandList *>(cmd), frame, inputs, count, evaluate))
				return sl::Result::eOk;
		}
		return reinterpret_cast<sl_evaluate_fn>(s_sl_next_evaluate)(feature, frame, inputs, count, cmd);
	}
	// The game's DLSS constants (its slSetConstants import, chained): the last kept for RR (the jitter, the motion's scale, a cut)
	sl::Result hook_sl_set_constants(const sl::Constants &values, const sl::FrameToken &frame, const sl::ViewportHandle &viewport)
	{
		{
			const std::lock_guard<std::mutex> lock(s_sl_constants_mutex);
			s_sl_constants = values;
			s_sl_constants_frame = static_cast<uint32_t>(frame);
			s_sl_constants_set = true;
		}
		return reinterpret_cast<sl_constants_fn>(s_sl_next_constants)(values, frame, viewport);
	}

	// The game's import slot of sl.interposer.dll's export (rtgi_hdr_feed.cpp's find_import)
	void **find_import(HMODULE module, const char *dll, const char *func)
	{
		uint8_t *const base = reinterpret_cast<uint8_t *>(module);
		const auto nt = reinterpret_cast<const IMAGE_NT_HEADERS *>(base + reinterpret_cast<const IMAGE_DOS_HEADER *>(base)->e_lfanew);
		const IMAGE_DATA_DIRECTORY &dir = nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_IMPORT];
		if (dir.VirtualAddress == 0)
			return nullptr;
		for (auto imp = reinterpret_cast<const IMAGE_IMPORT_DESCRIPTOR *>(base + dir.VirtualAddress); imp->Name != 0; ++imp)
		{
			if (_stricmp(reinterpret_cast<const char *>(base + imp->Name), dll) != 0 || imp->OriginalFirstThunk == 0)
				continue;
			auto names = reinterpret_cast<const IMAGE_THUNK_DATA *>(base + imp->OriginalFirstThunk);
			auto slots = reinterpret_cast<IMAGE_THUNK_DATA *>(base + imp->FirstThunk);
			for (; names->u1.AddressOfData != 0; ++names, ++slots)
				if (!IMAGE_SNAP_BY_ORDINAL(names->u1.Ordinal) &&
					std::strcmp(reinterpret_cast<const IMAGE_IMPORT_BY_NAME *>(base + names->u1.AddressOfData)->Name, func) == 0)
					return reinterpret_cast<void **>(&slots->u1.Function);
		}
		return nullptr;
	}
	// one import slot: the previous target (Streamline, or another add-on's hook) kept and called after the add-on's
	std::string patch_import(const char *func, void *hook, void *&next)
	{
		void **const slot = find_import(GetModuleHandleW(nullptr), "sl.interposer.dll", func);
		DWORD old = 0;
		if (slot == nullptr)
			return strf("%s: not imported by the game", func);
		if (!VirtualProtect(slot, sizeof(void *), PAGE_READWRITE, &old))
			return strf("%s: its import slot could not be written", func);
		next = *slot;
		InterlockedExchangePointer(slot, hook);
		VirtualProtect(slot, sizeof(void *), old, &old);
		HMODULE owner = nullptr;
		wchar_t path[MAX_PATH] = L"?";
		if (GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT, static_cast<LPCWSTR>(next), &owner))
			GetModuleFileNameW(owner, path, MAX_PATH);
		const wchar_t *const name = std::wcsrchr(path, L'\\') != nullptr ? std::wcsrchr(path, L'\\') + 1 : path;
		char narrow[MAX_PATH] = {};
		WideCharToMultiByte(CP_UTF8, 0, name, -1, narrow, MAX_PATH, nullptr, nullptr);
		return strf("%s -> %s", func, narrow);
	}

	// Once per process (AddonInit): the game's DLSS evaluate and constants hooked (both, or neither is used)
	void install_sl_hook()
	{
		if (s_sl_hooked.load())
			return;
		const bool both = find_import(GetModuleHandleW(nullptr), "sl.interposer.dll", "slSetConstants") != nullptr &&
			find_import(GetModuleHandleW(nullptr), "sl.interposer.dll", "slEvaluateFeature") != nullptr;
		std::string message;
		if (!both)
			message = "the game does not import slSetConstants and slEvaluateFeature";
		else
		{
			// (the next target is stored before the slot points at the hook: patch_import writes it first)
			const std::string a = patch_import("slSetConstants", reinterpret_cast<void *>(&hook_sl_set_constants), s_sl_next_constants);
			const std::string b = patch_import("slEvaluateFeature", reinterpret_cast<void *>(&hook_sl_evaluate), s_sl_next_evaluate);
			message = "installed (" + a + ", " + b + ")";
			s_sl_hooked = s_sl_next_constants != nullptr && s_sl_next_evaluate != nullptr;
		}
		{
			const std::lock_guard<std::mutex> lock(s_probe_message_mutex);
			s_sl_hook_message = message;
		}
		log(reshade::log::level::info, "TLOU RT v%d: the game's DLSS hooks: %s", TLOU_RT_VERSION, message.c_str());
	}

	// v76: NVIDIA's RTXDI runtime - its ReSTIR DI context for the render size (the reservoirs' layout, the buffer indices of
	// each frame, the parameters) and its neighbour offsets. v77: prepare_rtxdi writes the frame's RTXDI constants (rtxdi.hlsli
	// g_rtxdi: the DI parameters, the presampling's and ReGIR's) into the frame's draw table every frame the paths run - their
	// bounce hits read them - and moves the DI context on to the next frame when its pass runs (di)
	std::mutex s_rtxdi_mutex;
	std::unique_ptr<rtxdi::ReSTIRDIContext> s_rtxdi;
	uint32_t s_rtxdi_w = 0, s_rtxdi_h = 0, s_rtxdi_frame = UINT32_MAX;
	std::vector<uint8_t> s_rtxdi_offsets;

	// ReGIR's parameters for the shaders from NVIDIA's context, as its full sample fills them (the onion works with radii: half
	// the cell size, the layers' radii in metres; the jitter doubled)
	void fill_regir(ReGIR_Parameters &p, const rtxdi::ReGIRContext &context)
	{
		const rtxdi::ReGIRStaticParameters statics = context.GetReGIRStaticParameters();
		const rtxdi::ReGIRDynamicParameters dynamic = context.GetReGIRDynamicParameters();
		const rtxdi::ReGIROnionCalculatedParameters onion = context.GetReGIROnionCalculatedParameters();
		p = {};
		p.gridParams.cellsX = statics.gridParameters.gridSize.x;
		p.gridParams.cellsY = statics.gridParameters.gridSize.y;
		p.gridParams.cellsZ = statics.gridParameters.gridSize.z;
		p.commonParams.numRegirBuildSamples = static_cast<uint32_t>(std::clamp(s_regir_candidates.load(), 1.0f, 32.0f) + 0.5f);   // v91
		p.commonParams.risBufferOffset = context.GetReGIRCellOffset();
		p.commonParams.lightsPerCell = statics.lightsPerCell;
		p.commonParams.centerX = dynamic.center.x;
		p.commonParams.centerY = dynamic.center.y;
		p.commonParams.centerZ = dynamic.center.z;
		p.commonParams.cellSize = statics.mode == rtxdi::ReGIRMode::Onion ? dynamic.regirCellSize * 0.5f : dynamic.regirCellSize;
		p.commonParams.localLightSamplingFallbackMode = static_cast<uint32_t>(dynamic.fallbackSamplingMode);
		p.commonParams.localLightPresamplingMode = static_cast<uint32_t>(dynamic.presamplingMode);
		p.commonParams.samplingJitter = std::max(0.0f, dynamic.regirSamplingJitter * 2.0f);
		p.onionParams.cubicRootFactor = onion.regirOnionCubicRootFactor;
		p.onionParams.linearFactor = onion.regirOnionLinearFactor;
		p.onionParams.numLayerGroups = static_cast<uint32_t>(std::min<size_t>(onion.regirOnionLayers.size(), RTXDI_ONION_MAX_LAYER_GROUPS));
		for (uint32_t g = 0; g < p.onionParams.numLayerGroups; ++g)
		{
			p.onionParams.layers[g] = onion.regirOnionLayers[g];
			p.onionParams.layers[g].innerRadius *= p.commonParams.cellSize;
			p.onionParams.layers[g].outerRadius *= p.commonParams.cellSize;
		}
		for (size_t n = 0; n < std::min<size_t>(onion.regirOnionRings.size(), RTXDI_ONION_MAX_RINGS); ++n)
			p.onionParams.rings[n] = onion.regirOnionRings[n];
	}

	// The RTXDI_FRAME_* flags this frame's constants hold: presampled (the lamps' PDF and RIS tiles are built this frame), ReGIR;
	// v86: game - the game's lights join the lamps in RTXDI's list (cs_rtxdi_game's table, built this frame with the PDF)
	uint32_t prepare_rtxdi(uint32_t width, uint32_t height, uint32_t frame, uint32_t slot, bool reuse, bool di, bool presample, bool regir,
		bool game)
	{
		const std::lock_guard<std::mutex> lock(s_rtxdi_mutex);
		if (s_upload_ptr == nullptr || width == 0 || height == 0)
			return 0u;
		if (s_rtxdi == nullptr || s_rtxdi_w != width || s_rtxdi_h != height)
		{
			rtxdi::ReSTIRDIStaticParameters statics;
			statics.NeighborOffsetCount = k_rtxdi_offsets;
			statics.RenderWidth = width;
			statics.RenderHeight = height;
			s_rtxdi = std::make_unique<rtxdi::ReSTIRDIContext>(statics);
			s_rtxdi->SetResamplingMode(rtxdi::ReSTIRDI_ResamplingMode::FusedSpatiotemporal);
			s_rtxdi_w = width;
			s_rtxdi_h = height;
			s_rtxdi_frame = UINT32_MAX;
			s_rtxdi_offsets.assign(size_t(k_rtxdi_offsets) * 2, 0);
			rtxdi::FillNeighborOffsetBuffer(s_rtxdi_offsets.data(), k_rtxdi_offsets);
			log(reshade::log::level::info, "TLOU RT: NVIDIA RTXDI context for %ux%u (reservoir array pitch %u)", width, height,
				s_rtxdi->GetReservoirBufferParameters().reservoirArrayPitch);
		}
		if (di && s_rtxdi_frame != frame)                  // its buffer indices move on once per frame its pass runs
		{
			s_rtxdi->SetFrameIndex(frame);
			s_rtxdi_frame = frame;
		}
		rtxdi_statics &statics = rtxdi_static();
		const uint32_t flags = (presample ? k_rtxdi_flag_presampled : 0u) | (presample && regir ? k_rtxdi_flag_regir : 0u) |
			(presample && game ? k_rtxdi_flag_game : 0u);
		rtxdi_frame k = {};
		k.runtime = s_rtxdi->GetRuntimeParams();
		k.runtime.frameIndex = frame;                      // (the presampling's and ReGIR's random numbers too)
		k.reservoirs = s_rtxdi->GetReservoirBufferParameters();
		k.initial = s_rtxdi->GetInitialSamplingParameters();
		k.initial.numLocalLightSamples = 8;                // as the DD2 renderer's emitter candidates (EMIT_CANDIDATES)
		k.initial.numInfiniteLightSamples = 0;             // the sun is the renderer's own term (v86: the game's lights local ones)
		k.initial.numEnvironmentSamples = 0;
		k.initial.numBrdfSamples = 0;                      // the lamps are not the scene's triangles: no BRDF ray finds one
		k.initial.localLightSamplingMode = (flags & k_rtxdi_flag_regir) != 0 ? ReSTIRDI_LocalLightSamplingMode::ReGIR_RIS :
			(flags & k_rtxdi_flag_presampled) != 0 ? ReSTIRDI_LocalLightSamplingMode::Power_RIS : ReSTIRDI_LocalLightSamplingMode::Uniform;
		k.initial.enableInitialVisibility = 1;
		k.spatiotemporal = s_rtxdi->GetSpatioTemporalResamplingParameters();
		k.spatiotemporal.biasCorrectionMode = static_cast<ReSTIRDI_SpatioTemporalBiasCorrectionMode>(std::clamp(s_rtxdi_bias.load(), 0, 3));
		k.spatiotemporal.enablePermutationSampling = 0;    // the reprojection's own random offset instead (no drift: v69)
		k.spatiotemporal.uniformRandomNumber = rtxdi::JenkinsHash(frame);
		k.spatiotemporal.enableVisibilityShortcut = 1;     // a lamp the pixel does not see is dropped before it is stored
		k.spatiotemporal.numSamples = 2;
		k.spatiotemporal.samplingRadius = 16.0f;           // pixels at TLOU's render resolution (RTXDI's default 32 at 1080p)
		const RTXDI_DIBufferIndices b = s_rtxdi->GetBufferIndices();
		k.local_ris = statics.local_ris;
		fill_regir(k.regir, *statics.regir);
		k.input = b.temporalResamplingInputBufferIndex;
		k.output = b.initialSamplingOutputBufferIndex;
		k.reuse = reuse ? 1u : 0u;
		k.flags = flags | (s_renderer.load() == 1 && s_pt_physical.load() > 0.5f ? k_rtxdi_flag_physical : 0u) |   // v99
			(s_renderer.load() == 1 ? k_rtxdi_flag_exact_game : 0u);   // v104: ReSTIR DI at the camera's surfaces: the lamps alone
		k.pdf_at = static_cast<uint32_t>(layout_for(width, height).rtxdi_pdf);
		k.pdf_size = k_rtxdi_pdf_size;
		k.offsets_at = static_cast<uint32_t>(k_table_rtxdi_offsets);
		k.hit_samples = k_rtxdi_hit_samples;
		k.regir_slots = statics.regir->GetReGIRLightSlotCount();
		k.game_at = static_cast<uint32_t>(layout_for(width, height).rtxdi_game);   // v86
		k.regir_plain = static_cast<uint32_t>(std::clamp(s_regir_plain.load(), 0.0f, 100.0f) * 1.28f + 0.5f);   // v92: of 128 slots
		k.game_share = std::clamp(s_regir_game_share.load(), 0.0f, 100.0f) * 0.01f;   // v96 (rtxdi.hlsli regir_source)
		uint8_t *const at = s_upload_ptr + UINT64(slot) * k_table_bytes;
		std::memcpy(at + k_table_rtxdi, &k, sizeof(k));
		std::memcpy(at + k_table_rtxdi_offsets, s_rtxdi_offsets.data(), s_rtxdi_offsets.size());
		return flags;
	}

	// v83: NVIDIA's ReSTIR PT for the RE9 renderer (rtxdi_pt.hlsl) - its context in temporal mode (two reservoir arrays ping-pong
	// by frame, a third keeps the initial samples for the decorrelation) and the frame's constants into the frame's draw table.
	// The paths are the renderer's one bounce: the hit is the light vertex (path length 2), a reconnection vertex is the hit or
	// none (maxRcVertexLength 3: the path replayed). With DLSS Ray Reconstruction NVIDIA's settings for it (RTXDI's
	// GetDefault*(dlssRREnabled): the decorrelation by stagnancy with the firefly replacement, a 20-frame history shortened where
	// pixels share a sample, no age limit), without it the boiling filter and an 8-frame history of at most 30 frames' age.
	// Last frame's path is checked for an occluder before it competes (enableVisibilityBeforeCombine: one ray). The history
	// counts only when last frame ran the passes at this size (PT_FLAG_HISTORY: its reservoirs are moved into this frame's space).
	// v84 (user: "restir pt enhanced should REPLACE current path reuse and add reuse over time, the duplication cap"; "spatial
	// resampling cgns"): with ReSTIR PT neighbours above 0 the context's TemporalAndSpatial mode - the temporal pass writes the
	// initial samples' array, the spatial pass reads it and writes the second, the final one and next frame's temporal input -
	// with CGNS's picks (enableSpatialHeuristicMode; the disocclusion boost's further neighbours from RTXDI's offsets, 16 pixels
	// out at TLOU's render size); a change of mode starts the history anew (the arrays' roles change). The duplication cap
	// (ReSTIR PT Enhanced's duplication-based history reduction, temporal and spatial, a 20-frame history, no age limit:
	// RTXDI's RR settings) with or without RR (v83: with RR only); RR's stagnancy decorrelation from Decorrelation for RR
	// (NVIDIA's 0.4 swapped about three pixels in four in v83)
	struct pt_plan { bool ok = false, dupmap = false, smooth = false, spatial = false; };
	std::unique_ptr<rtxdi::ReSTIRPTContext> s_rtxdi_pt_context;
	uint32_t s_pt_w = 0, s_pt_h = 0, s_pt_last = UINT32_MAX;
	bool s_pt_last_dupmap = false, s_pt_last_spatial = false;
	std::atomic<uint32_t> s_pt_frames { 0 };                    // frames its passes ran (the status line)
	pt_plan prepare_rtxdi_pt(uint32_t width, uint32_t height, uint32_t frame, uint32_t slot, bool rr, uint32_t neighbours)
	{
		pt_plan plan;
		const std::lock_guard<std::mutex> lock(s_rtxdi_mutex);
		if (s_upload_ptr == nullptr || width == 0 || height == 0)
			return plan;
		if (s_rtxdi_pt_context == nullptr || s_pt_w != width || s_pt_h != height)
		{
			rtxdi::ReSTIRPTStaticParameters statics;
			statics.RenderWidth = width;
			statics.RenderHeight = height;
			s_rtxdi_pt_context = std::make_unique<rtxdi::ReSTIRPTContext>(statics);
			s_pt_w = width;
			s_pt_h = height;
			s_pt_last = UINT32_MAX;
			log(reshade::log::level::info, "TLOU RT: NVIDIA ReSTIR PT context for %ux%u (reservoir array pitch %u)", width, height,
				s_rtxdi_pt_context->GetReservoirBufferParameters().reservoirArrayPitch);
		}
		rtxdi::ReSTIRPTContext &context = *s_rtxdi_pt_context;
		plan.spatial = neighbours > 0;
		context.SetResamplingMode(plan.spatial ? rtxdi::ReSTIRPT_ResamplingMode::TemporalAndSpatial : rtxdi::ReSTIRPT_ResamplingMode::Temporal);
		const bool history = s_pt_last != UINT32_MAX && s_pt_last + 1 == frame && s_pt_last_spatial == plan.spatial;
		context.SetFrameIndex(frame);
		RTXDI_PTInitialSamplingParameters initial = rtxdi::GetDefaultReSTIRPTInitialSamplingParams();
		initial.numInitialSamples = 1;
		initial.maxBounceDepth = 2;
		initial.maxRcVertexLength = 3;
		context.SetInitialSamplingParameters(initial);
		RTXDI_PTHybridShiftPerFrameParameters shift = rtxdi::GetDefaultReSTIRPTHybridShiftParams();
		shift.maxBounceDepth = initial.maxBounceDepth;
		shift.maxRcVertexLength = initial.maxRcVertexLength;
		context.SetHybridShiftParameters(shift);
		context.SetReconnectionParameters(rtxdi::GetDefaultReSTIRPTReconnectionParameters());
		RTXDI_PTTemporalResamplingParameters temporal = rtxdi::GetDefaultReSTIRPTTemporalResamplingParams(true);   // v84: the duplication cap always
		temporal.enableVisibilityBeforeCombine = 1;
		context.SetTemporalResamplingParameters(temporal);
		RTXDI_PTSpatialResamplingParameters spatial = rtxdi::GetDefaultReSTIRPTSpatialResamplingParams(true);
		spatial.numSpatialSamples = neighbours;
		spatial.enableSpatialHeuristicMode = 1;            // CGNS
		spatial.samplingRadius = 16.0f;                    // pixels at TLOU's render resolution (RTXDI's default 32 at 1080p)
		context.SetSpatialResamplingParameters(spatial);
		context.SetBoilingFilterParameters(rtxdi::GetDefaultReSTIRPTBoilingFilterParams(rr));
		RTXDI_PTDecorrelationParameters decorrelation = rtxdi::GetDefaultReSTIRPTDecorrelationParams(rr);
		if (rr)
			decorrelation.decorrelationFactor = std::clamp(s_pt_decorrelation.load(), 0.0f, 1.0f);
		context.SetDecorrelationParameters(decorrelation);
		plan.dupmap = rtxdi::NeedsDuplicationMap(context.GetTemporalResamplingParameters(), decorrelation);
		plan.smooth = decorrelation.decorrelationMode == RTXDI_PTDecorrelationMode::Stagnancy && decorrelation.decorrelationFactor > 0.0f;
		rtxdi_pt_frame k = {};
		k.restir_pt.reservoirBuffer = context.GetReservoirBufferParameters();
		k.restir_pt.bufferIndices = context.GetBufferIndices();
		k.restir_pt.initialSampling = context.GetInitialSamplingParameters();
		k.restir_pt.decorrelation = decorrelation;
		k.restir_pt.reconnection = context.GetReconnectionParameters();
		k.restir_pt.temporalResampling = context.GetTemporalResamplingParameters();
		k.restir_pt.hybridShift = context.GetHybridShiftParameters();
		k.restir_pt.boilingFilter = context.GetBoilingFilterParameters();
		k.restir_pt.spatialResampling = context.GetSpatialResamplingParameters();
		k.runtime.neighborOffsetMask = k_rtxdi_offsets - 1;  // v84: RTXDI's neighbour offsets (prepare_rtxdi's, in the frame's table)
		k.runtime.activeCheckerboardField = 0;
		k.runtime.frameIndex = frame;
		k.flags = (history ? k_pt_flag_history : 0u) | (history && s_pt_last_dupmap ? k_pt_flag_dupmap : 0u);
		const data_layout l = layout_for(width, height);
		if (l.total > 0xFFFFFFFFull)
			return plan;                                       // the shaders' byte offsets are 32-bit
		k.surface_at = static_cast<uint32_t>(l.pt_surface);
		k.neighbor_at = static_cast<uint32_t>(l.pt_neighbors);
		k.dup_at = static_cast<uint32_t>(l.pt_dup);
		k.smooth_at = static_cast<uint32_t>(l.pt_smooth);
		std::memcpy(s_upload_ptr + UINT64(slot) * k_table_bytes + k_table_pt, &k, sizeof(k));
		s_pt_last = frame;
		s_pt_last_dupmap = plan.dupmap;
		s_pt_last_spatial = plan.spatial;
		plan.ok = true;
		return plan;
	}

	// v87: NVIDIA SHaRC's frame block (sharc.hlsli sharc_frame at TABLE_SHARC), written every frame - its flag tells the renderers'
	// queries whether the cache ran this frame (else they take v23-v86's own). NVIDIA's defaults (its AGENTS.md): a path per 5 x 5
	// pixels, 32 frames' accumulation, an entry without samples for 64 frames evicted, the roughness at least 0.4 in the Update,
	// radiance in fixed point x 1000; its scene scale and frames from the sliders. Returns whether the cache is emptied first
	// (cs_sharc_clear): it did not run last time, its scale changed, the data buffer is new, "Reset SHaRC"
	float s_sharc_last_scale = 0.0f;
	ID3D12Resource *s_sharc_last_buffer = nullptr;
	std::atomic<bool> s_sharc_was_on { false };                 // its passes ran last time (the status line's counters are its)
	std::atomic<uint32_t> s_sharc_runs { 0 };                   // frames its passes ran (the status line)
	bool prepare_sharc(uint32_t slot, bool on, ID3D12Resource *buffer)
	{
		sharc_frame k = {};
		k.scene_scale = std::clamp(s_sharc_scale.load(), 1.0f, 100.0f);
		k.radiance_scale = 1e3f;
		k.capacity = k_sharc_nv_capacity;
		k.accumulation_frames = static_cast<uint32_t>(std::clamp(s_sharc_frames.load(), 1.0f, 100.0f) + 0.5f);
		k.stale_frames = 64;
		const bool shown = s_present_index.load() - s_overlay_present.load() < 120;   // the status line's counters while the settings show
		k.flags = on ? k_sharc_flag_on | (shown ? k_sharc_flag_count : 0u) : 0u;
		k.downscale = 5;
		k.roughness_min = 0.4f;
		k.bounces = 4;
		if (s_upload_ptr == nullptr)
			return false;
		std::memcpy(s_upload_ptr + UINT64(slot) * k_table_bytes + k_table_sharc, &k, sizeof(k));
		const bool reset = s_sharc_reset.exchange(false);
		const bool clear = on && (reset || !s_sharc_was_on || k.scene_scale != s_sharc_last_scale || buffer != s_sharc_last_buffer);
		s_sharc_was_on = on;
		s_sharc_last_scale = k.scene_scale;
		s_sharc_last_buffer = buffer;
		return clear;
	}

	// v90: ReGIR's surface cells' frame block (regir_cells.hlsli regir_frame at TABLE_REGIR), written every frame - its flag tells
	// the bounce hits whether the cells were filled this frame (else NVIDIA ReGIR's onion): 16 candidates per slot, a cell kept
	// 30 frames unused; its counters while the settings show
	std::atomic<uint32_t> s_regir_cells_runs { 0 };             // frames its passes ran (the status line)
	void prepare_regir_cells(uint32_t slot, bool on, UINT64 cells_at, bool vis_on, UINT64 vis_at)
	{
		if (s_upload_ptr == nullptr)
			return;
		regir_frame k = {};
		k.scene_scale = std::clamp(s_regir_scale.load(), 4.0f, 64.0f);
		k.capacity = k_regir_capacity;
		const bool shown = s_present_index.load() - s_overlay_present.load() < 120;
		k.flags = on ? k_regir_flag_on | (shown ? k_regir_flag_count : 0u) : 0u;
		k.cells_at = static_cast<uint32_t>(cells_at);
		k.candidates = static_cast<uint32_t>(std::clamp(s_regir_candidates.load(), 1.0f, 32.0f) + 0.5f);   // v91 (v90: 16)
		k.stale = 30;
		k.plain = static_cast<uint32_t>(std::clamp(s_regir_plain.load(), 0.0f, 100.0f) * 0.32f + 0.5f);   // v92: of 32 slots
		k.vis_at = static_cast<uint32_t>(vis_at);          // v93: the visibility cache (on with the path tracing, its upkeep ran)
		k.vis_mask = k_regir_vis_capacity - 1;
		k.vis_flags = vis_on ? 1u : 0u;
		k.vis_floor = std::clamp(s_regir_vis_floor.load(), 0.01f, 0.5f);
		std::memcpy(s_upload_ptr + UINT64(slot) * k_table_bytes + k_table_regir, &k, sizeof(k));
	}

	// After the lighting (its list's close): the lit result kept for the next frame's hits, the capture (Numpad -), the
	// statistics and timestamps of this frame copied to the readback ring
	void post_lighting(command_list *cmd, list_state &s)
	{
		if (!s.pre_done)
			return;                                        // nothing path traced on this list
		s.pre_done = false;
		// v18: the game's light loop was off for this list's lighting: the frame has no game lights unless they are added here
		const bool lights = s.lights_off;
		s.lights_off = false;
		const auto lost = [&]() {
			if (lights)
				s_lights_lost.fetch_add(1);
		};
		if (s.dirty)
		{
			lost();
			s_post_counts[0].fetch_add(1, std::memory_order_relaxed);
			if (s_skipped.fetch_add(1) == 0)
				log(reshade::log::level::warning, "TLOU RT: the lighting command list recorded more work after the lighting, the history is not updated there");
			return;
		}
		if (s.args_layout != s.inject_root || s.table_mask == 0)
		{
			s_post_counts[1].fetch_add(1, std::memory_order_relaxed);
			return lost();
		}
		inject_set set;
		{
			const std::shared_lock<std::shared_mutex> lock(s_mutex);
			if (const auto it = s_inject.find(s.inject_root); it != s_inject.end())
				set = it->second;
		}
		const uint32_t width = s_width.load(), height = s_height.load();
		if (!set.ok || width == 0 || height == 0)
		{
			s_post_counts[2].fetch_add(1, std::memory_order_relaxed);
			return lost();
		}
		ID3D12Device *const d = reinterpret_cast<ID3D12Device *>(cmd->get_device()->get_native());
		ID3D12Resource *const buffer = ensure_buffer(d, width, height, s.pre_frame);
		if (buffer == nullptr)
		{
			s_post_counts[3].fetch_add(1, std::memory_order_relaxed);
			return lost();
		}
		ID3D12GraphicsCommandList *const cl = reinterpret_cast<ID3D12GraphicsCommandList *>(cmd->get_native());
		const std::lock_guard<std::mutex> rt_lock(s_rt_mutex);
		if (s_rt_state <= 0)
		{
			s_post_counts[4].fetch_add(1, std::memory_order_relaxed);
			return lost();
		}
		const uint32_t frame = s.pre_frame, slot = frame % k_ring;
		alpha_heap(cmd->get_device(), s);                 // v30: the masks' heap for HeapTextures
		bind_own(cl, s, set, buffer, true, s_upload->GetGPUVirtualAddress() + slot * k_table_bytes);   // the frame's draw table
		uav_barrier(cl, nullptr);                          // the lighting's writes to the light buffer
		const uint32_t half_w = (width + 1) / 2, half_h = (height + 1) / 2;
		const bool light_passes = lights && set.rt_ok && set.pso[pass_lights] != nullptr && set.pso[pass_light_census] != nullptr && set.pso[pass_light_temporal] != nullptr &&
			set.pso[pass_light_filter] != nullptr && set.pso[pass_light_add] != nullptr;
		rt_constants constants = { 0, frame, s_bounce.load(), s_sky.load(), s_ray_length.load(), half_w, half_h, 0.0f /* v97: Occlusion gone */,
			std::cos(s_softness.load() * 0.0174532925f), std::cos(s_sun_softness.load() * 0.0174532925f), s_reflect.load(), s_light_shadows.load(),
			s_light_size.load() * 0.01f, light_passes ? s.counts_count : 0u, light_passes ? 1u : 0u, s_full.load(), 0u, s.pre_motion ? 1u : 0u,
			0.0f /* v97: Sun gone */, s_brightness.load(), s_baked.load(), s_contact.load(), s_lamps.load(), s.alpha_gpu != 0 ? 1u : 0u };
		const auto run = [&](int p, uint32_t sub, uint32_t groups_x, uint32_t groups_y) {
			constants.pass = sub;
			cl->SetComputeRoot32BitConstants(set.const_param, sizeof(constants) / 4, &constants, 0);
			cl->SetPipelineState(set.pso[p]);
			cl->Dispatch(groups_x, groups_y, 1);
			uav_barrier(cl, nullptr);
		};
		const auto stamp = [&](uint32_t k) { cl->EndQuery(s_queries, D3D12_QUERY_TYPE_TIMESTAMP, slot * k_queries_per_slot + k); };
		transition(cl, buffer, D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
		// the game's lights (v18): every light of each pixel's tile with a ray-traced shadow, into the light buffer before the
		// history keeps it
		const uint32_t tiles = std::min(s.counts_count, 4 * ((width + 63) / 64) * ((height + 15) / 16));
		stamp(7);
		if (light_passes)
		{
			cl->SetComputeRootShaderResourceView(set.counts_param, s.counts_va);
			run(pass_lights, 0, (width + 7) / 8, (height + 7) / 8);
			run(pass_light_temporal, 0, (width + 7) / 8, (height + 7) / 8);
			for (uint32_t i = 0; i < k_light_filter_passes; ++i)
				run(pass_light_filter, i, (width + 7) / 8, (height + 7) / 8);
			run(pass_light_add, 0, (width + 7) / 8, (height + 7) / 8);
			s_lights_added.fetch_add(1);
		}
		else
			lost();
		// v65: the emitters from this frame's lighting result, its lights added (v39-v64 listed them before the lighting, from the
		// buffer the game alternates: the frame two frames back with the add-on's own output in it - v64 fed that back as lamp
		// glow and it grew every frame)
		const bool lamps_listed = set.pso[pass_emit] != nullptr && set.pso[pass_emit_list] != nullptr && set.pso[pass_lamp_merge] != nullptr;
		if (lamps_listed)
		{
			run(pass_emit, 0, (width + 7) / 8, (height + 7) / 8);
			run(pass_emit_list, 0, 32 * 32, 1);               // v64: a group per cell of EMIT_GRID x EMIT_GRID (rt.hlsl)
			run(pass_lamp_merge, 0, (4096 / 8 + 63) / 64, 1); // v67: the lamps' memory, a thread per bucket (LAMP_SLOTS / LAMP_BUCKET)
		}
		// v77: NVIDIA's RTXDI after the lamps' list - the frame's RTXDI constants (every frame: the paths' bounce hits read them),
		// the lamps' power PDF and RTXDI's power-proportional RIS tiles, ReGIR's cells around the camera ("NVIDIA ReGIR"); its
		// ReSTIR DI for the primary lamps ("NVIDIA RTXDI lamps", v77 both renderers) runs in the renderer's branch below
		const bool reuse_lights = s_restir.load() > 0.5f, paths = s_full.load() > 0.0f;
		const bool rtxdi_di = paths && s_rtxdi_on.load() > 0.5f && lamps_listed && set.rt_ok && set.pso[pass_rtxdi_di] != nullptr;
		const bool rtxdi_presample = paths && lamps_listed && set.pso[pass_rtxdi_pdf] != nullptr && set.pso[pass_rtxdi_presample] != nullptr &&
			set.pso[pass_regir_build] != nullptr;
		// v86: "NVIDIA RTXDI game lights" - the game's lights (while the add-on lights them: the light passes ran) join the lamps
		const bool rtxdi_game = s_rtxdi_game.load() > 0.5f && light_passes && set.pso[pass_rtxdi_game] != nullptr;
		const uint32_t rtxdi_flags = prepare_rtxdi(width, height, frame, slot, reuse_lights, rtxdi_di, rtxdi_presample, s_regir_on.load() > 0.5f,
			rtxdi_game);
		const bool game_in_di = rtxdi_di && (rtxdi_flags & k_rtxdi_flag_game) != 0;   // v86: the renderers leave the game's lights to RTXDI
		if ((rtxdi_flags & k_rtxdi_flag_presampled) != 0)
		{
			const rtxdi_statics &statics = rtxdi_static();
			if ((rtxdi_flags & k_rtxdi_flag_game) != 0)
				run(pass_rtxdi_game, 0, 1, 1);                // v86: one group of 1024: this frame's game lights' table
			run(pass_rtxdi_pdf, 0, 1, 1);                     // one group of 32 x 32: the PDF's mip 0 and its mips
			run(pass_rtxdi_presample, 0, (statics.local_ris.tileSize + 255) / 256, statics.local_ris.tileCount);
			if ((rtxdi_flags & k_rtxdi_flag_regir) != 0)
				run(pass_regir_build, 0, (statics.regir->GetReGIRLightSlotCount() + 255) / 256, 1);
		}
		// v90: ReGIR's surface cells (regir_cells.hlsl) for the bounce hits' lamp picks - after RTXDI's presampling (the fill draws
		// from its tiles), before SHaRC's Update and the renderers (their bounce hits pick from them): insert, fill, each dispatch's
		// UAV barrier between
		const bool regir_cells = (rtxdi_flags & k_rtxdi_flag_presampled) != 0 && (rtxdi_flags & k_rtxdi_flag_regir) != 0 &&
			s_regir_cells.load() > 0.5f && set.rt_ok && set.pso[pass_regir_cells] != nullptr && set.pso[pass_regir_fill] != nullptr;
		// v93: the visibility cache (regir_vis.hlsli) with the path tracing - its upkeep before the surface cells' fill reads it
		// (the renderers' and RTXDI's shadow rays record into it this frame for the next)
		const bool regir_vis = paths && s_regir_vis_cache.load() > 0.5f && set.pso[pass_regir_vis_decay] != nullptr;
		const data_layout regir_layout = layout_for(width, height);
		prepare_regir_cells(slot, regir_cells, regir_layout.regir_cells, regir_vis, regir_layout.regir_vis);
		if (regir_vis)
			run(pass_regir_vis_decay, 0, k_regir_vis_capacity / 256, 1);                       // a thread per entry
		if (regir_cells)
		{
			run(pass_regir_cells, 0, ((width + 3) / 4 + 7) / 8, ((height + 3) / 4 + 7) / 8);   // a pixel of each 4 x 4 tile
			run(pass_regir_fill, 0, k_regir_capacity * 32 / 256, 1);                            // a thread per cell slot
			s_regir_cells_runs.fetch_add(1, std::memory_order_relaxed);
		}
		// v87: NVIDIA SHaRC (sharc.hlsl, NVIDIA's SDK) with the path tracing: its frame block (every frame), the reset when
		// prepare_sharc asks for one, then its Update (a path per 5 x 5 pixels) and Resolve (every entry) - after the lamps' and the
		// game lights' RTXDI (the Update's hits light themselves as the renderers' bounces do), before the renderers, whose bounces
		// query it; each dispatch's UAV barrier between them (NVIDIA's order: Update, barrier, Resolve, barrier, Query). v98: not
		// with the RTXPT renderer (its paths take no cached light)
		const bool sharc_nv = paths && s_sharc_nv.load() > 0.5f && s_renderer.load() != 1 && set.rt_ok && set.pso[pass_sharc_update] != nullptr &&
			set.pso[pass_sharc_resolve_nv] != nullptr && set.pso[pass_sharc_clear] != nullptr;
		if (prepare_sharc(slot, sharc_nv, buffer))
			run(pass_sharc_clear, 0, k_sharc_nv_capacity / 256, 1);
		if (sharc_nv)
		{
			run(pass_sharc_update, 0, ((width + 4) / 5 + 7) / 8, ((height + 4) / 5 + 7) / 8);   // the tiles of downscale 5 (prepare_sharc)
			run(pass_sharc_resolve_nv, 0, k_sharc_nv_capacity / 256, 1);
			s_sharc_runs.fetch_add(1, std::memory_order_relaxed);
		}
		// the path tracing over the game's result (before the history keeps it): v51 the RE9 renderer (ReSTIR DI's reservoirs
		// first); TLOU RT's own full path tracing (v19-v43) is gone. v52: or the DD2 renderer (its path, RE9's accumulation as
		// the stand-in denoiser, its composite); either one's light buffer then feeds the history and the forward relight
		bool re9 = false;
		// v68: Path reuse (reuse.hlsl, ReSTIR PT Enhanced) after either renderer's path pass, before the accumulation: the pairing
		// textures (built once; three groups that return at once after that), the shifts to the partners, the resampling
		const bool path_reuse = s_path_reuse.load() > 0.5f && set.pso[pass_reuse_pairs] != nullptr && set.pso[pass_reuse_shift] != nullptr &&
			set.pso[pass_reuse_resample] != nullptr;
		const auto run_path_reuse = [&](uint32_t renderer) {   // g_pass: 1 = DD2 (its lobes, rays, sky), 0 = RE9
			run(pass_reuse_pairs, 0, 3, 1);
			run(pass_reuse_shift, renderer, (width + 7) / 8, (height + 7) / 8);
			run(pass_reuse_resample, renderer, (width + 7) / 8, (height + 7) / 8);
		};
		// v78: Ray Reconstruction before either renderer's composite (rr_prepare): this frame's inputs (cs_rr_inputs, after the
		// accumulation's) into the slot's shared textures, RR's output of the frame before for the composite (not with a debug
		// view: its terms are this frame's own). v80: with RR upscaling in the game, cs_rr_inputs every frame and its guides
		// (albedos, normal + roughness) into in-game RR's textures - the game's DLSS evaluate of this frame reads them
		const data_layout rr_layout = layout_for(width, height);
		const auto run_rr = [&]() {
			const bool game = s_rr_up.load() > 0.5f && set.pso[pass_rr_inputs] != nullptr;
			// v81: RR denoises in the game (it upscaled within the last presents): the composites write the noisy light
			const rr_plan rr = rr_prepare(reinterpret_cast<uint64_t>(cl), frame, slot, width, height, rr_layout, s_debug_view.load() == 0,
				set.pso[pass_rr_inputs] != nullptr, game && rr_game_active());
			if (rr.inputs || game)
				run(pass_rr_inputs, 0, (width + 7) / 8, (height + 7) / 8);
			rr_copies(cl, buffer, rr, rr_layout, width, height);
			if (game)
				rr_game_guides(d, cl, buffer, rr_layout, width, height, frame);
		};
		if (s_full.load() > 0.0f && s_renderer.load() == 1)
		{
			// v98: NVIDIA RTXPT's path tracer (src\rtxpt.hlsl) in DD2's place - its path, RE9's accumulation as the stand-in
			// denoiser, its composite (v52-v97 DD2's: dd2.hlsl). No Path reuse (it shaded DD2's samples with DD2's lobes)
			re9 = set.pso[pass_rtxpt_path] != nullptr && set.pso[pass_re9_accum] != nullptr && set.pso[pass_rtxpt_composite] != nullptr &&
				set.pso[pass_re9_history] != nullptr;
			if (re9)
			{
				// g_pass: RTXPT's diffuse bounces; bit 4: ReSTIR DI's pick for the primary's lights (cs_rtxdi_di first) - v99 only
				// while Ray Reconstruction does not denoise (RTXPT's DisableReSTIRsWithDLSSRR: its NEE then; the game's lights follow
				// RTXDI's list, rtxdi.hlsli RTXDI_FRAME_GAME); v99 bit 6: Physical light falloff
				const int restir_mode = s_pt_restir.load();      // v103: ReSTIR DI (RTXPT) - off / auto / always
				const bool restir_di = rtxdi_di && (restir_mode == 2 || (restir_mode == 1 && !rr_denoising()));
				if (restir_di)
					run(pass_rtxdi_di, 0, (width + 7) / 8, (height + 7) / 8);
				// (v101: bits 8-14 Light softness in %, bits 16-19 Light samples)
				run(pass_rtxpt_path, static_cast<uint32_t>(std::clamp(s_pt_bounces.load(), 1, 7)) | (restir_di ? 16u : 0u) |
					(s_pt_physical.load() > 0.5f ? 64u : 0u) | (static_cast<uint32_t>(std::clamp(s_pt_softness.load(), 0.0f, 100.0f) + 0.5f) << 8) |
					(static_cast<uint32_t>(std::clamp(s_pt_samples.load(), 1, 8)) << 16), (width + 7) / 8, (height + 7) / 8);
				run(pass_re9_accum, 0, (width + 7) / 8, (height + 7) / 8);
				run_rr();                                      // v78
				run(pass_rtxpt_composite, static_cast<uint32_t>(std::clamp(s_debug_view.load(), 0, 9)), (width + 7) / 8, (height + 7) / 8);   // g_pass: v63 the debug view (v74: 0-6; v86: 7; v87: 8-9)
			}
		}
		else if (s_full.load() > 0.0f)
		{
			re9 = set.pso[pass_di] != nullptr && set.pso[pass_re9_path] != nullptr && set.pso[pass_re9_accum] != nullptr &&
				set.pso[pass_re9_composite] != nullptr && set.pso[pass_re9_history] != nullptr && set.pso[pass_re9_sss] != nullptr;
			if (re9)
			{
				// v67: "Reuse samples (RE9)" off - g_pass bit 0: no temporal / spatial reuse of the light samples (cs_di, di_shade in
				// cs_re9_path): fresh samples every frame, as the DD2 renderer's. v68: "Reuse light samples (RE9)", ReSTIR DI only;
				// g_pass bit 1 of cs_re9_path: Path reuse (its sample and origin kept), whose passes replace v48's ReSTIR GI
				const bool reuse = reuse_lights;
				// v76: "NVIDIA RTXDI lamps" - NVIDIA's RTXDI (rtxdi_di.hlsl) in place of the add-on's ReSTIR DI (cs_di, di_shade):
				// cs_re9_path takes its result (g_pass bit 2)
				const bool rtxdi = rtxdi_di;
				if (rtxdi)
					run(pass_rtxdi_di, 0, (width + 7) / 8, (height + 7) / 8);
				else
					run(pass_di, reuse ? 0u : 1u, (width + 7) / 8, (height + 7) / 8);
				// v83: "NVIDIA ReSTIR PT (RE9)" - the bounce from NVIDIA's ReSTIR PT (rtxdi_pt.hlsl): the initial samples, the temporal
				// resampling, the duplication map and the smoothed stagnancy (with RR's decorrelation), the final shading into the raw
				// planes and the path reuse's samples; cs_re9_path then lights the frame directly (g_pass bit 3). v84: CGNS's picks
				// and the spatial resampling after the temporal pass (ReSTIR PT neighbours above 0), and ReSTIR PT replaces Path
				// reuse here (its passes, cs_re9_path's bit 1, cs_pt_shade's sample: off while ReSTIR PT runs)
				pt_plan pt;
				if (s_rtxdi_pt.load() > 0.5f && set.pso[pass_pt_initial] != nullptr && set.pso[pass_pt_temporal] != nullptr &&
					set.pso[pass_pt_dupmap] != nullptr && set.pso[pass_pt_smooth] != nullptr && set.pso[pass_pt_shade] != nullptr)
				{
					const bool rr_on = (s_rr_up.load() > 0.5f && rr_game_active()) || s_rr.load() > 0.5f;
					const bool spatial_ok = set.pso[pass_pt_neighbors] != nullptr && set.pso[pass_pt_spatial] != nullptr;
					pt = prepare_rtxdi_pt(width, height, frame, slot, rr_on, spatial_ok ? static_cast<uint32_t>(std::clamp(s_pt_spatial.load(), 0, 4)) : 0u);
				}
				if (pt.ok)
				{
					run(pass_pt_initial, 0, (width + 7) / 8, (height + 7) / 8);
					if (pt.spatial)
						run(pass_pt_neighbors, 0, (width + 7) / 8, (height + 7) / 8);
					run(pass_pt_temporal, 0, (width + 7) / 8, (height + 7) / 8);
					if (pt.spatial)
						run(pass_pt_spatial, 0, (width + 7) / 8, (height + 7) / 8);
					if (pt.dupmap)
						run(pass_pt_dupmap, 0, (width + 15) / 16, (height + 15) / 16);
					if (pt.smooth)
						run(pass_pt_smooth, 0, (width + 7) / 8, (height + 7) / 8);
					run(pass_pt_shade, 0, (width + 7) / 8, (height + 7) / 8);
					s_pt_frames.fetch_add(1, std::memory_order_relaxed);
				}
				const bool path_reuse_re9 = path_reuse && !pt.ok;    // v84
				// v86 g_pass bit 4: the game's lights come with RTXDI's lamps (cs_rtxdi_di), no per-light loop in cs_re9_path
				run(pass_re9_path, (reuse ? 0u : 1u) | (path_reuse_re9 ? 2u : 0u) | (rtxdi ? 4u : 0u) | (pt.ok ? 8u : 0u) | (game_in_di ? 16u : 0u),
					(width + 7) / 8, (height + 7) / 8);
				if (path_reuse_re9)
					run_path_reuse(0u);
				run(pass_re9_accum, 0, (width + 7) / 8, (height + 7) / 8);
				run(pass_re9_sss, 0, (width + 7) / 8, (height + 7) / 8);                   // v47: the skin blur's first pass
				run_rr();                                      // v78
				run(pass_re9_composite, static_cast<uint32_t>(std::clamp(s_debug_view.load(), 0, 10)), (width + 7) / 8, (height + 7) / 8);   // v74: g_pass the debug view (v86: 0-7; v87: 0-9; v90: 0-10)
			}
		}
		stamp(8);
		if (re9)
			run(pass_re9_history, 1u, (width + 7) / 8, (height + 7) / 8);   // g_pass 1: SHaRC keeps the game's light (v64 DD2; v71 both renderers: their bounces are DD2's)
		if (re9 && set.pso[pass_re9_ratio] != nullptr)
		{
			run(pass_re9_ratio, 0, (width + 15) / 16, (height + 15) / 16);   // v50: the forward relight's reference (relight)
			s_relight_frame.store(frame);                      // v72: the relight's gate counts frames
			s_relight_present.store(s_present_index.load());
		}
		if (!sharc_nv && set.pso[pass_sharc_resolve] != nullptr)   // v23: SHaRC's samples of this frame (rays, camera view) resolved
			run(pass_sharc_resolve, 0, static_cast<uint32_t>(k_sharc_capacity / 64), 1);   // (v87: v23's own, NVIDIA SHaRC off)

		// Numpad - captures the lighting's inputs through its own bindings (t4 / t5: the add-on's rewritten ambient)
		bool dump_now = false;                             // v95: this frame's capture - the lamps' region is copied below
		if (s_dump_state.load() == dump_requested && set.pso[pass_dump] != nullptr)
		{
			s_dump = create_buffer(d, k_dump_bytes, D3D12_HEAP_TYPE_DEFAULT, D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COMMON);
			s_dump_readback = create_buffer(d, k_dump_bytes, D3D12_HEAP_TYPE_READBACK, D3D12_RESOURCE_FLAG_NONE, D3D12_RESOURCE_STATE_COPY_DEST);
			if (s_dump == nullptr || s_dump_readback == nullptr)
			{
				release(s_dump);
				release(s_dump_readback);
				s_dump_message = "capture failed: could not create its buffers";
				s_dump_state = dump_idle;
			}
			else
			{
				transition(cl, s_dump, D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
				transition(cl, s_geo.load(), D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);   // the ray view reads materials
				cl->SetComputeRootUnorderedAccessView(set.uav_param, s_dump->GetGPUVirtualAddress());
				for (uint32_t k = 0; k < k_dump_slots; ++k)
					run(pass_dump, k, static_cast<uint32_t>(k_dump_w / 8), static_cast<uint32_t>(k_dump_h / 8));
				if (light_passes && set.pso[pass_dump_lights] != nullptr)
					run(pass_dump_lights, 0, (tiles * 16 + 63) / 64, 1);   // the lights the tiles name (v18)
				transition(cl, s_geo.load(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COMMON);
				transition(cl, s_dump, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COPY_SOURCE);
				cl->CopyBufferRegion(s_dump_readback, 0, s_dump, 0, k_dump_bytes - k_dump_lamp_bytes);   // (v95: the lamps from Data below)
				transition(cl, s_dump, D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_COMMON);
				cl->SetComputeRootUnorderedAccessView(set.uav_param, buffer->GetGPUVirtualAddress());
				s_dump_present = s_present_index.load();
				s_dump_frame = frame;                          // v95
				dump_now = true;
				s_dump_state = dump_waiting;
				s_dump_message = "capture: recorded, writing it in a moment...";
				log(reshade::log::level::info, "TLOU RT v%d: lighting inputs captured (%ux%u)", TLOU_RT_VERSION, width, height);
			}
		}

		transition(cl, buffer, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COPY_SOURCE);
		if (dump_now)                                      // v95: the lamps (lamps.bin / lamps.txt)
			cl->CopyBufferRegion(s_dump_readback, k_dump_bytes - k_dump_lamp_bytes, buffer, layout_for(width, height).lamps, k_dump_lamp_bytes);
		cl->CopyBufferRegion(s_readback, slot * k_readback_bytes, buffer, k_stats_offset, k_stats * 4);   // STATS in rt.hlsl
		cl->CopyBufferRegion(s_readback, slot * k_readback_bytes + k_readback_frame_info, buffer, 160, 16);   // v68: FRAME_INFO in rt.hlsl
		cl->CopyBufferRegion(s_readback, slot * k_readback_bytes + k_readback_auto_pbr, buffer, 1024, 32);   // v82: FRAME_AUTO_PBR in rt.hlsl
		cl->CopyBufferRegion(s_readback, slot * k_readback_bytes + k_readback_pt, buffer, 1056, k_readback_pt_bytes);   // v83: FRAME_PT in rt.hlsl
		cl->CopyBufferRegion(s_readback, slot * k_readback_bytes + k_readback_regir, buffer, 1104, 32);   // v90: FRAME_REGIR in rt.hlsl
		cl->ResolveQueryData(s_queries, D3D12_QUERY_TYPE_TIMESTAMP, slot * k_queries_per_slot, k_timestamps, s_readback, slot * k_readback_bytes + k_readback_timestamps);
		transition(cl, buffer, D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_COMMON);
	}

	void on_close_command_list(command_list *cmd)
	{
		list_state &s = state_of(cmd);
		if (s.so)
		{
			// This list's stream-out writes are done: back to COMMON (the buffer entered STREAM_OUT by implicit promotion in
			// this list), so the lighting list can take it to UNORDERED_ACCESS whether it runs in the same submission or not
			s.so = false;
			s.streamed = true;
			if (ID3D12Resource *const geo = s_geo.load())
				transition(reinterpret_cast<ID3D12GraphicsCommandList *>(cmd->get_native()), geo, D3D12_RESOURCE_STATE_STREAM_OUT, D3D12_RESOURCE_STATE_COMMON);
		}
		if (!s.inject)
			return;
		s.inject = false;
		post_lighting(cmd, s);
	}

	// ---- capture of the lighting's inputs: written by the present thread once the GPU is done (s_rt_mutex held) ----

	void write_dump()
	{
		SYSTEMTIME st;
		GetLocalTime(&st);
		const std::string stamp = strf("%04u%02u%02u-%02u%02u%02u", st.wYear, st.wMonth, st.wDay, st.wHour, st.wMinute, st.wSecond);
		wchar_t module_path[MAX_PATH] = {};
		GetModuleFileNameW(nullptr, module_path, MAX_PATH);
		std::wstring dir = module_path;
		dir.erase(dir.find_last_of(L"\\/") + 1);
		dir += L"rt-recon\\";
		CreateDirectoryW(dir.c_str(), nullptr);
		dir += L"inputs-" + std::wstring(stamp.begin(), stamp.end()) + L"\\";
		CreateDirectoryW(dir.c_str(), nullptr);
		const auto write = [&](const wchar_t *name, const void *data, size_t size) {
			FILE *f = nullptr;
			if (_wfopen_s(&f, (dir + name).c_str(), L"wb") != 0 || f == nullptr)
				return false;
			const bool ok = std::fwrite(data, 1, size, f) == size;
			std::fclose(f);
			return ok;
		};
		std::string manifest = strf("==== TLOU RT v%d: CS_DeferredLighting's inputs %s ====\n", TLOU_RT_VERSION, stamp.c_str());
		manifest += "dump.bin: per slot uint4(width, height, downscale, kind 0 = half4 / 1 = uint4) at slot * 16, the lighting constants c[0..84] (float4) from byte 1024, "
			"then from byte 4096 the 13 float slots (1280x720 half4 texels each; slot 12 = raw float depth in the first 4 bytes) and the 3 uint slots (1280x720 uint4). "
			"Read through the lighting's own bindings right after it ran (decode_inputs.py). lights.txt / lights.bin: the lights the lighting's tiles named "
			"(only when the add-on lit the frame). v95: lamps.txt / lamps.bin: the add-on's lamps (its memory of the emissive surfaces seen, "
			"the lists the rays took this frame).\n\n";
		void *mapped = nullptr;
		const D3D12_RANGE range = { 0, static_cast<SIZE_T>(k_dump_bytes) };
		bool ok = SUCCEEDED(s_dump_readback->Map(0, &range, &mapped));
		std::string lights;
		uint32_t named = 0;
		if (ok)
		{
			const uint32_t *const header = static_cast<const uint32_t *>(mapped);
			for (uint32_t k = 0; k < k_dump_slots; ++k)
				manifest += strf("slot %2u  %-38s %ux%u downscale %u %s\n", k, k_dump_names[k], header[k * 4], header[k * 4 + 1], header[k * 4 + 2], header[k * 4 + 3] ? "uint4" : "half4");
			ok = write(L"dump.bin", mapped, static_cast<size_t>(k_dump_slot_bytes));
			// v18: the lights the tiles named (cs_dump_lights), raw (lights.bin: 448 bytes per index, 436 = the game's struct,
			// then 1 when named and the number of tile entries) and decoded (lights.txt; field names from rt.hlsl LightDesc)
			const uint8_t *const base = static_cast<const uint8_t *>(mapped) + k_dump_slot_bytes;
			ok &= write(L"lights.bin", base, static_cast<size_t>(k_dump_lights) * k_dump_light_bytes);
			for (uint32_t i = 0; i < k_dump_lights; ++i)
			{
				const uint8_t *const r = base + UINT64(i) * k_dump_light_bytes;
				const auto u = [r](uint32_t at) { uint32_t v; std::memcpy(&v, r + at, 4); return v; };
				const auto f = [r](uint32_t at) { float v; std::memcpy(&v, r + at, 4); return static_cast<double>(v); };
				if (u(436) == 0)
					continue;
				++named;
				const uint32_t flags = u(32);
				lights += strf("light %4u: type %u kind %u flags 0x%08X, %u tile entries | position %.2f %.2f %.2f | colour %.4g %.4g %.4g | falloff %.4g %.4g %.4g %.4g cubic %.4g | "
					"near %.3g fade %.3g | axis %.3f %.3f %.3f | cone %.4g %.4g, second %.4g %.4g\n", i, flags & 15u, (flags >> 9) & 7u, flags, u(440), f(64), f(68), f(72), f(36), f(40), f(44),
					f(48), f(52), f(56), f(60), f(104), f(76), f(216), f(80), f(84), f(88), f(96), f(100), f(192), f(196));
				lights += strf("            radius %.4g | shadow map %d | cookie %u (a %.4g %.4g %.4g %.4g, b %.4g %.4g %.4g %.4g) | min roughness %.3g, specular %.3g | box %.4g %.4g %.4g | "
					"mask %.3f %.3f %.3f, %.3g to %.3g | cull centre %.2f %.2f %.2f radius %.3g\n", f(412), static_cast<int>(u(108)), u(92), f(240), f(244), f(248), f(252), f(256), f(260),
					f(264), f(268), f(200), f(204), f(400), f(404), f(408), f(416), f(420), f(424), f(432), f(428), f(0), f(4), f(8), f(12));
			}
			// v95: the lamps (rt.hlsl cs_lamp_merge) - lamps.bin raw (k_dump_lamp_bytes from emit_list_base), lamps.txt every live
			// slot of the lamps' memory by power, camera-relative, with its age and whether this frame's list holds it
			const uint8_t *const lamp_base = static_cast<const uint8_t *>(mapped) + (k_dump_bytes - k_dump_lamp_bytes);
			ok &= write(L"lamps.bin", lamp_base, static_cast<size_t>(k_dump_lamp_bytes));
			{
				const auto lu = [lamp_base](UINT64 at) { uint32_t v; std::memcpy(&v, lamp_base + at, 4); return v; };
				const auto lf = [lamp_base](UINT64 at) { float v; std::memcpy(&v, lamp_base + at, 4); return static_cast<double>(v); };
				float cam[3];
				std::memcpy(cam, static_cast<const uint8_t *>(mapped) + 1024 + 9 * 16, sizeof(cam));   // c[9]: the camera (world)
				const uint32_t parity = s_dump_frame & 1u;
				struct lamp_row { double power; std::string text; };
				std::vector<lamp_row> rows;
				for (uint32_t i = 0; i < 4096; ++i)
				{
					const UINT64 at = k_dump_lamp_memory + UINT64(i) * 96;
					if (lu(at) == 0)
						continue;
					const double x = lf(at + 8) - cam[0], y = lf(at + 12) - cam[1], z = lf(at + 16) - cam[2];
					const double r = lf(at + 24), g = lf(at + 28), b = lf(at + 32), area = lf(at + 36);
					const uint32_t packed = lu(at + 20);           // rt.hlsl unpack_normal: octahedral, 16 bits a coordinate
					const double ox = (packed & 0xFFFFu) * (2.0 / 65535.0) - 1.0, oy = (packed >> 16) * (2.0 / 65535.0) - 1.0;
					double nx = ox, ny = oy, nz = 1.0 - std::abs(ox) - std::abs(oy);
					if (nz < 0.0)
					{
						nx = (1.0 - std::abs(oy)) * (ox >= 0.0 ? 1.0 : -1.0);
						ny = (1.0 - std::abs(ox)) * (oy >= 0.0 ? 1.0 : -1.0);
					}
					const double nl = std::sqrt(nx * nx + ny * ny + nz * nz);
					if (nl > 0.0)
					{
						nx /= nl;
						ny /= nl;
						nz /= nl;
					}
					const uint32_t map = lu(k_dump_lamp_maps + parity * 4096 * 4 + UINT64(i) * 4) & 0x7FFFFFFFu;
					const double power = (0.2126 * r + 0.7152 * g + 0.0722 * b) * area;
					rows.push_back({ power, strf("lamp %4u: %s | at %+.2f %+.2f %+.2f (%.1f m) | facing %+.2f %+.2f %+.2f | radiance %.4g %.4g %.4g | area %.4g m2, power %.4g | "
						"last seen %u frames ago, held %u frames, dark %u frames (v102: fades past 15)%s\n", i, map != 0 ? strf("listed #%u", map - 1).c_str() : "not listed", x, y, z, std::sqrt(x * x + y * y + z * z),
						nx, ny, nz, r, g, b, area, power, s_dump_frame - lu(at + 4), lu(at + 40) != 0 ? s_dump_frame + 1 - lu(at + 40) : 0u, lu(at + 44) & 0x7FFFFFFFu,
						(lu(at + 44) & 0x80000000u) != 0 ? " | hidden from the camera (v105: x0.1 in RTXDI's PDF)" : "") });
				}
				std::sort(rows.begin(), rows.end(), [](const lamp_row &a, const lamp_row &b) { return a.power > b.power; });
				std::string text = strf("==== TLOU RT v%d: the lamps' memory %s (frame %u): %zu remembered, %u listed this frame; camera %.2f %.2f %.2f "
					"(positions below relative to it); by power (radiance luminance x area) ====\n", TLOU_RT_VERSION, stamp.c_str(), s_dump_frame, rows.size(),
					lu(parity * k_dump_emit_list_bytes), cam[0], cam[1], cam[2]);
				for (const lamp_row &row : rows)
					text += row.text;
				ok &= write(L"lamps.txt", text.data(), text.size());
			}
			const D3D12_RANGE none = { 0, 0 };
			s_dump_readback->Unmap(0, &none);
		}
		if (ok)
		{
			const std::string text = strf("==== TLOU RT v%d: the lights the lighting's tiles named %s: %u (indices below %u) ====\n", TLOU_RT_VERSION, stamp.c_str(), named, k_dump_lights) + lights;
			ok &= write(L"lights.txt", text.data(), text.size());
		}
		manifest += "\nTaken after the lighting: t4 / t5 hold the add-on's rewritten ambient (G-buffer render targets 4 / 5).\n";
		manifest += strf("\nThe lighting's inputs this frame through its descriptors (what the add-on wrote into): t4 %p (G-buffer render target 4: %p), "
			"t5 %p (target 5: %p), t10 %p (sun shadow mask), t18 %p (reflections)\n",
			reinterpret_cast<void *>(s_resolved[0].load()), reinterpret_cast<void *>(s_gbuffer_res[4].load()), reinterpret_cast<void *>(s_resolved[1].load()),
			reinterpret_cast<void *>(s_gbuffer_res[5].load()), reinterpret_cast<void *>(s_resolved[2].load()), reinterpret_cast<void *>(s_resolved[3].load()));
		ok &= write(L"manifest.txt", manifest.data(), manifest.size());
		release(s_dump);
		release(s_dump_readback);
		s_dump_state = dump_idle;
		s_dump_message = ok ? "last capture: rt-recon\\inputs-" + stamp : std::string("capture failed while writing (see ReShade.log)");
		log(ok ? reshade::log::level::info : reshade::log::level::error, "TLOU RT v%d: lighting inputs %s to rt-recon\\inputs-%s", TLOU_RT_VERSION, ok ? "written" : "NOT written", stamp.c_str());
	}

	// ---- status line (present thread): stats and timings of a frame a few presents back ----

	void update_rt_status()
	{
		std::string lines[6];
		std::string light_period;
		uint32_t env_bound = 0;
		bool rt_lines = true;
		{
			const uint32_t lit = s_lists_lit.exchange(0), written = s_ambient_written.exchange(0);
			const int skip = s_last_skip.exchange(skip_none);
			const uint32_t off = s_lights_off.exchange(0), added = s_lights_added.exchange(0), lost = s_lights_lost.exchange(0);
			const int light_skip = s_light_skip.exchange(light_skip_none);
			env_bound = s_env_bound.exchange(0);
			if (s_light_shadows.load() <= 0.0f && s_full.load() <= 0.0f)
				light_period = "Light shadows 0: the game's own lights and shadow maps";
			else
				light_period = strf("the game's light loop off in %u of %u lighting lists, lit by the add-on in %u (%u without lights)%s%s", off, lit, added, lost,
					off < written && light_skip > light_skip_none ? " - left on last time: " : "", off < written && light_skip > light_skip_none ? k_light_skip_names[light_skip] : "");
			const std::string skipped = written < lit && skip > skip_none && skip <= skip_geometry ? std::string(" (last skip: ") + k_skip_names[skip] + ")" : std::string();
			const std::lock_guard<std::mutex> lock(s_rt_mutex);
			uint32_t found[k_lighting_inputs], wrote[k_lighting_inputs];
			for (uint32_t i = 0; i < k_lighting_inputs; ++i)
			{
				found[i] = s_input_found[i].exchange(0);
				wrote[i] = s_input_written[i].exchange(0);
			}
			lines[3] = strf("path traced into the lighting in %u of %u lists%s | the lighting's inputs found / written: t4 %u / %u, t5 %u / %u, t10 sun shadows %u / %u, t18 reflections %u / %u%s | %s",
				written, lit, skipped.c_str(), found[0], wrote[0], found[1], wrote[1], found[2], wrote[2], found[3], wrote[3],
				found[3] != 0 && wrote[3] == 0 ? " (reflections: their state not seen yet)" : "", s_dump_message.c_str());
			// v26: the scene's draws per lighting (min / median / max), collapsed epochs that reused the last scene, other passes
			std::vector<uint32_t> draws;
			draws.swap(s_scene_draws);
			std::sort(draws.begin(), draws.end());
			{
				const uint32_t mv = s_main_view.load(), ov = s_skip_view_size.load();
				lines[3] += strf(" | views: main %ux%u, %llu depth-pass draws of other views left out (last %ux%u)", mv >> 16, mv & 0xFFFFu,
					static_cast<unsigned long long>(s_skip_view.exchange(0)), ov >> 16, ov & 0xFFFFu);
			}
			{
				// v36: the queues (graphics: the direct queue)
				const auto queue_name = [](uint32_t type) { return (type & 1u) != 0 ? "the direct queue" : (type & 2u) != 0 ? "a compute queue" : type != 0 ? "another queue" : "none seen"; };
				const uint64_t qd = s_queue_depth.load(), ql = s_queue_lighting.load();
				lines[3] += strf(" | queues: depth pass on %s, lighting on %s (%s), %u changes of the depth pass's queue", queue_name(s_queue_depth_type.load()),
					queue_name(s_queue_lighting_type.load()), qd != 0 && qd == ql ? "the same" : "not the same", s_queue_depth_changes.exchange(0));
			}
			lines[3] += strf(" | scene: %zu lightings, draws min %u / median %u / max %u, %.0f retained from the frame before (mean), %u kept the last scene (empty epoch), %u lighting passes at another size left alone",
				draws.size(), draws.empty() ? 0u : draws.front(), draws.empty() ? 0u : draws[draws.size() / 2], draws.empty() ? 0u : draws.back(),
				draws.empty() ? 0.0 : double(s_retained_sum.exchange(0)) / draws.size(),
				s_scene_reused.exchange(0), s_other_lighting.load());
			{
				// v72: presents per frame the game renders (2 or more: DLSS frame generation), which the windows counted in presents scale by
				const uint32_t k = s_presents_per_frame.load(std::memory_order_relaxed);
				lines[3] += strf(" | presents per frame: %u%s", k, k > 1 ? " (frame generation)" : "");
			}
		}
		{
			const std::lock_guard<std::mutex> lock(s_rt_mutex);
			const uint32_t frame = s_frame.load();
			if (s_rt_state < 0 || s_rt_support.load() < 0)
				lines[0] = "hardware ray tracing unavailable (see ReShade.log): screen-space rays";
			else if (s_rt_state > 0 && frame >= 4)
			{
				const uint32_t f = frame - 4;
				const slot_info &info = s_slot_info[f % k_ring];
				const uint8_t *const rb = s_readback_ptr + (f % k_ring) * k_readback_bytes;
				uint32_t stats[k_stats];
				uint64_t ts[k_timestamps];
				std::memcpy(stats, rb, sizeof(stats));
				std::memcpy(ts, rb + k_readback_timestamps, sizeof(ts));
				const double ms = s_timestamp_frequency.load() != 0 ? 1000.0 / s_timestamp_frequency.load() : 0.0;
				const auto span = [&](int a, int b) { return ts[b] > ts[a] ? (ts[b] - ts[a]) * ms : 0.0; };
				if (info.frame != f)
					lines[0] = "hardware ray tracing: no frame yet";
				else if (!info.built)
					lines[0] = strf("hardware ray tracing: no geometry this frame (%u draws, %u clones) - screen-space rays", info.draws, static_cast<unsigned>(s_clones.load()));
				else
				{
					lines[0] = strf("RT scene: %.2fM triangles, %u of %u draws traced (%u incomplete, %u without BLAS memory; %u cut-out cards left to the camera rays), %zu BLAS cached: %.0f MB used of %.0f MB, geometry %.0f MB",
						stats[0] / 1e6, info.traced, info.draws, stats[1], info.no_memory, stats[33], s_entry_count, s_blas_used / 1048576.0, s_arena_total / 1048576.0, k_geo_bytes / 1048576.0);
					uint32_t kept_in = 0;                      // v94: FRAME_KEPT in rt.hlsl (FRAME_REGIR + 24, read back with that block)
					std::memcpy(&kept_in, rb + k_readback_regir + 24, sizeof(kept_in));
					if (info.kept != 0)
						lines[0] += strf(" | remembered geometry (v94): %u of the %u objects the game no longer draws are in the shadow rays' scene (still for %u+ frames; kept %.0f s)",
							kept_in, info.kept, k_keep_still_frames, s_keep_seconds.load());
					const uint32_t rays = stats[2] + stats[3] + stats[4] + stats[5];
					const double pc = rays != 0 ? 100.0 / rays : 0.0;
					lines[1] = strf("camera-ray check: %.1f%% on the surface, %.1f%% in front (cut-outs), %.1f%% behind, %.1f%% missed | late draws: %u of the frame's %u placed with the frame before's camera (they ran before its lighting)",
						stats[2] * pc, stats[3] * pc, stats[4] * pc, stats[5] * pc, stats[6], info.traced);
					// v20: cs_motion (STAT_MOTION_* in rt.hlsl)
					const uint32_t motion_px = stats[28] + stats[29] + stats[30];
					const double mp = motion_px != 0 ? 100.0 / motion_px : 0.0;
					lines[1] += strf(" | motion: %.1f%% of surface pixels on moving triangles, %.1f%% still, %.1f%% camera only", stats[28] * mp, stats[29] * mp, stats[30] * mp);
					// v30: the cut-outs' masks
					const uint64_t adraws = s_alpha_draws.exchange(0), aresolved = s_alpha_resolved.exchange(0), aroom = s_alpha_no_uv_space.exchange(0);
					lines[1] += strf(" | cut-out masks: %u depth shaders with one (%u without coordinates; %u custom-depth shaders solid), %llu of %llu draws found theirs, %llu without room for coordinates, %s",
						s_alpha_pipelines.load(), s_alpha_clone_failed.load(), s_custom_depth_pipelines.load(), static_cast<unsigned long long>(aresolved), static_cast<unsigned long long>(adraws),
						static_cast<unsigned long long>(aroom), s_alpha_heap.load() != 0 ? "heap known" : "heap not seen yet");
					// v31: the rays' mask tests (one cut-out triangle in 16), and the lists' heap checks (v35: the fallbacks in one)
					const double ac = stats[42] != 0 ? 100.0 / stats[42] : 0.0;
					lines[1] += strf(" | mask tests: %u sampled - %.1f%% fell back (no mask, heap off, incomplete, not a texture), %.1f%% solid texel | heap check in lists: %u same, %u other heap, %u none yet",
						stats[42], stats[46] * ac, stats[47] * ac,
						s_alpha_lists_ok.exchange(0), s_alpha_lists_other.exchange(0), s_alpha_lists_none.exchange(0));
						lines[1] += strf(" | late or retained cut-outs this frame: %u read their mask through this frame's slot, %u without one (light through)", stats[48], stats[49]);
						// v55: the camera rays' votes on the masks (cs_motion; STAT_MASK_VOTES / STAT_MASK_DISAGREE in rt.hlsl)
						lines[1] += strf(" | mask votes: %u, %.1f%% disagreeing with the depth buffer", stats[40], stats[40] != 0 ? 100.0 * stats[41] / stats[40] : 0.0);
					lines[2] = strf("GPU ms: convert %.2f, BLAS %.2f (%u built, %u refit), TLAS %.2f, material + trace %.2f, filter + ambient %.2f, check %.2f | CPU ms %.2f",
						span(0, 1), span(1, 2), info.builds, info.refits, span(2, 3), span(3, 4), span(4, 5), span(5, 6), info.cpu_ms);
					const double samples = stats[12] != 0 ? 1.0 / (1024.0 * stats[12]) : 0.0;
					lines[4] = strf("material cache: %.1f%% of bounce hits on a triangle the camera has seen (%u hits), %u pixels sampled this frame (mean albedo %.3f %.3f %.3f), %.1fM of %uM slots",
						stats[8] != 0 ? 100.0 * stats[7] / stats[8] : 0.0, stats[8], stats[13], stats[9] * samples, stats[10] * samples, stats[11] * samples,
						s_material_used / 1048576.0, k_material_slots >> 20);
					// v82: the auto-PBR layer's estimates against the game's own values (adapter.hlsl cs_adapt into FRAME_AUTO_PBR:
					// |error| x 1024 per channel - F0 x 10240 - and the pixels compared)
					uint32_t auto_pbr[5];
					std::memcpy(auto_pbr, rb + k_readback_auto_pbr, sizeof(auto_pbr));
					if (auto_pbr[4] != 0)
					{
						const double e = 1.0 / (1024.0 * auto_pbr[4]);
						lines[4] += strf(" | auto-PBR vs the game's (%u pixels%s): roughness |error| %.3f, metalness %.3f, F0 %.4f, normals 1 - cos %.3f",
							auto_pbr[4], s_auto_pbr_force.load() != 0.0f ? ", forced in use" : "", auto_pbr[0] * e, auto_pbr[1] * e, auto_pbr[2] * e * 0.1, auto_pbr[3] * e);
					}
					// v23: SHaRC (STAT_SHARC_* in rt.hlsl); v87: NVIDIA SHaRC's in the same counters (sharc.hlsl, sharc.hlsli: its lookups
					// are the bounce hits past its segment and footprint gates; its Update's path vertices and camera samples)
					if (s_sharc_was_on.load())
						lines[4] += strf(" | NVIDIA SHaRC: %u live entries of %uM, light found at %.1f%% of the unseen hits past its gates (%u lookups), "
							"%u path vertices + %u camera samples submitted; %u frames",
							stats[39], k_sharc_nv_capacity >> 20, stats[34] != 0 ? 100.0 * stats[35] / stats[34] : 0.0, stats[34], stats[36], stats[37],
							s_sharc_runs.load(std::memory_order_relaxed));
					else
						lines[4] += strf(" | SHaRC: %u live voxels of %uM, light found at %.1f%% of unseen hits (%u lookups), %u ray + %u camera samples, %u dropped",
							stats[39], static_cast<unsigned>(k_sharc_capacity >> 20), stats[34] != 0 ? 100.0 * stats[35] / stats[34] : 0.0, stats[34], stats[36], stats[37], stats[38]);
					// v35: the add-on's sky (cs_sky), and how many escaping rays took it (Baked light below 1)
					if (stats[45] == 0xFFFFFFFFu)
						lines[4] += strf(" | sky: none yet (no open sky seen; the baked ambient stays) - open pixels now %.1f", stats[43] / 100.0);
					else
						lines[4] += strf(" | sky: luminance %.3f toward the zenith, %s, %.1f open pixels now", stats[44] / 1000.0,
							stats[45] == 0 ? "updated this frame" : strf("last updated %u frames ago", stats[45]).c_str(), stats[43] / 100.0);
					// v18: the game's lights (STAT_LIGHTS ... in rt.hlsl)
					const uint32_t named = stats[14], lit_pixels = stats[24];
					const double pixels = double(s_width.load()) * s_height.load();
					lines[5] = strf("game lights: %u named by %u tiles (%u point, %u spot, %u box; %u with shadow maps, near planes %.0f-%.0f cm; %u with cookies; radius mean %.1f cm, max %.1f cm) | %.1f%% of pixels lit "
						"(%.1f lights each), %.1f%% of them mostly shadowed, %u of them on characters | GPU ms %.2f",
						named, stats[22], stats[15], stats[16], stats[17], stats[18], stats[32] != 0 ? static_cast<uint32_t>(~stats[32]) / 10.0 : 0.0, stats[31] / 10.0, stats[19],
						named != 0 ? stats[20] / 10.0 / named : 0.0, stats[21] / 10.0,
						pixels > 0.0 ? 100.0 * lit_pixels / pixels : 0.0, lit_pixels != 0 ? double(stats[25]) / lit_pixels : 0.0, lit_pixels != 0 ? 100.0 * stats[26] / lit_pixels : 0.0,
						stats[27], span(7, 8));
						// v39: the emitters (v66: the game's own emission, G-buffer render target 6)
						lines[5] += strf(" | lamps (v67): %u emissive pixels (%.1f%% - the game's own emission), %u lamps remembered within 40 m (%u seen now)",
							stats[50], pixels > 0.0 ? 100.0 * stats[50] / pixels : 0.0, stats[51] & 0xFFFFu, stats[51] >> 16);
						// v68: the path reuse's counters (reuse.hlsl cs_reuse_resample into FRAME_INFO y, z, w)
						uint32_t reuse[4];
						std::memcpy(reuse, rb + k_readback_frame_info, sizeof(reuse));
						// v83: NVIDIA ReSTIR PT's counters (rtxdi_pt.hlsl into FRAME_PT): pixels, samples from last frame, decorrelated,
						// firefly-flagged; the final samples' summed age, reconnected at their hit, replayed, sky; v84: the paths taken
						// from a neighbour, CGNS's neighbours found
						uint32_t pt[12];
						static_assert(sizeof(pt) == k_readback_pt_bytes, "FRAME_PT's counters");
						std::memcpy(pt, rb + k_readback_pt, sizeof(pt));
						if (s_path_reuse.load() > 0.5f && s_full.load() > 0.0f)
						{
							if (pt[0] != 0 && s_renderer.load() != 1)   // v84: the RE9 renderer's bounce is ReSTIR PT's
								lines[5] += " | path reuse (v68): replaced by NVIDIA ReSTIR PT";
							else
								lines[5] += strf(" | path reuse (v68): %.1f%% of pixels resampled, %.2f of 3 partners accepted, %.2f of them brought light",
									pixels > 0.0 ? 100.0 * reuse[1] / pixels : 0.0, reuse[1] != 0 ? double(reuse[2]) / reuse[1] : 0.0,
									reuse[1] != 0 ? double(reuse[3]) / reuse[1] : 0.0);
						}
						if (pt[0] != 0)
						{
							const double pp = 100.0 / pt[0];
							const uint32_t kept = pt[5] + pt[6] + pt[7];
							const int neighbours = std::clamp(s_pt_spatial.load(), 0, 4);
							lines[5] += strf(" | ReSTIR PT (v84): %.1f%% of pixels kept last frame's path, %.1f%% took a neighbour's (CGNS: %.2f of %d "
								"neighbours found); the final paths' mean age %.1f frames, %.1f%% reconnected at their hit, %.1f%% replayed, %.1f%% sky; "
								"%.1f%% decorrelated for RR, %.2f%% firefly-flagged; %u frames",
								pt[1] * pp, pt[8] * pp, double(pt[9]) / pt[0], neighbours, kept != 0 ? double(pt[4]) / kept : 0.0, pt[5] * pp, pt[6] * pp,
								pt[7] * pp, pt[2] * pp, pt[3] * pp, s_pt_frames.load(std::memory_order_relaxed));
						}
						// v86: the bounce noise (re9.hlsl cs_re9_accum into FRAME_PT + 40 / + 44): this frame's bounce sample against the
						// settled accumulated light, the mean relative deviation - ReSTIR PT on and off alike (the image does not show it)
						if (pt[11] != 0)
							lines[5] += strf(" | bounce noise (v86): %.1f%% per frame at %.0f%% of the pixels (this frame's sample against the settled light; %s)",
								pt[10] / 10.0 / pt[11], pixels > 0.0 ? 100.0 * pt[11] / pixels : 0.0, pt[0] != 0 ? "ReSTIR PT" :
								s_path_reuse.load() > 0.5f ? "path reuse" : "one path");
						// v90: ReGIR's surface cells (regir_cells.hlsli into FRAME_REGIR): cells in use, the bounce hits' picks from a cell /
						// from the onion, insertions refused (the table full)
						uint32_t rg[8];                            // (v93: + the visibility cache's entries in use, rays recorded)
						std::memcpy(rg, rb + k_readback_regir, sizeof(rg));
						if (rg[0] != 0 || rg[2] != 0)
							lines[5] += strf(" | ReGIR surface cells (v90): %u of %uK in use, %.1f%% of the bounce hits' light picks from a cell (%u; %u from the onion)%s",
								rg[0], k_regir_capacity >> 10, rg[1] + rg[2] != 0 ? 100.0 * rg[1] / (rg[1] + rg[2]) : 0.0, rg[1], rg[2],
								rg[3] != 0 ? strf(", %u insertions refused", rg[3]).c_str() : "");
						if (rg[4] != 0 || rg[5] != 0)
							lines[5] += strf(" | ReGIR visibility cache (v93): %u of %uK pairs (surface, light), %u shadow rays recorded this frame",
								rg[4], k_regir_vis_capacity >> 10, rg[5]);
				}
				const uint64_t skipped = s_skip_space.load() + s_skip_args.load() + s_skip_clone.load();
				if (skipped != 0)
				{
					const uint64_t largest = s_skip_largest.exchange(0);   // v28: since the last status
					lines[2] += strf(" | draws not streamed: %llu (space %llu, arguments %llu, clone %llu; largest left out lately: %.2fM vertices, %u instances)", static_cast<unsigned long long>(skipped),
						static_cast<unsigned long long>(s_skip_space.load()), static_cast<unsigned long long>(s_skip_args.load()), static_cast<unsigned long long>(s_skip_clone.load()),
						(largest >> 32) / 1e6, static_cast<unsigned>(largest & 0xFFFFFFFFu));
				}
			}
			else
				rt_lines = false;
		}
		{
			const uint64_t calls = s_copy_calls.exchange(0), descriptors = s_copy_descriptors.exchange(0), ticks = s_copy_ticks.exchange(0), updates = s_update_calls.exchange(0);
			LARGE_INTEGER frequency;
			QueryPerformanceFrequency(&frequency);
			size_t textures = 0;
			{
				const std::shared_lock<std::shared_mutex> lock(s_textures_mutex);
				textures = s_textures.size();
			}
			lines[4] += strf("%sdescriptors tracked: %.0f copies (%.0f descriptors) + %.0f view writes per frame, ~%.2f ms CPU per frame (1 call in %u timed), %zu candidate textures",
				lines[4].empty() ? "" : " | ", calls / 30.0, descriptors / 30.0, updates / 30.0, ticks * 1000.0 / frequency.QuadPart / 30.0, k_timing_period, textures);
		}
		lines[5] = lines[5].empty() ? light_period : lines[5] + " | " + light_period;
		lines[5] += strf(" | path tracing %.2f (%s%s): environment probes %s", s_full.load(),
			s_renderer.load() == 1 ? strf("NVIDIA RTXPT, %d diffuse bounces", s_pt_bounces.load()).c_str() : "RE9",
			s_renderer.load() != 1 && s_rtxdi_pt.load() > 0.5f ? strf(", NVIDIA ReSTIR PT: temporal + %d CGNS neighbours, duplication cap", std::clamp(s_pt_spatial.load(), 0, 4)).c_str() :
			s_path_reuse.load() > 0.5f ? ", path reuse (v68: paired spatial, ReSTIR PT Enhanced)" : "", s_ibl_layout.load() == 0 ? "not found (the rays take the baked sky)" :
			strf("bound in %u lists", env_bound).c_str());
		{
			const uint32_t relit = s_relight_counts[0].exchange(0), idle = s_relight_counts[1].exchange(0), lost = s_relight_counts[2].exchange(0);
			lines[5] += strf(" | forward relight (v50): %u fog passes relit, %u without an RE9 composite, %u without the light buffer or data", relit, idle, lost);
		}
		const std::lock_guard<std::mutex> lock(s_status_mutex);
		for (int i = rt_lines ? 0 : 3; i < 6; ++i)
			s_rt_status[i] = lines[i];
		{
			// v29: skips and reused scenes since the last status update, logged at once (each one can be a flash)
			std::string anomalies;
			const char *const pre_names[9] = { "", "effect off", "no render size", "lighting arguments", "pipelines", "G-buffer targets", "data buffer", "ray tracing", "no geometry" };
			for (int k = 1; k < 9; ++k)
				if (const uint32_t n = s_skip_counts[k].exchange(0); n != 0 && k != 1)
					anomalies += strf("%s%u before the lighting (%s)", anomalies.empty() ? "" : ", ", n, pre_names[k]);
			for (int k = 0; k < 5; ++k)
				if (const uint32_t n = s_post_counts[k].exchange(0); n != 0)
					anomalies += strf("%s%u after the lighting (%s)", anomalies.empty() ? "" : ", ", n, k_post_names[k]);
			const uint32_t empty = s_reuse_empty.exchange(0), stale = s_reuse_stale.exchange(0);
			if (empty + stale != 0)
				anomalies += strf("%slast scene reused for %u empty and %u stale epochs", anomalies.empty() ? "" : ", ", empty, stale);
			if (!anomalies.empty())
			{
				const size_t at = s_rt_status[3].find("scene:");
				log(reshade::log::level::info, "TLOU RT v%d anomalies in the last 30 presents: %s | %s", TLOU_RT_VERSION, anomalies.c_str(),
					at == std::string::npos ? "" : s_rt_status[3].c_str() + at);
			}
		}
		static uint32_t updates = 0;                       // v26: every 40th update (~20 s at 60 fps) the status in ReShade.log
		if (++updates % 40 == 0)
			for (int i = 0; i < 6; ++i)
				log(reshade::log::level::info, "TLOU RT v%d status %d: %s", TLOU_RT_VERSION, i + 1, s_rt_status[i].c_str());
	}

	// Retired objects whose lists have run by now (8 presents later) are released
	void release_retired(bool all)
	{
		std::vector<retired_object> done;
		{
			const std::lock_guard<std::mutex> lock(s_retire_mutex);
			const uint32_t now = s_present_index.load();
			for (auto it = s_retired_objects.begin(); it != s_retired_objects.end();)
				if (all || now - it->present >= 8)
				{
					done.push_back(*it);
					it = s_retired_objects.erase(it);
				}
				else
					++it;
		}
		if (done.empty())
			return;
		const std::shared_lock<std::shared_mutex> lock(s_mutex);
		for (const retired_object &r : done)
		{
			if (r.object != nullptr)
				r.object->Release();
			if (r.layout != 0 && s_device != nullptr)
				s_device->destroy_pipeline_layout(r.layout);
		}
	}

	void on_reshade_present(effect_runtime *runtime)
	{
		const uint32_t present = s_present_index.fetch_add(1) + 1;
		release_retired(false);
		rr_tick(runtime);                                  // v61: the Ray Reconstruction helper
		{
			uint32_t w = 0, h = 0;                         // v79: the DLSS output's size (the in-game RR probe)
			runtime->get_screenshot_width_and_height(&w, &h);
			s_output_w.store(w);
			s_output_h.store(h);
		}
		if (s_timestamp_frequency.load() == 0)
		{
			UINT64 frequency = 0;
			ID3D12CommandQueue *const queue = reinterpret_cast<ID3D12CommandQueue *>(runtime->get_command_queue()->get_native());
			if (queue != nullptr && SUCCEEDED(queue->GetTimestampFrequency(&frequency)))
				s_timestamp_frequency = frequency;
		}
		if (s_dump_state.load() == dump_idle && runtime->is_key_pressed(k_dump_key))
		{
			const std::lock_guard<std::mutex> lock(s_rt_mutex);
			s_dump_message = "capture: waiting for the game's lighting...";
			s_dump_state = dump_requested;
		}
		else if (s_dump_state.load() == dump_waiting)
		{
			const std::lock_guard<std::mutex> lock(s_rt_mutex);
			if (present - s_dump_present >= 8 && s_dump_readback != nullptr)
				write_dump();
		}
		if (present % 30 == 0)
			update_rt_status();
	}

	void release_all()
	{
		s_streaming = false;
		release_retired(true);
		{
			const std::unique_lock<std::shared_mutex> lock(s_lists_mutex);
			s_lists.clear();
			s_lists_epoch.fetch_add(1, std::memory_order_acq_rel);
		}
		{
			const std::unique_lock<std::shared_mutex> lock(s_mutex);
			for (auto &[root, set] : s_inject)
			{
				for (ID3D12PipelineState *pso : set.pso)
					if (pso != nullptr)
						pso->Release();
				if (set.layout != 0 && s_device != nullptr)
					s_device->destroy_pipeline_layout(set.layout);
			}
			s_inject.clear();
			s_lighting.clear();
			s_ibl.clear();
			s_ibl_layout = 0;
			s_device = nullptr;
		}
		{
			const std::unique_lock<std::shared_mutex> lock(s_geo_mutex);
			for (auto &[pipe, info] : s_prepass)
				if (info->clone != nullptr)
					info->clone->Release();
			for (auto &[root, so_root] : s_so_roots)
				if (so_root != nullptr)
					so_root->Release();
			s_prepass.clear();
			s_so_roots.clear();
		}
		{
			rr_shutdown();                                 // v61: the Ray Reconstruction helper ends with the device
			rr_game_release();                             // v80: in-game RR's guides (its feature stays with NVIDIA's runtime)
			const std::lock_guard<std::mutex> lock(s_rt_mutex);
			release_rt();
			for (slot_info &info : s_slot_info)
				info = slot_info();
			release(s_dump);
			release(s_dump_readback);
			s_dump_state = dump_idle;
			release(s_zero_counts);
			if (ID3D12DescriptorHeap *const heap = s_zero_heap.exchange(nullptr))
				heap->Release();
		}
		for (std::atomic<uint64_t> &res : s_gbuffer_res)
			res = 0;
		for (std::atomic<uint64_t> &res : s_resolved)
			res = 0;
		{
			const std::lock_guard<std::mutex> lock(s_heap_mutex);
			for (const uint32_t index : s_heap_list)
			{
				heap_info &h = s_heaps[index];
				h.ready = false;
				delete[] h.slots.exchange(nullptr);
				h.count = h.increment = 0;
				h.orig_cpu = h.orig_heap = 0;
			}
			s_heap_list.clear();
		}
		for (state_entry &e : s_states)
			e.resource = 0;
		{
			const std::unique_lock<std::shared_mutex> lock(s_textures_mutex);
			s_textures.clear();
			s_buffers.clear();
		}
		s_reflections_state = k_state_unknown;
		{
			const std::lock_guard<std::mutex> lock(s_epoch_mutex);
			s_epoch_draws.clear();
			s_epoch_bytes = 0;
			std::fill(std::begin(s_dirty), std::end(s_dirty), 0u);
		}
		{
			const std::lock_guard<std::mutex> lock(s_buffer_mutex);
			if (s_buffer != nullptr)
				s_buffer->Release();
			for (auto &[buffer, frame] : s_retired)
				buffer->Release();
			s_buffer = nullptr;
			s_buffer_w = s_buffer_h = 0;
			s_retired.clear();
		}
		const std::lock_guard<std::mutex> lock(s_layout_mutex);
		s_layouts.clear();
	}
}

// The module is pinned (it stays loaded until the process ends) so that no game thread can still be inside one of its
// callbacks when ReShade unloads add-ons; its state is reset on every AddonInit (a new device follows).
extern "C" __declspec(dllexport) bool AddonInit(HMODULE addon_module, HMODULE reshade_module)
{
	if (!reshade::register_addon(addon_module, reshade_module))
		return false;

	HMODULE pinned = nullptr;
	GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN, reinterpret_cast<LPCWSTR>(&AddonInit), &pinned);

	release_all();
	load_settings();
	install_sl_hook();                                     // v79: the game's DLSS evaluate (once per process)
	rr_game_check_marker();                                // v81: a session that ended while RR was being made: the setting off
	s_width.store(0);
	s_height.store(0);
	s_injected.store(0);
	s_skipped.store(0);
	s_rt_support.store(0);
	set_status("waiting for the game's lighting");

	reshade::register_event<reshade::addon_event::init_pipeline_layout>(on_init_pipeline_layout);
	reshade::register_event<reshade::addon_event::destroy_pipeline_layout>(on_destroy_pipeline_layout);
	reshade::register_event<reshade::addon_event::init_pipeline>(on_init_pipeline);
	reshade::register_event<reshade::addon_event::destroy_pipeline>(on_destroy_pipeline);
	reshade::register_event<reshade::addon_event::bind_pipeline>(on_bind_pipeline);
	reshade::register_event<reshade::addon_event::reset_command_list>(on_reset_command_list);
	reshade::register_event<reshade::addon_event::destroy_command_list>(on_destroy_command_list);
	reshade::register_event<reshade::addon_event::destroy_resource>(on_destroy_resource);
	reshade::register_event<reshade::addon_event::copy_descriptor_tables>(on_copy_descriptor_tables);
	reshade::register_event<reshade::addon_event::update_descriptor_tables>(on_update_descriptor_tables);
	reshade::register_event<reshade::addon_event::init_resource>(on_init_resource);
	reshade::register_event<reshade::addon_event::close_command_list>(on_close_command_list);
	reshade::register_event<reshade::addon_event::dispatch>(on_dispatch);
	reshade::register_event<reshade::addon_event::draw_or_dispatch_indirect>(on_indirect);
	reshade::register_event<reshade::addon_event::draw>(on_draw);
	reshade::register_event<reshade::addon_event::draw_indexed>(on_draw_indexed);
	reshade::register_event<reshade::addon_event::bind_index_buffer>(on_bind_index_buffer);
	reshade::register_event<reshade::addon_event::barrier>(on_barrier);
	reshade::register_event<reshade::addon_event::execute_secondary_command_list>(on_execute_bundle);
	reshade::register_event<reshade::addon_event::execute_command_list>(on_execute_command_list);
	reshade::register_event<reshade::addon_event::push_constants>(on_push_constants);
	reshade::register_event<reshade::addon_event::push_descriptors>(on_push_descriptors);
	reshade::register_event<reshade::addon_event::bind_descriptor_tables>(on_bind_descriptor_tables);
	reshade::register_event<reshade::addon_event::bind_render_targets_and_depth_stencil>(on_bind_render_targets);
	reshade::register_event<reshade::addon_event::reshade_present>(on_reshade_present);
	reshade::register_overlay(nullptr, draw_settings);
	return true;
}

extern "C" __declspec(dllexport) void AddonUninit(HMODULE addon_module, HMODULE reshade_module)
{
	reshade::unregister_addon(addon_module, reshade_module);
	release_all();
}
