		{ g_cs_late, sizeof(g_cs_late) }, { g_cs_mask, sizeof(g_cs_mask) }, { g_cs_emit, sizeof(g_cs_emit) }, { g_cs_emit_list, sizeof(g_cs_emit_list) },
